{
  "key": "linux_audit::cef::__mapping__",
  "sourcetype": "linux_audit",
  "dest_format": "cef::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 687,
  "updated_at": "2026-09-10T15:28:25.485Z",
  "functions": [
    {
      "id": "eval",
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set device vendor/product/version",
      "conf": {
        "add": [
          {
            "name": "vendor",
            "value": "'Linux'"
          },
          {
            "name": "product",
            "value": "'Auditd'"
          },
          {
            "name": "version",
            "value": "'1.0'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Build CEF header",
      "conf": {
        "add": [
          {
            "name": "__sig",
            "value": "signature || 'audit'"
          },
          {
            "name": "__name",
            "value": "signature || 'Audit Event'"
          },
          {
            "name": "__sev",
            "value": "severity == null || severity === '' ? 5 : Number(severity) <= 1 ? 10 : Number(severity) == 2 ? 9 : Number(severity) == 3 ? 8 : Number(severity) == 4 ? 6 : Number(severity) == 5 ? 4 : Number(severity) == 6 ? 3 : 1"
          },
          {
            "name": "__hdr",
            "value": "'CEF:0|Linux|Auditd|1.0|' + String(__sig) + '|' + String(__name) + '|' + String(__sev) + '|'"
          },
          {
            "name": "__ext",
            "value": "''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Build CEF extension",
      "conf": {
        "add": [
          {
            "name": "__ext",
            "value": "(user || src_user) && String(user || src_user) != 'undefined' && String(user || src_user) != 'null' && String(user || src_user) != '-' ? __ext + 'suser=' + String(user || src_user) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(user_id) && String(user_id) != 'undefined' && String(user_id) != 'null' && String(user_id) != '-' && (user_id) ? __ext + 'suid=' + String(user_id) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(host || hostname) && String(host || hostname) != 'undefined' && String(host || hostname) != 'null' && String(host || hostname) != '-' && (host || hostname) ? __ext + 'dhost=' + String(host || hostname) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(host || hostname) && String(host || hostname) != 'undefined' && String(host || hostname) != 'null' && String(host || hostname) != '-' && (host || hostname) ? __ext + 'dvchost=' + String(host || hostname) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(action) && String(action) != 'undefined' && String(action) != 'null' && String(action) != '-' ? __ext + 'act=' + String(action) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(outcome) && String(outcome) != 'undefined' && String(outcome) != 'null' && String(outcome) != '-' && (outcome) ? __ext + 'outcome=' + String(outcome) + ' ' : __ext"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "CEF extension (cont. 7)",
      "conf": {
        "add": [
          {
            "name": "__ext",
            "value": "(process_name || process) && String(process_name || process) != 'undefined' && String(process_name || process) != 'null' && String(process_name || process) != '-' && (process_name || process) ? __ext + 'deviceProcessName=' + String(process_name || process) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(process) && String(process) != 'undefined' && String(process) != 'null' && String(process) != '-' && (process) ? __ext + 'dproc=' + String(process) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(process_id) && String(process_id) != 'undefined' && String(process_id) != 'null' && String(process_id) != '-' && (process_id) ? __ext + 'dpid=' + String(process_id) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(audit_serial) && String(audit_serial) != 'undefined' && String(audit_serial) != 'null' && String(audit_serial) != '-' && (audit_serial) ? __ext + 'externalId=' + String(audit_serial) + ' ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(parent_process_id) && String(parent_process_id) != 'undefined' && String(parent_process_id) != 'null' && String(parent_process_id) != '-' && (parent_process_id) ? __ext + 'cn1=' + String(parent_process_id) + ' cn1Label=ParentProcessId ' : __ext"
          },
          {
            "name": "__ext",
            "value": "(object) && String(object) != 'undefined' && String(object) != 'null' && String(object) != '-' && (object) ? __ext + 'cs1=' + String(object) + ' cs1Label=AuditKey ' : __ext"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "CEF extension (cont. 13)",
      "conf": {
        "add": [
          {
            "name": "__ext",
            "value": "(signature) && String(signature) != 'undefined' && String(signature) != 'null' && String(signature) != '-' && (signature) ? __ext + 'cs2=' + String(signature) + ' cs2Label=AuditType ' : __ext"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Assemble CEF _raw + set _time + sourcetype",
      "conf": {
        "add": [
          {
            "name": "_raw",
            "value": "__hdr + __ext.trim()"
          },
          {
            "name": "sourcetype",
            "value": "'linux_audit'"
          }
        ]
      }
    }
  ],
