      "description": "Extract SSH username.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/sshd\\[\\d+\\]:\\s+(?:Accepted|Failed)\\s+\\S+\\s+for\\s+(?<username>\\S+)/gm"
