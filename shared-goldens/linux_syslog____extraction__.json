{
  "key": "linux_syslog::__extraction__",
  "sourcetype": "linux_syslog",
  "dest_format": "__extraction__",
  "score": 92,
  "part": "extraction",
  "author": "push",
  "build": 0,
  "updated_at": "2026-08-07T13:00:02.593Z",
  "functions": [
    {
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<syslog_ts>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})/gm",
        "regexList": [
          {
            "regex": "/^\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+(?<host>\\S+)/gm"
          },
          {
            "regex": "/\\s(?<process_name>sshd)\\[(?<process_id>\\d+)\\]:/gm"
          },
          {
            "regex": "/:\\s+(?<auth_action>Accepted|Failed)\\s+(?<auth_method>\\S+)/gm"
          },
          {
            "regex": "/\\sfor\\s+(?<user>\\S+)\\s+from\\s+(?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+port\\s+(?<src_port>\\d+)\\s+(?<protocol>\\S+)/gm"
          }
        ]
      },
      "id": "regex_extract",
      "description": "Extract SSH authentication syslog components from _raw."
    },
    {
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "category_uid",
            "value": "3"
          },
          {
            "name": "message",
            "value": "_raw"
          },
          {
            "name": "is_remote",
            "value": "src_ip ? true : false"
          },
          {
            "name": "status_code",
            "value": "auth_action"
          },
          {
            "name": "status_detail",
            "value": "auth_action ? auth_action + ' ' + (auth_method || '') : null"
          },
          {
            "name": "unmapped",
            "value": "{}"
          },
          {
            "name": "unmapped.syslog_ts",
            "value": "syslog_ts"
          },
          {
            "name": "unmapped.host",
            "value": "host"
          },
          {
            "name": "unmapped.process_name",
            "value": "process_name"
          },
          {
            "name": "unmapped.process_id",
            "value": "process_id"
          },
          {
            "name": "unmapped.auth_method",
            "value": "auth_method"
          },
          {
            "name": "unmapped.user",
            "value": "user"
          },
          {
            "name": "unmapped.src_ip",
            "value": "src_ip"
          },
          {
            "name": "unmapped.src_port",
            "value": "src_port"
          },
          {
            "name": "unmapped.protocol",
            "value": "protocol"
          }
        ]
      },
      "id": "eval",
      "description": "Map extracted SSH authentication fields to target OCSF authentication schema fields."
    },
    {
      "filter": "true",
      "conf": {
        "srcField": "_raw",
        "dstField": "time",
        "defaultTimezone": "UTC",
        "timestamps": [
          {
            "regex": "/^(\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})/",
            "strptime": "%b %d %H:%M:%S"
          }
        ],
        "timeExpression": "time.getTime() / 1000",
        "offset": 0,
        "maxLen": 150,
        "defaultTime": "now",
        "earliestDateAllowed": "-420weeks",
        "latestDateAllowed": "+1week"
      },
      "id": "auto_timestamp",
      "description": "Extract syslog timestamp from SSH authentication event into OCSF time."
    },
    {
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<syslog_ts>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})/gm",
        "regexList": [
          {
            "regex": "/^\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+(?<host>\\S+)/gm"
          },
          {
            "regex": "/^\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\S+\\s+(?<process_name>[^\\[\\s]+)\\[\\d+\\]:/gm"
          },
          {
            "regex": "/^\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\S+\\s+[^\\[\\s]+\\[(?<process_pid>\\d+)\\]:/gm"
          },
          {
            "regex": "/:\\s+(?<auth_result>Accepted|Failed)\\s+/gm"
          },
          {
            "regex": "/:\\s+(?:Accepted|Failed)\\s+\\S+\\s+for\\s+(?<user_name>\\S+)\\s+from\\s+/gm"
          },
          {
            "regex": "/\\s+from\\s+(?<src_ip>\\S+)\\s+port\\s+\\d+/gm"
          },
          {
            "regex": "/\\s+from\\s+\\S+\\s+port\\s+(?<src_port>\\d+)/gm"
          },
          {
            "regex": "/:\\s+(?:Accepted|Failed)\\s+(?<auth_method>\\S+)\\s+for\\s+/gm"
          },
          {
            "regex": "/\\s+port\\s+\\d+\\s+(?<protocol>\\S+)$/gm"
          }
        ]
      },
      "id": "regex_extract",
      "description": "Extract SSH authentication components for OCSF authentication mapping."
    },
    {
      "filter": "true",
      "conf": {
        "depth": 5,
        "ignoreFields": [],
        "filterExpr": "name==='process_pid' || name==='src_port'",
        "format": "none",
        "digits": 2
      },
      "id": "numerify",
      "description": "Convert extracted process and source port identifiers to numbers."
    },
    {
