    {
      "id": "regex_extract",
      "description": "Extract syslog timestamp from SSH authentication message.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<event_time>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})/gm"
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract destination host from SSH authentication message.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+(?<dst_host>\\S+)/gm"
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract SSH service name and process id.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/\\s(?<service_name>sshd)\\[(?<service_uid>\\d+)\\]/gm"
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract SSH authentication action and method.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/sshd\\[\\d+\\]:\\s+(?<auth_action>Accepted|Failed)\\s+(?<auth_method>\\S+)/gm"
