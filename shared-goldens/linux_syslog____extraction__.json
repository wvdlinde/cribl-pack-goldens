      "description": "Extract SSH authentication fields from syslog message.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<metadata_original_time>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})/gm",
        "regexList": [
          {
            "regex": "/^\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+(?<reporter_host>\\S+)/gm"
          },
          {
            "regex": "/sshd\\[\\d+\\]:\\s+(?<auth_action>Accepted|Failed)\\s+/gm"
