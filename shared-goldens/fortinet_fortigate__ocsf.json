  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "fortinet_fortigate to OCSF pipeline."
      }
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/CEF:\\d+\\|(?<__cef_vendor>[^|]*)\\|(?<__cef_product>[^|]*)\\|(?<__cef_version>[^|]*)\\|(?<__cef_id>[^|]*)\\|(?<__cef_name>[^|]*)\\|(?<__cef_severity>[^|]*)\\|(?<__cef_ext>.*)$/"
      },
      "description": "Extract CEF extension (if CEF-wrapped)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "__kvp_src",
            "value": "__cef_ext || _raw"
          }
        ]
      },
      "description": "Set KVP source field"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp_src",
        "delimChar": " ",
        "quoteChar": "\""
      },
      "description": "Parse KVP fields"
    },
    {
      "id": "code",
      "filter": "true",
      "disabled": false,
      "conf": {
        "maxNumOfIterations": 5000,
        "code": "for (const key of Object.keys(__e)) {\n  if (key.startsWith(\"FTNTFGT\")) {\n    const clean = key.slice(7);\n    if (!__e[clean]) __e[clean] = __e[key];\n    delete __e[key];\n  }\n}"
      },
      "description": "Strip FTNTFGT prefix"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Map fields to OCSF schema ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "__proto_raw",
            "value": "String(proto || '')"
          },
          {
            "name": "__transport",
            "value": "__proto_raw == '6' ? 'tcp' : __proto_raw == '17' ? 'udp' : __proto_raw == '1' ? 'icmp' : __proto_raw == '58' ? 'ipv6-icmp' : __proto_raw == '47' ? 'gre' : __proto_raw == '50' ? 'esp' : __proto_raw == '51' ? 'ah' : __proto_raw == '132' ? 'sctp' : (__proto_raw || undefined)"
          },
          {
            "name": "__act",
            "value": "String(action || '')"
          },
          {
            "name": "__activity_id",
            "value": "__act == 'accept' ? 1 : __act == 'close' ? 2 : __act == 'client-rst' || __act == 'server-rst' || __act == 'timeout' ? 2 : __act == 'deny' || __act == 'block' || __act == 'ip-conn' ? 6 : 5"
          },
          {
            "name": "__direction_id",
            "value": "subtype == 'forward' ? 2 : subtype == 'local' ? 1 : 0"
          },
          {
            "name": "__level",
            "value": "String(level || '')"
          },
          {
            "name": "__severity_id",
            "value": "__level == 'emergency' ? 6 : __level == 'alert' || __level == 'critical' ? 5 : __level == 'error' ? 4 : __level == 'warning' ? 3 : __level == 'notice' ? 3 : __level == 'information' || __level == 'info' ? 2 : __level == 'debug' ? 1 : 2"
          },
          {
            "name": "__logtime",
            "value": "eventtime ? Number(String(eventtime).substring(0,13)) : undefined"
          }
        ]
      },
      "description": "Compute normalized derived values"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "Number(__activity_id)"
          },
          {
            "name": "type_uid",
            "value": "Number(4001 * 100 + __activity_id)"
          },
          {
            "name": "severity_id",
            "value": "Number(__severity_id)"
          },
          {
            "name": "sourcetype",
            "value": "'fortinet_fortigate:ocsf'"
          },
          {
            "name": "host",
            "value": "devname || devid || undefined"
          },
          {
            "name": "time",
            "value": "(__logtime) != null ? Number(__logtime) : undefined"
