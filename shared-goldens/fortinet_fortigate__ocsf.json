  "recipe": null,
  "report": {
    "band": "warn",
    "scoreSource": "value-coverage",
    "findings": [
      {
        "severity": "medium",
        "field": "_value",
        "issue": "sample value \"root\" was not extracted/mapped into the output",
        "pointImpact": 0
      },
      {
        "severity": "medium",
        "field": "_value",
        "issue": "sample value \"dnat\" was not extracted/mapped into the output",
        "pointImpact": 0
      },
      {
        "severity": "medium",
