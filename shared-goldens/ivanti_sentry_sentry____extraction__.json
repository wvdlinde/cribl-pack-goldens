{
  "key": "ivanti_sentry_sentry::__extraction__",
  "sourcetype": "ivanti_sentry_sentry",
  "dest_format": "__extraction__",
  "score": 100,
  "part": "extraction",
  "author": "unknown",
  "build": 378,
  "updated_at": "2026-08-07T13:49:10.102Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse syslog-style header (timestamp, host, pid, severity, subsystem) and keep remaining key=value payload as message",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<host>\\S+)\\s+Sentry\\[(?<pid>\\d+)\\]:\\s+(?<severity>\\w+)\\s+(?<subsystem>\\w+)\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "description": "Extract key=value pairs from the message payload into individual fields",
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "message",
        "cleanFields": true
      }
    },
    {
      "id": "regex_extract",
      "filter": "client_ip && client_ip.startsWith('[')",
      "disabled": false,
      "description": "Extract IPv6 address from bracketed client_ip values",
      "conf": {
        "source": "client_ip",
        "regex": "/^\\[(?<src_ip_v6>[0-9a-fA-F:]+)\\]$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize src_ip (handle IPv6), derive action/event field, and map protocol from subsystem",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip_v6 ? src_ip_v6 : client_ip"
          },
          {
            "name": "action",
            "value": "cmd ? cmd : event ? event : (status=='failed' ? 'login_failed' : undefined)"
          },
          {
            "name": "protocol",
            "value": "subsystem=='CertAuth' ? 'tls' : (subsystem=='ASProxy' || subsystem=='EASGateway') ? 'https' : 'tcp'"
          }
        ],
        "remove": [
          "src_ip_v6"
        ]
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize severity casing for downstream consistency",
      "conf": {
        "add": [
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : severity"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}