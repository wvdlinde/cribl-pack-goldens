{
  "key": "vmware_esxlog_cmmdstimemachinedump::ocsf",
  "sourcetype": "vmware_esxlog_cmmdstimemachinedump",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:59:16.699Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<host>\\S+)\\s+cmmdstimemachinedump\\[(?<pid>\\d+)\\]:\\s+\\[TimeMachine\\]\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse base syslog structure: timestamp, host, pid, and TimeMachine message body"
    },
    {
      "id": "serde",
      "filter": "message",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "message",
        "kvDelim": "=",
        "pairDelim": ",",
        "cleanFields": true
      },
      "description": "Extract embedded key=value pairs (epoch, nodeUuid, records, sizeBytes, durationMs, oldMasterUuid, newMasterUuid, errno, sourceUser, sourceIp, action, expected, actual, file, evictedUuid, reason, exception, heapUsedMb, heapMaxMb) from the message body"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "typeof sourceUser !== 'undefined' ? sourceUser : undefined"
          },
          {
            "name": "src_ip",
            "value": "typeof sourceIp !== 'undefined' ? sourceIp : undefined"
          }
        ],
        "remove": [
          "sourceUser",
          "sourceIp"
        ]
      },
      "description": "Normalize user and src_ip field names from extracted kvp fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "severity",
            "value": "message.match(/CRITICAL/) ? 'critical' : message.match(/ERROR/) ? 'error' : message.match(/WARNING/) ? 'warning' : 'info'"
          },
          {
            "name": "event_type",
            "value": "message.match(/Snapshot dump initiated/) ? 'dump_initiated' : message.match(/Dump completed successfully/) ? 'dump_completed' : message.match(/Node membership update/) ? 'membership_update' : message.match(/Unauthorized access/) ? 'unauthorized_access' : message.match(/Node evicted/) ? 'node_evicted' : message.match(/checksum mismatch/) ? 'checksum_mismatch' : message.match(/Failed to write dump file/) ? 'dump_write_failure' : message.match(/serialization failed/) ? 'serialization_failure' : message.match(/Slow response/) ? 'slow_response' : 'other'"
          }
        ]
      },
      "description": "Classify severity and event_type based on message content"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "device.hostname",
            "value": "host || ''"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          },
          {
            "name": "time",
            "value": "timestamp ? Number(new Date(timestamp)) : Number(new Date(_time))"
          },
          {
            "name": "severity_id",
            "value": "severity == 'CRITICAL' ? 5 : severity == 'ERROR' ? 4 : severity == 'WARNING' ? 3 : 1"
          },
          {
            "name": "activity_id",
            "value": "action == 'DENIED' ? 5 : 1"
          },
          {
            "name": "type_uid",
            "value": "4001 * 100 + (action == 'DENIED' ? 5 : 1)"
          },
          {
            "name": "traffic.bytes_in",
            "value": "Number(sizeBytes || 0)"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(0)"
          },
          {
            "name": "metadata.product.name",
            "value": "'VMware vSAN CMMDS'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'VMware'"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "''"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware:esxlog:cmmdsTimeMachineDump'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}