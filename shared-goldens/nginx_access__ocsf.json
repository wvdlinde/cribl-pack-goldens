  "build": 0,
  "updated_at": "2026-09-01T07:36:34.616Z",
  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "nginx_access to OCSF pipeline.\nParses events, drops noise, maps to OCSF schema, and outputs compact JSON."
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 1: Parse raw events ---"
      }
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<client_ip>\\S+)\\s+\\S+\\s+(?<auth_user>\\S+)\\s+\\[(?<time_local>[^\\]]+)\\]\\s+\"(?<http_method>\\w+)\\s+(?<uri>\\S+)\\s+(?<http_version>[^\"]+)\"\\s+(?<status>\\d+)\\s+(?<bytes_sent>\\d+)\\s+\"(?<http_referer>[^\"]*)\"\\s+\"(?<http_user_agent>[^\"]*)\"\\s+\"(?<upstream_addr>[^\"]*)\"\\s+(?<request_time>\\S+)\\s+(?<upstream_response_time>\\S+)\\s+(?<vhost>\\S+)/"
      },
      "description": "Parse nginx combined+upstream log format"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_upstream_host",
            "value": "upstream_addr != null && upstream_addr !== '-' && upstream_addr !== '' ? upstream_addr.split(':')[0] : ''"
          },
          {
            "name": "_upstream_port",
            "value": "upstream_addr != null && upstream_addr !== '-' && upstream_addr !== '' && upstream_addr.indexOf(':') >= 0 ? Number(upstream_addr.split(':')[1]) : 0"
          },
          {
            "name": "_proto",
            "value": "http_version != null && http_version !== '' ? 'HTTP' : 'HTTP'"
          }
        ]
      },
      "description": "Pre-compute derived fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "_time_parsed > 0 ? _time_parsed / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from log timestamp"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 2: Reduction — drop noise events (disabled by default) ---"
      }
    },
    {
      "id": "drop",
      "filter": "uri === '/health' || uri === '/favicon.ico'",
      "disabled": true,
      "conf": {},
      "description": "Drop health checks and favicon requests",
      "final": true
    },
    {
      "id": "drop",
      "filter": "uri && /\\.(js|css|png|jpg|gif|woff2?|map|svg|ico)$/.test(uri)",
      "disabled": true,
      "conf": {},
      "description": "Drop static asset requests",
      "final": true
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Map fields to OCSF schema ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "http_method === 'GET' ? 1 : http_method === 'POST' ? 2 : http_method === 'PUT' ? 3 : http_method === 'DELETE' ? 4 : http_method === 'CONNECT' ? 99 : 99"
          },
          {
            "name": "type_uid",
            "value": "4001 * 100 + (http_method === 'GET' ? 1 : http_method === 'POST' ? 2 : http_method === 'PUT' ? 3 : http_method === 'DELETE' ? 4 : http_method === 'CONNECT' ? 99 : 99)"
          },
          {
            "name": "severity_id",
            "value": "Number(status) >= 500 ? 4 : Number(status) >= 400 ? 3 : Number(status) >= 300 ? 2 : 1"
          },
          {
            "name": "time",
            "value": "_time_parsed > 0 ? _time_parsed : 0"
          }
        ]
      },
      "description": "Set OCSF class/category/activity/severity"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_endpoint",
            "value": "{}"
          },
          {
            "name": "src_endpoint.ip",
            "value": "client_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "0"
          },
          {
            "name": "dst_endpoint",
            "value": "{}"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "_upstream_host || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "_upstream_port || 0"
          },
          {
            "name": "dst_endpoint.hostname",
            "value": "vhost || ''"
          },
          {
            "name": "connection_info",
            "value": "{}"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "_proto || 'HTTP'"
          },
          {
            "name": "connection_info.protocol_ver",
            "value": "http_version || ''"
          },
          {
            "name": "traffic",
            "value": "{}"
          },
          {
            "name": "traffic.bytes_out",
            "value": "bytes_sent != null && bytes_sent !== '' ? Number(bytes_sent) : 0"
          },
          {
            "name": "traffic.bytes_in",
            "value": "0"
          }
        ]
      },
      "description": "Map endpoint, connection, traffic fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "actor",
            "value": "{}"
          },
          {
            "name": "actor.user",
            "value": "{}"
          },
          {
            "name": "actor.user.name",
            "value": "auth_user != null && auth_user !== '-' && auth_user !== '' ? auth_user : undefined"
          },
          {
            "name": "device",
            "value": "{}"
          },
          {
            "name": "device.hostname",
            "value": "vhost || ''"
          },
          {
            "name": "http_request",
            "value": "{}"
          },
          {
            "name": "http_request.http_method",
            "value": "http_method || ''"
          },
          {
            "name": "http_request.url",
            "value": "{}"
          },
          {
            "name": "http_request.url.path",
            "value": "uri || ''"
          },
          {
            "name": "http_request.version",
            "value": "http_version || ''"
          },
          {
            "name": "http_request.user_agent",
            "value": "http_user_agent || ''"
          },
          {
            "name": "http_request.referrer",
            "value": "http_referer !== '-' ? http_referer : ''"
          },
          {
            "name": "http_response",
            "value": "{}"
          },
          {
            "name": "http_response.code",
            "value": "status != null && status !== '' ? Number(status) : 0"
          },
          {
            "name": "metadata",
