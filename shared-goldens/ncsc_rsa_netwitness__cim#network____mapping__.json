            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'Network_Traffic'"
          },
          {
            "name": "category_uid",
            "value": "'Network'"
          },
          {
            "name": "event_type",
            "value": "'network_traffic'"
          },
          {
            "name": "src_ip",
            "value": "ip_src || ''"
          },
          {
            "name": "src",
            "value": "ip_src || ''"
          },
          {
            "name": "dest_ip",
            "value": "ip_dst || ''"
          },
          {
            "name": "dest",
            "value": "ip_dst || ''"
          },
          {
            "name": "src_port",
            "value": "Number(tcp_srcport || udp_srcport || 0)"
          },
          {
            "name": "dest_port",
            "value": "Number(tcp_dstport || udp_dstport || service || 0)"
          },
          {
            "name": "transport",
            "value": "tcp_srcport || tcp_dstport ? 'tcp' : (udp_srcport || udp_dstport ? 'udp' : '')"
          },
          {
            "name": "protocol",
            "value": "tcp_dstport || tcp_srcport ? 'tcp' : (udp_dstport || udp_srcport ? 'udp' : '')"
          },
          {
            "name": "protocol_version",
            "value": "(eth_type || '').toLowerCase()"
          },
          {
            "name": "app",
            "value": "protocol || String(service || '')"
          },
          {
            "name": "action",
            "value": "action == 'allow' ? 'allowed' : (action == 'deny' ? 'blocked' : (result == 'failure' ? 'blocked' : (action || '')))"
          },
          {
            "name": "vendor_action",
            "value": "vendor_action || action || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-28)",
      "conf": {
        "add": [
          {
            "name": "direction",
            "value": "(direction || '').toLowerCase()"
          },
          {
            "name": "session_id",
            "value": "String(sessionid || '')"
          },
          {
            "name": "flow_id",
            "value": "String(sessionid || '')"
          },
          {
            "name": "bytes",
            "value": "Number(payload_bytes || 0)"
          },
          {
            "name": "bytes_out",
            "value": "(direction || '').toLowerCase() == 'outbound' ? Number(payload_bytes || 0) : null"
          },
          {
            "name": "bytes_in",
            "value": "(direction || '').toLowerCase() == 'inbound' ? Number(payload_bytes || 0) : null"
          },
          {
            "name": "user",
            "value": "user_src || user_dst || ''"
          },
          {
            "name": "duration",
            "value": "session_duration && String(session_duration).indexOf(':') > -1 ? (Number(String(session_duration).split(':')[0]) * 3600 + Number(String(session_duration).split(':')[1]) * 60 + Number(String(session_duration).split(':')[2])) : null"
          },
          {
            "name": "dvc",
            "value": "host || ''"
          },
          {
            "name": "src_interface",
            "value": "alias_host || ''"
          },
          {
            "name": "rule",
            "value": "alert || threat_category || ''"
          },
          {
            "name": "vendor_product",
            "value": "'RSA NetWitness'"
          },
          {
            "name": "process_id",
            "value": "process ? Number(process) : null"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ncsc_rsa_netwitness'"
          }
        ]
      }
    }
