          "gid",
          "sid",
          "rev",
          "finding_title",
          "classification",
          "priority",
          "protocol",
          "src_ip",
          "src_port",
          "dst_ip",
          "dst_port"
        ]
      }
    },
    {
      "filter": "true",
      "conf": {
        "depth": 10,
        "ignoreFields": [
          "metadata.product.uid",
          "metadata.product.version",
          "metadata.original_time"
        ],
        "format": "none"
      },
      "id": "numerify",
      "description": "Convert mapped numeric OCSF fields such as ports and enum IDs to numbers."
    }
  ],
