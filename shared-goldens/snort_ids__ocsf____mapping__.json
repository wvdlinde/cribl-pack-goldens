          }
        ]
      },
      "id": "eval",
      "description": "Populate OCSF Detection Finding schema fields and remove parser helper fields."
    },
    {
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<original_time>\\d{2}\\/\\d{2}-\\d{2}:\\d{2}:\\d{2}\\.\\d+)/gm",
        "regexList": [
          {
            "regex": "/\\[(?<gid>\\d+):(?<sid>\\d+):(?<rev>\\d+)\\]/gm"
          },
          {
            "regex": "/\\[\\d+:\\d+:\\d+\\]\\s+(?<finding_title>.+?)\\s+\\[\\*\\*\\]/gm"
          },
          {
            "regex": "/\\[Classification:\\s+(?<classification>[^\\]]+)\\]/gm"
          },
          {
            "regex": "/\\[Priority:\\s+(?<priority>\\d+)\\]/gm"
          },
          {
            "regex": "/\\{(?<protocol>[^}]+)\\}/gm"
