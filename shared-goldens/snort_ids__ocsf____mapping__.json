          {
            "name": "unmapped.priority",
            "value": "priority"
          },
          {
            "name": "unmapped.protocol",
            "value": "protocol"
          },
          {
            "name": "unmapped.src_ip",
            "value": "src_ip"
          },
          {
            "name": "unmapped.src_port",
            "value": "src_port"
          },
          {
            "name": "unmapped.dst_ip",
            "value": "dst_ip"
          },
          {
            "name": "unmapped.dst_port",
            "value": "dst_port"
          }
        ]
      },
      "id": "eval",
      "description": "Populate OCSF Detection Finding target fields and preserve source-specific fields under unmapped."
    },
    {
      "filter": "true",
      "conf": {
