            "value": "_raw.indexOf('ET ') >= 0 ? 'Proofpoint Emerging Threats' : 'Unknown'"
          },
          {
            "name": "metadata.product.uid",
            "value": "sid"
          },
          {
            "name": "metadata.product.version",
