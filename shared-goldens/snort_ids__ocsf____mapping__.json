        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<event_ts>\\d{2}\\/\\d{2}-\\d{2}:\\d{2}:\\d{2}\\.\\d+)\\s+/gm",
        "regexList": [
          {
            "regex": "/\\[\\d+:(?<signature_id>\\d+):\\d+\\]/gm"
          },
          {
            "regex": "/\\]\\s+(?<signature_name>[^\\[]+?)\\s+\\[\\*\\*\\]/gm"
          },
          {
            "regex": "/\\[Classification:\\s*(?<classification>[^\\]]+)\\]/gm"
          },
          {
            "regex": "/\\[Priority:\\s*(?<priority>\\d+)\\]/gm"
          },
          {
            "regex": "/\\{(?<protocol>[^}]+)\\}\\s+(?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?<src_port>\\d+)\\s+->\\s+(?<dst_ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?<dst_port>\\d+)/gm"
          }
        ]
      },
      "id": "regex_extract",
      "description": "Extract IDS alert fields from raw event."
    },
    {
