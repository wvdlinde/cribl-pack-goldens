          {
            "regex": "/(?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?<src_port>\\d+)\\s+->\\s+(?<dst_ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?<dst_port>\\d+)$/gm"
          }
        ]
