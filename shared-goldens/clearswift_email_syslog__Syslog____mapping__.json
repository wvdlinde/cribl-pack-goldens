            "value": "src_ip || ''"
          },
          {
            "name": "ProcessID",
            "value": "Number(pid || 0)"
          },
          {
            "name": "SeverityLevel",
            "value": "String(severity || '')"
          },
          {
            "name": "SyslogMessage",
            "value": "message || ''"
          },
          {
            "name": "EventTime",
            "value": "_time ? new Date(_time*1000).toISOString() : (timestamp ? new Date(timestamp).toISOString() : '')"
          },
          {
            "name": "TimeGenerated",
            "value": "_time ? new Date(_time*1000).toISOString() : (timestamp ? new Date(timestamp).toISOString() : '')"
          },
          {
            "name": "SourceSystem",
            "value": "host || ''"
          }
        ]
      }
    },
    {
