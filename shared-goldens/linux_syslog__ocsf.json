{
  "key": "linux_syslog::ocsf",
  "sourcetype": "linux_syslog",
  "dest_format": "ocsf",
  "score": 91,
  "part": null,
  "author": "wvdlinde",
  "build": 273,
  "updated_at": "2026-07-16T18:16:18.632Z",
  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "linux_syslog to OCSF pipeline.\nParses events, drops noise, maps to OCSF schema, and outputs compact JSON."
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 1: Parse raw events ---"
      }
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<log_time>\\w+\\s+\\d+\\s+[\\d:]+)\\s+(?<host>\\S+)\\s+(?<process>[^\\[:]+)(?:\\[(?<pid>\\d+)\\])?:\\s+(?<message>.+)$/"
      },
      "description": "Parse syslog header (timestamp, host, process, pid, message)"
    },
    {
      "id": "regex_extract",
      "filter": "process === 'sshd'",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/(?<action>Accepted|Failed|Invalid)\\s+(?<auth_method>\\S+)\\s+for\\s+(?:invalid user\\s+)?(?<user>\\S+)\\s+from\\s+(?<src_ip>[\\d.]+)\\s+port\\s+(?<src_port>\\d+)\\s*(?<ssh_proto>\\S+)?/"
      },
      "description": "Extract SSH authentication fields (user, src_ip, port, method, protocol)"
    },
    {
      "id": "regex_extract",
      "filter": "process === 'sudo'",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/(?<user>\\S+)\\s+:\\s+.*?USER=(?<runas_user>\\S+)\\s*;\\s*COMMAND=(?<command>.+)/"
      },
      "description": "Extract sudo command fields (user, runas_user, command)"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('UFW') >= 0",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/\\[UFW\\s+(?<action>\\w+)\\].*?SRC=(?<src_ip>[\\d.]+)\\s+DST=(?<dest_ip>[\\d.]+).*?PROTO=(?<transport>\\w+).*?SPT=(?<src_port>\\d+)\\s+DPT=(?<dest_port>\\d+)/"
      },
      "description": "Extract UFW firewall block fields"
    },
    {
      "id": "regex_extract",
      "filter": "process === 'nginx' || (message && /HTTP\\//.test(message))",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/\"(?<http_method>\\w+)\\s+(?<uri>\\S+)\\s+HTTP\\/[\\d.]+\"\\s+(?<status_code>\\d+)\\s+(?<resp_bytes>\\d+)/"
      },
      "description": "Extract nginx access log fields (method, uri, status, bytes)"
    },
    {
      "id": "regex_extract",
      "filter": "process && (process === 'postfix/smtpd' || process === 'postfix/smtp' || process === 'postfix/qmgr' || process === 'postfix/local')",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/(?:connect from|from)\\s+\\S+\\[(?<src_ip>[\\d.a-fA-F:]+)\\]/"
      },
      "description": "Extract postfix client IP"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "app",
            "value": "process || undefined"
          },
          {
            "name": "vendor_product",
            "value": "'Linux'"
          },
          {
            "name": "severity",
            "value": "action === 'Failed' || action === 'Invalid' || action === 'BLOCK' ? 4 : 6"
          },
          {
            "name": "action",
            "value": "action === 'Accepted' ? 'success' : action === 'Failed' || action === 'Invalid' ? 'failure' : action ? String(action).toLowerCase() : undefined"
          },
          {
            "name": "event_code",
            "value": "process || undefined"
          },
          {
            "name": "transport",
            "value": "transport ? transport : (ssh_proto ? 'TCP' : undefined)"
          },
          {
            "name": "connection_protocol",
            "value": "ssh_proto ? ssh_proto : (transport ? transport : undefined)"
          }
        ]
      },
      "description": "Normalize linux syslog fields to canonical model"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 2: Reduction — drop noise events (disabled by default, enable in Cribl UI to activate) ---"
      }
    },
    {
      "id": "drop",
      "filter": "process === 'CRON' || (message && /session (opened|closed) for user/.test(message))",
      "disabled": true,
      "conf": {},
      "description": "Drop CRON session noise (enable in Cribl UI to activate)",
      "final": true
    },
    {
      "id": "drop",
      "filter": "message && /Created slice|Removed slice/.test(message)",
      "disabled": true,
      "conf": {},
      "description": "Drop systemd slice creation/removal messages (enable in Cribl UI to activate)",
      "final": true
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Map fields to OCSF schema ---"
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "Golden OCSF mapping — deterministic from canonical fields (no AI)."
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "vendor",
            "value": "'Linux'"
          },
          {
            "name": "product",
            "value": "'Syslog'"
          },
          {
            "name": "version",
            "value": "'1.0'"
          }
        ]
      },
      "description": "Set device vendor/product/version"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_endpoint",
            "value": "{}"
          },
          {
            "name": "dst_endpoint",
            "value": "{}"
          },
          {
            "name": "connection_info",
            "value": "{}"
          },
          {
            "name": "traffic",
            "value": "{}"
          },
          {
            "name": "actor",
            "value": "{}"
          },
          {
            "name": "actor.user",
            "value": "{}"
          },
          {
            "name": "device",
            "value": "{}"
          },
          {
            "name": "metadata",
            "value": "{}"
          },
          {
            "name": "metadata.product",
            "value": "{}"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "(/teardown|close|end|denied|deny/i.test(String(action)) ? 2 : 1)"
          },
          {
            "name": "type_uid",
            "value": "400100 + (/teardown|close|end|denied|deny/i.test(String(action)) ? 2 : 1)"
          },
          {
            "name": "severity_id",
            "value": "severity != null && severity !== '' ? Math.max(1, Math.min(6, Math.round(Number(severity) * 0.85))) : 1"
          }
        ]
      },
      "description": "Map canonical fields to OCSF 1.4 base"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_endpoint.ip",
            "value": "src_ip && String(src_ip) !== '' && String(src_ip) !== 'undefined' ? String(src_ip) : undefined"
          },
          {
            "name": "src_endpoint.port",
            "value": "src_port && String(src_port) !== '' && String(src_port) !== 'undefined' ? Number(src_port) : undefined"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dest_ip && String(dest_ip) !== '' && String(dest_ip) !== 'undefined' ? String(dest_ip) : undefined"
          },
          {
            "name": "dst_endpoint.port",
            "value": "dest_port && String(dest_port) !== '' && String(dest_port) !== 'undefined' ? Number(dest_port) : undefined"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "connection_protocol && String(connection_protocol) !== '' && String(connection_protocol) !== 'undefined' ? String(connection_protocol).toUpperCase() : (transport && String(transport) !== '' && String(transport) !== 'undefined' ? String(transport).toUpperCase() : undefined)"
          },
          {
            "name": "traffic.bytes_in",
            "value": "resp_bytes && String(resp_bytes) !== '' && String(resp_bytes) !== 'undefined' ? Number(resp_bytes) : undefined"
          },
          {
            "name": "traffic.bytes_out",
            "value": "undefined"
          },
          {
            "name": "actor.user.name",
            "value": "(user || src_user) && String(user || src_user) !== '' && String(user || src_user) !== 'undefined' ? String(user || src_user) : undefined"
          },
          {
            "name": "device.hostname",
            "value": "host && String(host) !== '' ? String(host) : undefined"
          },
          {
            "name": "metadata.version",
            "value": "'1.4.0'"
          },
          {
            "name": "metadata.product.name",
            "value": "product && String(product) !== '' ? String(product) : undefined"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "vendor && String(vendor) !== '' ? String(vendor) : undefined"
          },
          {
            "name": "message",
            "value": "message && String(message) !== '' ? String(message) : undefined"
          },
          {
            "name": "time",
            "value": "log_time && log_time !== '' ? new Date(String(log_time) + ' 2024').getTime() : _time * 1000"
          }
        ]
      },
      "description": "Map all OCSF endpoint, connection, traffic, actor, device, metadata fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'linux_syslog:ocsf'"
          },
          {
            "name": "_time",
            "value": "log_time && log_time !== '' ? new Date(String(log_time) + ' 2024').getTime() / 1000 : _time"
          }
        ]
      },
      "description": "Set sourcetype + _time"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "*"
        ],
        "keep": [
          "_time",
          "index",
          "source",
          "sourcetype",
          "host",
          "cribl_breaker",
          "cribl_pipe",
          "class_uid",
          "class_uid.*",
          "category_uid",
          "category_uid.*",
          "activity_id",
