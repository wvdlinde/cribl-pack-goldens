          "type_uid",
          "type_uid.*",
          "severity_id",
          "severity_id.*",
          "src_endpoint",
          "src_endpoint.*",
          "dst_endpoint",
          "dst_endpoint.*",
          "connection_info",
          "connection_info.*",
          "traffic",
          "traffic.*",
          "actor",
          "actor.*",
          "device",
          "device.*",
          "metadata",
          "metadata.*",
          "time",
          "time.*",
          "message"
        ]
      },
      "description": "Keep only OCSF 1.4 fields + routing"
    }
  ],
