        "pointImpact": 0
      },
      {
        "severity": "medium",
        "field": "connection_info.protocol_name",
        "issue": "source value present but \"connection_info.protocol_name\" is empty in output",
        "pointImpact": 0
      },
      {
        "severity": "medium",
        "field": "actor.user.name",
        "issue": "source value present but \"actor.user.name\" is empty in output",
        "pointImpact": 0
      }
    ],
    "missingFields": [
      "src_endpoint.ip",
      "connection_info.protocol_name",
      "actor.user.name"
    ],
    "emptyFields": [
