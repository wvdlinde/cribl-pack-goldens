{
  "key": "f5_bigip_apm::__extraction__",
  "sourcetype": "f5_bigip_apm",
  "dest_format": "__extraction__",
  "score": 94,
  "part": "extraction",
  "author": "unknown",
  "build": 454,
  "updated_at": "2026-08-13T10:25:30.975Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse syslog header, F5 APM code, policy path, and message body from raw event",
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<priority>\\d+)>(?<timestamp>[A-Za-z]{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<severity>\\S+)\\s+(?<process>[^\\[]+)\\[(?<pid>\\d+)\\]:\\s+(?<code>\\d+):\\d+:\\s+(?<policy>\\/Common\\/[^:]+:Common):\\s*(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('client IP') !== -1",
      "disabled": false,
      "description": "Extract client/source IP (IPv4 or IPv6) from message when present",
      "conf": {
        "source": "message",
        "regex": "/client IP (?<src_ip>[0-9a-fA-F:.]+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('VIP') !== -1",
      "disabled": false,
      "description": "Extract destination VIP address and listener name from session-establishment messages",
      "conf": {
        "source": "message",
        "regex": "/at VIP (?<dst_ip>[0-9a-fA-F:.]+) Listener (?<listener>\\S+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && /[Ss]ession/.test(message)",
      "disabled": false,
      "description": "Extract hex session identifier from messages referencing a session",
      "conf": {
        "source": "message",
        "regex": "/[Ss]ession '?(?<session_id>[0-9a-f]{4,})/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && /[Uu]ser/.test(message)",
      "disabled": false,
      "description": "Extract username from messages referencing 'user' or 'Username'",
      "conf": {
        "source": "message",
        "regex": "/[Uu]ser(?:name)? '(?<user>[^']+)'/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Classify action outcome and normalize syslog severity into a common severity level",
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message.match(/Auth Successful|PASSED/) ? 'allow' : message.match(/Authentication failed|failed|FAILED/) ? 'deny' : message.match(/ALLOW/) ? 'allow' : message.match(/Deny|denied/) ? 'deny' : message.match(/established/) ? 'established' : message.match(/deleted/) ? 'terminated' : message.match(/timeout|unreachable/) ? 'error' : 'unknown'"
          },
          {
            "name": "severity_norm",
            "value": "severity=='err' ? 'high' : severity=='warning' ? 'medium' : severity=='notice' ? 'low' : severity=='info' ? 'info' : 'unknown'"
          }
        ],
        "remove": []
      }
    }
  ],
  "recipe": null,
  "report": null
}