          {
            "name": "src",
            "value": "src_ip || ''"
          },
          {
            "name": "src_ip",
            "value": "(/^(\\d{1,3}(\\.\\d{1,3}){3}|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]+)$/.test(String((src_ip || ''))) ? (src_ip || '') : undefined)"
          },
