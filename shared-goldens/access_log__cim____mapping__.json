  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "clientip || ''"
          },
          {
            "name": "user",
            "value": "user || ''"
          },
          {
            "name": "src_user",
            "value": "user || ''"
          },
          {
            "name": "app",
            "value": "'http'"
          },
          {
            "name": "url",
            "value": "request || ''"
          },
          {
            "name": "action",
            "value": "Number(response) < 400 ? 'allowed' : 'blocked'"
          },
          {
            "name": "severity",
            "value": "Number(response) >= 500 ? 'high' : Number(response) >= 400 ? 'medium' : 'informational'"
          },
          {
            "name": "bytes_out",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "bytes",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "object",
            "value": "referrer || ''"
          },
          {
            "name": "process",
            "value": "useragent || ''"
          },
          {
            "name": "vendor_action",
            "value": "verb || ''"
          },
          {
            "name": "protocol_version",
            "value": "httpversion || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'access_log'"
          }
        ]
      }
    }
  ],
