{
  "key": "ivanti_mi::ocsf",
  "sourcetype": "ivanti_mi",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:02:40.748Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<mi_host>\\S+)\\s+IvantiMI\\[Core\\]:\\s+(?<severity>\\w+)\\s+(?<__kvp_body>.+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract syslog header (timestamp, host, severity) and remaining KVP payload"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp_body",
        "cleanFields": true
      },
      "description": "Parse KVP body into individual fields (event, user, device_id, imei, platform, ip, status, reason, etc.)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity.toLowerCase()"
          },
          {
            "name": "src_ip",
            "value": "ip"
          }
        ],
        "remove": [
          "ip"
        ]
      },
      "description": "Normalize severity casing and map ip field to src_ip"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "status === 'SUCCESS' ? 'allowed' : (status === 'FAILURE' || status === 'BLOCKED') ? 'blocked' : status === 'FLAGGED' ? 'flagged' : 'unknown'"
          }
        ]
      },
      "description": "Derive normalized action from status field"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [],
        "remove": [
          "__kvp_body"
        ]
      },
      "description": "Cleanup scratch fields used during parsing"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip"
          },
          {
            "name": "device.hostname",
            "value": "mi_host"
          },
          {
            "name": "actor.user.name",
            "value": "user"
          },
          {
            "name": "time",
            "value": "Number(new Date(_time || timestamp).getTime())"
          },
          {
            "name": "severity_id",
            "value": "status == 'SUCCESS' ? 1 : status == 'FAILURE' ? 3 : 0"
          },
          {
            "name": "severity_id",
            "value": "severity ? Number(severity) : (vendor_severity == 'CRITICAL' ? 5 : vendor_severity == 'ERROR' ? 4 : vendor_severity == 'WARN' ? 3 : vendor_severity == 'INFO' ? 1 : 0)"
          },
          {
            "name": "activity_id",
            "value": "action == 'DEVICE_CHECKIN' ? 1 : action == 'AUTH_FAILURE' ? 2 : action == 'ENROLLMENT' ? 1 : action == 'COMPLIANCE_VIOLATION' ? 2 : action == 'REMOTE_WIPE' ? 3 : action == 'POLICY_PUSH' ? 1 : action == 'CERT_RENEWAL' ? 1 : action == 'ADMIN_LOGIN' ? 1 : 0"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_mi'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}