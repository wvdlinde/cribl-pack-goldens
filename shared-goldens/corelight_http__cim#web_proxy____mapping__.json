            "value": "host ? ('http://' + host + (uri || '')) : (uri || '')"
          },
          {
            "name": "url_length",
            "value": "Number((host ? ('http://' + host + (uri || '')) : (uri || '')).length)"
          },
          {
            "name": "uri_path",
            "value": "(uri || '').split('?')[0]"
          },
          {
            "name": "uri_query",
            "value": "(uri || '').indexOf('?') > -1 ? (uri || '').split('?').slice(1).join('?') : ''"
          },
          {
            "name": "http_user_agent",
            "value": "user_agent || ''"
          }
        ]
      }
    },
    {
