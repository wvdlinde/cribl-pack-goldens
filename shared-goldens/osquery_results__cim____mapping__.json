            "value": "'Endpoint'"
          },
          {
            "name": "category_uid",
            "value": "'Endpoint'"
          },
          {
            "name": "event_type",
            "value": "'Processes'"
          },
          {
            "name": "dvc",
            "value": "String(hostIdentifier || '')"
          },
          {
            "name": "process",
            "value": "String(columns && columns.cmdline || '')"
          },
          {
            "name": "process_id",
            "value": "String(columns && columns.pid || '')"
