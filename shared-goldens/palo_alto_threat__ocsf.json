          },
          {
            "name": "type_uid",
            "value": "4004 * 100 + ((action == 'block-url' || action == 'drop' || action == 'reset-both' || action == 'reset-client' || action == 'reset-server') ? 2 : (action == 'allow') ? 1 : 0)"
