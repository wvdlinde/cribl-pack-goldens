{
  "key": "cron_2::__extraction__",
  "sourcetype": "cron_2",
  "dest_format": "__extraction__",
  "score": 90,
  "part": "extraction",
  "author": "unknown",
  "build": 379,
  "updated_at": "2026-08-07T16:33:48.266Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse the cron syslog header and message.",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<process>CRON)\\[(?<pid>\\d+)\\]:\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.includes(') CMD (')",
      "disabled": false,
      "description": "Extract the cron user, command, and optional error status.",
      "conf": {
        "source": "message",
        "regex": "/^\\((?<user>[^)]+)\\)\\s+CMD\\s+\\((?<command>.*)\\)(?:\\s+(?<command_status>FAILED - user not found|EMPTY COMMAND FIELD))?$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && (message.includes('session opened for user') || message.includes('session closed for user'))",
      "disabled": false,
      "description": "Extract cron session activity and user details.",
      "conf": {
        "source": "message",
        "regex": "/^(?:\\((?<__cron_user>[^)]+)\\)|pam_unix\\(cron:session\\):)\\s+session\\s+(?<session_action>opened|closed)\\s+for\\s+user\\s+(?<user>\\S+)(?:\\s+by\\s+\\(uid=(?<actor_uid>\\d+)\\))?$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "command && command.match(/(?:https?:\\/\\/|--target\\s+)\\d{1,3}(?:\\.\\d{1,3}){3}/)",
      "disabled": false,
      "description": "Extract destination IP, port, and protocol from cron commands.",
      "conf": {
        "source": "command",
        "regex": "/\\b(?:(?<protocol>https?):\\/\\/|--target\\s+)(?<dst_ip>\\d{1,3}(?:\\.\\d{1,3}){3})(?::(?<dst_port>\\d+))?/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize cron action, outcome, severity, and event type.",
      "conf": {
        "add": [
          {
            "name": "outcome",
            "value": "message.match(/FAILED - user not found$|EMPTY COMMAND FIELD$/) ? 'failure' : 'success'"
          },
          {
            "name": "severity",
            "value": "message.match(/FAILED - user not found$|EMPTY COMMAND FIELD$/) ? 'error' : 'info'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}