          },
          {
            "name": "status",
            "value": "okta.outcome && okta.outcome.result==='SUCCESS'?'Success':okta.outcome && okta.outcome.result==='FAILURE'?'Failure':okta.outcome && okta.outcome.result?okta.outcome.result:'Unknown'"
          }
        ]
      }
    },
    {
