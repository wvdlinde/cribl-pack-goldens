  "part": null,
  "author": "wvdlinde",
  "build": 273,
  "updated_at": "2026-07-16T18:18:37.808Z",
  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "claroty to CommonSecurityLog pipeline.\nParses events, drops noise, maps to CommonSecurityLog schema, and outputs compact JSON."
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 1: Parse raw events ---"
      }
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "json",
        "srcField": "_raw"
      },
      "description": "Parse Claroty JSON event into structured fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "source_ip || ''"
          },
          {
            "name": "dst_ip",
            "value": "destination_ip || ''"
          },
          {
            "name": "dst_port",
            "value": "port ? Number(port) : undefined"
          },
          {
            "name": "norm_user",
            "value": "user || ''"
          },
          {
            "name": "norm_protocol",
            "value": "protocol ? protocol.toUpperCase() : ''"
          },
          {
            "name": "norm_action",
            "value": "action ? action.toLowerCase() : ''"
          },
          {
            "name": "norm_severity",
            "value": "severity ? severity.toLowerCase() : ''"
          },
          {
            "name": "norm_vendor",
            "value": "vendor || ''"
          },
          {
            "name": "norm_model",
            "value": "model || ''"
          },
          {
            "name": "norm_zone",
            "value": "zone || ''"
          },
          {
            "name": "norm_message",
            "value": "message || ''"
          },
          {
            "name": "norm_asset_type",
            "value": "asset_type ? asset_type.toLowerCase() : ''"
          },
          {
            "name": "norm_event_type",
            "value": "event_type || ''"
          },
          {
            "name": "_time",
            "value": "timestamp ? Math.floor(new Date(timestamp).getTime() / 1000) : _time"
          },
          {
            "name": "severity_id",
            "value": "norm_severity == 'critical' ? 5 : norm_severity == 'high' ? 4 : norm_severity == 'medium' ? 3 : norm_severity == 'warning' ? 2 : norm_severity == 'info' ? 1 : 0"
          },
          {
            "name": "category",
            "value": "norm_event_type == 'alert' ? 'threat' : norm_event_type == 'malware_detection' ? 'threat' : norm_event_type == 'network_scan' ? 'threat' : norm_event_type == 'protocol_anomaly' ? 'threat' : norm_event_type == 'firmware_change' ? 'change' : norm_event_type == 'config_change' ? 'change' : norm_event_type == 'baseline_deviation' ? 'anomaly' : norm_event_type == 'policy_violation' ? 'policy' : norm_event_type == 'login' ? 'authentication' : norm_event_type == 'asset_discovery' ? 'discovery' : norm_event_type == 'vulnerability' ? 'vulnerability' : norm_event_type == 'new_connection' ? 'network' : 'other'"
          },
          {
            "name": "outcome",
            "value": "norm_action == 'success' || norm_action == 'logged' || norm_action == 'discovered' ? 'success' : norm_action == 'blocked' ? 'blocked' : norm_action == 'failed' ? 'failure' : norm_action == 'alert' || norm_action == 'detected' ? 'detected' : 'unknown'"
          }
        ],
        "remove": [
          "source_ip",
          "destination_ip",
          "port",
          "timestamp",
          "event_type",
          "severity",
          "protocol",
          "action",
          "user",
          "vendor",
          "model",
          "zone",
          "message",
          "asset_type"
        ]
      },
      "description": "Normalize and map extracted fields to standard schema"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 2: Reduction — drop noise events ---"
      }
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise)",
      "final": true
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Map fields to CommonSecurityLog schema ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "DeviceVendor",
            "value": "'Claroty'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Claroty CTD'"
          },
          {
            "name": "DeviceVersion",
            "value": "norm_model || ''"
          },
          {
            "name": "DeviceEventClassID",
            "value": "norm_event_type || 'unknown'"
          },
          {
            "name": "Activity",
            "value": "norm_event_type || ''"
          },
          {
            "name": "LogSeverity",
            "value": "norm_severity == 'critical' ? 10 : norm_severity == 'high' ? 8 : norm_severity == 'medium' ? 5 : norm_severity == 'warning' ? 3 : norm_severity == 'info' ? 1 : 0"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || ''"
          },
          {
            "name": "DestinationIP",
            "value": "dst_ip || ''"
          },
          {
            "name": "DestinationPort",
            "value": "dst_port ? Number(dst_port) : undefined"
          },
          {
            "name": "Protocol",
            "value": "norm_protocol || ''"
          },
          {
            "name": "ApplicationProtocol",
            "value": "norm_protocol || ''"
          },
          {
            "name": "DeviceAction",
            "value": "norm_action || ''"
          },
          {
            "name": "SourceUserName",
            "value": "norm_user || ''"
          },
          {
            "name": "DeviceName",
            "value": "norm_zone || ''"
          },
          {
            "name": "RequestURL",
            "value": "norm_message || ''"
          },
          {
            "name": "Message",
            "value": "norm_message || ''"
          },
          {
            "name": "DeviceCustomString1",
            "value": "norm_asset_type || ''"
          },
          {
            "name": "DeviceCustomString1Label",
            "value": "norm_asset_type ? 'AssetType' : ''"
          },
          {
            "name": "DeviceCustomString2",
            "value": "norm_vendor || ''"
          },
          {
            "name": "DeviceCustomString2Label",
            "value": "norm_vendor ? 'Vendor' : ''"
          },
          {
            "name": "EventOutcome",
            "value": "outcome || ''"
          }
        ]
      },
      "description": "Map fields to CommonSecurityLog schema"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 4: Build compact output ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "src_ip",
          "dst_ip",
          "dst_port",
          "norm_user",
          "norm_protocol",
          "norm_action",
          "norm_severity",
          "norm_vendor",
          "norm_model",
          "norm_zone",
          "norm_message",
          "norm_asset_type",
          "norm_event_type",
          "severity_id",
          "category",
          "outcome",
          "__*"
        ]
      },
      "description": "Remove intermediate normalized fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'claroty'"
          }
        ],
        "remove": [
          "__parsed",
          "__*"
        ]
      },
      "description": "Final cleanup - set sourcetype"
    }
  ],
