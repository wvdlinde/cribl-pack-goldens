  "functions": [
    {
      "id": "eval",
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'3002'"
          },
          {
            "name": "category_uid",
            "value": "'3'"
          },
          {
            "name": "event_type",
            "value": "'Certificate Authentication'"
          },
          {
            "name": "TimeGenerated",
            "value": "_time ? new Date(_time * 1000).toISOString() : new Date().toISOString()"
          },
          {
            "name": "DeviceVendor",
            "value": "'Ivanti'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Connect Secure'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "(message || '').match(/OCSP/i) ? 'certactivity:ocsp' : ((message || '').match(/revoked|CRL/i) ? 'certactivity:revocation' : ((message || '').match(/expired/i) ? 'certactivity:expired' : ((message || '').match(/untrusted|unknown root/i) ? 'certactivity:chain_untrusted' : ((message || '').match(/imported/i) ? 'certactivity:import' : 'certactivity:validation'))))"
          },
          {
            "name": "Activity",
            "value": "(message || '').match(/OCSP/i) ? ((result || '') == 'SUCCESS' ? 'OCSP Check Succeeded' : 'OCSP Check Failed') : ((result || '') == 'SUCCESS' ? 'Certificate Validated' : 'Certificate Validation Failed')"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || ''"
          },
          {
            "name": "SourceUserName",
            "value": "user || actor || ''"
          },
          {
            "name": "DestinationUserName",
            "value": "subject_CN || ''"
          },
          {
            "name": "DeviceAction",
            "value": "action || ((result || '') == 'SUCCESS' ? 'allow' : 'deny')"
          },
          {
            "name": "DeviceName",
            "value": "host || ''"
          },
          {
            "name": "LogSeverity",
            "value": "String((severity || '').toUpperCase() == 'CRIT' ? 9 : ((severity || '').toUpperCase() == 'ERROR' ? 7 : ((severity || '').toUpperCase() == 'WARN' ? 5 : ((severity || '').toUpperCase() == 'NOTICE' ? 3 : ((severity || '').toUpperCase() == 'INFO' ? 1 : Number(vendor_severity || 1))))))"
          },
          {
            "name": "RequestURL",
            "value": "crl_url || responder_url || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "ApplicationProtocol",
            "value": "(crl_url || responder_url || '').indexOf('https') === 0 ? 'HTTPS' : ((crl_url || responder_url) ? 'HTTP' : '')"
          },
          {
            "name": "Protocol",
            "value": "(protocol || 'TCP').toUpperCase()"
          },
          {
            "name": "SourceTranslatedAddress",
            "value": "src_ip || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_certactivity'"
          }
        ]
      }
    }
  ],
