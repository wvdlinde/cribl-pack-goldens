{
  "key": "splunk_app_soar_daemon::ocsf",
  "sourcetype": "splunk_app_soar_daemon",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:52:41.771Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<__ts>\\d{4}-\\d{2}-\\d{2}\\s\\d{2}:\\d{2}:\\d{2},\\d{3})\\s+(?<log_level>[A-Z]+)\\s+pid:(?<pid>\\d+)\\s+\\[(?<component>[^\\]]+)\\]\\s+(?<message>.*)$/"
      },
      "description": "Parse SOAR daemon log header: timestamp, level, pid, component, message"
    },
    {
      "id": "regex_extract",
      "filter": "message",
      "disabled": false,
      "conf": {
        "source": "message",
        "iterations": 1,
        "overwrite": false,
        "regex": "/container_id=(?<container_id>\\d+)/",
        "regexList": [
          {
            "regex": "/[Pp]laybook\\s+'(?<playbook>[^']+)'/"
          },
          {
            "regex": "/[Aa]sset\\s+'(?<asset>[^']+)'/"
          },
          {
            "regex": "/[Aa]ction\\s+'(?<action_name>[^']+)'/"
          },
          {
            "regex": "/[Jj]ob\\s+'(?<job_name>[^']+)'/"
          },
          {
            "regex": "/App\\s+'(?<app_name>[^']+)'\\s+version\\s+(?<app_version>[\\d.]+)/"
          },
          {
            "regex": "/[Uu]ser[\\s=]'(?<user>[^']+)'/"
          },
          {
            "regex": "/\\buser=(?<user>[A-Za-z0-9._-]+)/"
          },
          {
            "regex": "/\\bby\\s+(?:user\\s+)?(?<user>[A-Za-z0-9._-]+)/"
          },
          {
            "regex": "/severity=(?<case_severity>\\w+)/"
          },
          {
            "regex": "/label='(?<case_label>[^']+)'/"
          },
          {
            "regex": "/owner=(?<owner>[A-Za-z0-9._-]+)/"
          },
          {
            "regex": "/\\bversion\\s+(?<soar_version>\\d[\\d.]+)/"
          },
          {
            "regex": "/on\\s+host\\s+(?<dvc_host>[A-Za-z0-9._-]+)/"
          },
          {
            "regex": "/actions_executed=(?<actions_executed>\\d+)/"
          },
          {
            "regex": "/actions_failed=(?<actions_failed>\\d+)/"
          },
          {
            "regex": "/[Ii]ngested\\s+(?<artifact_count>\\d+)\\s+artifacts/"
          },
          {
            "regex": "/from\\s+source\\s+'(?<ingest_source>[^']+)'/"
          },
          {
            "regex": "/attempt\\s+(?<attempt_num>\\d+)\\/(?<attempt_max>\\d+)/"
          }
        ]
      },
      "description": "Extract SOAR entities (user, playbook, asset, action, container, case metadata) from message"
    },
    {
      "id": "regex_extract",
      "filter": "message",
      "disabled": false,
      "conf": {
        "source": "message",
        "iterations": 1,
        "overwrite": false,
        "regex": "/\\bfrom\\s+(?:IPv6\\s+address\\s+)?(?<src_ip>(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4})/",
        "regexList": [
          {
            "regex": "/(?:\\bto|asset_ip=)\\s*(?<dst_ip>(?:\\d{1,3}\\.){3}\\d{1,3})(?::(?<dst_port>\\d{1,5}))?/"
          },
          {
            "regex": "/(?:\\bto|asset_ip=)\\s*(?<dst_ip>(?:[0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4})/"
          }
        ]
      },
      "description": "Extract source and destination IPs (IPv4 and IPv6) and destination port"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "__ts ? strptime(__ts, '%Y-%m-%d %H:%M:%S,%L') : _time"
          },
          {
            "name": "timestamp",
            "value": "__ts"
          },
          {
            "name": "severity",
            "value": "log_level=='CRITICAL' ? 'critical' : (log_level=='ERROR' ? 'high' : (log_level=='WARN' ? 'medium' : (log_level=='INFO' ? 'informational' : 'unknown')))"
          },
          {
            "name": "action",
            "value": "message.match(/fail|timed out|unreachable|invalid|exception|error|disabling/i) ? 'failure' : (message.match(/success|completed|installed|executed|logged __e['in']|Ingested|created|triggered|Starting/i) ? 'success' : 'unknown')"
          },
          {
            "name": "protocol",
            "value": "dst_port ? 'tcp' : undefined"
          },
          {
            "name": "src_ip_version",
            "value": "src_ip ? (src_ip.indexOf(':') > -1 ? 6 : 4) : undefined"
          },
          {
            "name": "dst_ip_version",
            "value": "dst_ip ? (dst_ip.indexOf(':') > -1 ? 6 : 4) : undefined"
          },
          {
            "name": "vendor",
            "value": "'Splunk'"
          },
          {
            "name": "product",
            "value": "'SOAR'"
          },
          {
            "name": "event_type",
            "value": "component ? component.replace(/^phantom\\./, '') : undefined"
          }
        ],
        "remove": [
          "__ts"
        ]
      },
      "description": "Normalize timestamp, severity, action, protocol and IP version; drop scratch fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "time",
            "value": "Number(new Date(timestamp).getTime())"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          },
          {
            "name": "device.hostname",
            "value": "dvc_host || ''"
          },
          {
            "name": "metadata.version",
            "value": "soar_version || ''"
          },
          {
            "name": "metadata.product.name",
            "value": "product || ''"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "vendor || ''"
          },
          {
            "name": "severity_id",
            "value": "severity == 'CRITICAL' ? 5 : severity == 'ERROR' ? 4 : severity == 'WARN' ? 3 : severity == 'INFO' ? 1 : 0"
          },
          {
            "name": "activity_id",
            "value": "action == 'blocked' || action == 'block' ? 2 : action == 'allowed' || action == 'allow' ? 1 : 0"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "type_uid",
            "value": "400101"
          }
        ]
      },
      "description": "Map fields (continued 16-18)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'splunk_app_soar:daemon'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}