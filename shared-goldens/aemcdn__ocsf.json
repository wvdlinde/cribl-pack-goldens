{
  "key": "aemcdn::ocsf",
  "sourcetype": "aemcdn",
  "dest_format": "ocsf",
  "score": 92,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:55:06.003Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^\\S+\\s+(?<edge_node>\\S+)\\s+aemcdn\\[(?<log_channel>\\w+)\\]:\\s+(?<__json_payload>\\{.*\\})$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse syslog header to isolate edge node, log channel, and embedded JSON payload"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "json",
        "srcField": "__json_payload"
      },
      "description": "Extract WAF/CDN JSON fields (timestamp, client_ip, method, url, status, waf_action, etc.) from the embedded JSON payload"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "client_ip"
          },
          {
            "name": "dst_host",
            "value": "host"
          },
          {
            "name": "protocol",
            "value": "tls_version ? 'https' : 'http'"
          },
          {
            "name": "action",
            "value": "waf_action=='block' ? 'blocked' : (waf_action=='rate_limit' ? 'rate_limited' : 'allowed')"
          },
          {
            "name": "severity",
            "value": "status>=500 ? 'critical' : (waf_action=='block' ? 'high' : (waf_action=='rate_limit' ? 'medium' : (status>=400 ? 'medium' : 'info')))"
          },
          {
            "name": "message",
            "value": "waf_message ? waf_message : (method+' '+url+' '+status)"
          },
          {
            "name": "_time",
            "value": "Date.parse(timestamp)/1000"
          }
        ],
        "remove": [
          "__json_payload"
        ]
      },
      "description": "Normalize extracted fields into standard names, derive action/severity/protocol, and clean up scratch field"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || client_ip || ''"
          },
          {
            "name": "device.hostname",
            "value": "host || dst_host || edge_node || ''"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || tls_version || 'HTTPS'"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(bytes_sent || 0)"
          },
          {
            "name": "time",
            "value": "Date.parse(timestamp || _time)"
          },
          {
            "name": "severity_id",
            "value": "Number(status) >= 500 ? 4 : Number(status) >= 400 ? 3 : Number(status) >= 300 ? 2 : 1"
          },
          {
            "name": "activity_id",
            "value": "waf_action == 'block' ? 5 : waf_action == 'rate_limit' ? 4 : 6"
          },
          {
            "name": "type_uid",
            "value": "400100 + (waf_action == 'block' ? 5 : waf_action == 'rate_limit' ? 4 : 6)"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "metadata.product.name",
            "value": "'AEM CDN'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Adobe'"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.version",
            "value": "'1.0.0'"
          }
        ]
      },
      "description": "Map fields (continued 16-16)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'aemcdn'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
