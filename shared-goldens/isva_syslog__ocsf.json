            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || method || ''"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          },
          {
            "name": "device.hostname",
            "value": "host || ''"
          },
          {
            "name": "time",
            "value": "Number(_time)"
          },
          {
            "name": "severity_id",
            "value": "severity == 'ERROR' ? 4 : severity == 'WARNING' ? 3 : severity == 'NOTICE' ? 2 : severity == 'INFO' ? 1 : 0"
          },
          {
            "name": "activity_id",
            "value": "outcome == 'SUCCESS' ? 1 : outcome == 'FAILURE' ? 2 : outcome == 'PENDING' ? 3 : 0"
          },
          {
