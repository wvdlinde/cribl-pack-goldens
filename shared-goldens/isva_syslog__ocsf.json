{
  "key": "isva_syslog::ocsf",
  "sourcetype": "isva_syslog",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:58:48.574Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<pri>\\d+)>(?<timestamp>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<process>[\\w\\-]+)\\[(?<pid>\\d+)\\]:\\s+(?<msgid>\\S+)\\s+(?<message>.*?[.!])\\s+(?<__kvp>severity=.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse syslog header (priority, timestamp, host, process, pid, msgid), free-text message, and trailing key=value block"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp",
        "cleanFields": true
      },
      "description": "Extract key=value pairs (severity, sourceip, port, method, resource, authmethod, sessionid, outcome, reason, retrycount, sslprotocol, tokenexpiry, etc.) from the trailing KVP block"
    },
    {
      "id": "regex_extract",
      "filter": "message",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/'(?<user>[^']+)'/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract the quoted username from the free-text message when present"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "sourceip"
          },
          {
            "name": "dst_port",
            "value": "port"
          },
          {
            "name": "protocol",
            "value": "sslprotocol ? sslprotocol : (method === 'TLS' ? 'TLS' : 'HTTPS')"
          },
          {
            "name": "action",
            "value": "outcome === 'SUCCESS' ? 'allowed' : outcome === 'FAILURE' ? 'blocked' : outcome === 'PENDING' ? 'pending' : 'unknown'"
          }
        ],
        "remove": [
          "__kvp",
          "sourceip",
          "port",
          "pri",
          "pid"
        ]
      },
      "description": "Normalize IP, port, protocol, and action fields; derive protocol from TLS/method/sslprotocol; map outcome to a normalized action"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
