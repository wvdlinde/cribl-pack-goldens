        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse ESXi hostd-cgi-server syslog header (timestamp, host, process, pid, Originator context)"
    },
    {
      "id": "regex_extract",
      "filter": "message && /^(GET|POST|PUT|DELETE|HEAD|OPTIONS|PATCH)\\s/.test(message)",
