        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse HTTP request lines (method, uri, status, client, bytes, response time)"
    },
    {
      "id": "regex_extract",
      "filter": "message && !src_ip",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/(?:^(?<__inline_level>warning|error|critical):\\s*)?(?:.*?user\\s+'(?<user>[^']+)')?(?:.*?\\b(?:from|by|client|Client|with client)\\s+\\[?(?<src_ip>(?:\\d{1,3}\\.){3}\\d{1,3}|[0-9a-fA-F]{0,4}(?::[0-9a-fA-F]{0,4}){2,7})\\]?(?::(?<src_port>\\d{1,5}))?)?/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract inline severity prefix, username and client IP/port from non-HTTP messages"
    },
    {
      "id": "regex_extract",
      "filter": "message && !user && /User\\s+'/.test(message)",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/User\\s+'(?<user>[^']+)'/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract username from 'User <name> authenticated' style messages"
    },
