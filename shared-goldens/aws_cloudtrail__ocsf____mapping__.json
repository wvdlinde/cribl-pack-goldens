      }
    },
    {
      "id": "eval",
      "description": "Map parsed CloudTrail fields to OCSF API Activity target schema.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "time",
            "value": "Date.parse(parsed.eventTime)/1000"
          },
          {
            "name": "category_uid",
            "value": "6"
          },
          {
            "name": "api.operation",
            "value": "parsed.eventName"
          },
          {
            "name": "api.request.uid",
            "value": "parsed.requestID"
          },
          {
            "name": "api.response.error",
            "value": "parsed.errorCode ? parsed.errorCode : null"
          },
          {
            "name": "api.response.error_message",
            "value": "parsed.errorMessage ? parsed.errorMessage : null"
          },
          {
            "name": "api.response.message",
            "value": "parsed.errorMessage ? parsed.errorMessage : parsed.eventName"
          },
          {
            "name": "message",
            "value": "parsed.eventSource + ' ' + parsed.eventName"
          },
          {
            "name": "status_code",
            "value": "parsed.errorCode ? parsed.errorCode : 'Success'"
          },
          {
            "name": "status_detail",
            "value": "parsed.errorMessage ? parsed.errorMessage : (parsed.readOnly ? 'ReadOnly API call' : 'Write API call')"
          },
          {
            "name": "unmapped.eventVersion",
            "value": "parsed.eventVersion"
          },
          {
            "name": "unmapped.userIdentity",
            "value": "parsed.userIdentity"
          },
          {
            "name": "unmapped.eventSource",
            "value": "parsed.eventSource"
          },
