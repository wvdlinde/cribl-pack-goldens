{
  "key": "ivanti_top::ocsf",
  "sourcetype": "ivanti_top",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:56:17.640Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}) (?<dst_host>\\S+) : (?<event_code>[A-Z]+\\d+): (?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract timestamp, appliance host, event code, and message body from base Ivanti ICS log line"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/'[^']+'/)",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/'(?<user>[^']+)'/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract the quoted user/administrator name referenced in the message"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.includes('from ')",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/from (?<src_ip>[0-9a-fA-F:.]+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract source IP (IPv4 or IPv6) following 'from' in the message"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.includes('assigned IP')",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/assigned IP (?<assigned_ip>[0-9.]+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract VPN-assigned internal IP address for tunnel establishment events"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message.match(/successful|established/) ? 'allow' : message.match(/failed|denied|blocked|violation/) ? 'deny' : 'info'"
          },
          {
            "name": "severity",
            "value": "event_code.startsWith('SEC') ? 'high' : (event_code.startsWith('AUT') && action=='deny') ? 'medium' : (event_code.startsWith('NHC') ? 'medium' : 'low')"
          },
          {
            "name": "protocol",
            "value": "'vpn'"
          }
        ],
        "remove": []
      },
      "description": "Classify action, severity, and protocol based on message content and event code prefix"
    },
    {
      "id": "eval",
      "filter": "timestamp",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "Math.floor(new Date(timestamp.replace(' ', 'T')).getTime()/1000)"
          }
        ],
        "remove": []
      },
      "description": "Derive epoch _time from extracted timestamp string"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "assigned_ip || ''"
          },
          {
            "name": "device.hostname",
            "value": "dst_host || ''"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || ''"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          },
          {
            "name": "activity_id",
            "value": "action == 'allowed' || action == 'success' ? 1 : (action == 'blocked' || action == 'failed' ? 2 : 0)"
          },
          {
            "name": "severity_id",
            "value": "severity ? Number(severity) : 0"
          },
          {
            "name": "time",
            "value": "Number(_time) ? Number(_time) * 1000 : Date.parse(timestamp)"
          },
          {
            "name": "metadata.product.name",
            "value": "'Ivanti Connect Secure'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Ivanti'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_top'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}