{
  "key": "ivanti_messages::__extraction__",
  "sourcetype": "ivanti_messages",
  "dest_format": "__extraction__",
  "score": 100,
  "part": "extraction",
  "author": "unknown",
  "build": 378,
  "updated_at": "2026-08-07T14:12:19.456Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse base Ivanti ICS syslog structure: timestamp, host, appliance IP, module, event code, and message body",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<dst_host>\\S+)\\s+ive:\\s+\\[(?<device_ip>[0-9a-fA-F:.]+)\\]\\s+(?<module>\\w+)\\(\\)\\[\\]:\\s+(?<event_code>\\w+):\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "module=='Auth'",
      "disabled": false,
      "description": "Extract user, realm, source IP and result for primary/secondary authentication events",
      "conf": {
        "source": "message",
        "regex": "/(?:Primary|Secondary) authentication (?<auth_result>successful|failed) for (?<user>[^\\/]+)\\/(?<auth_realm>\\S+) from (?<src_ip>[0-9.]+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "module=='VPNTunneling'",
      "disabled": false,
      "description": "Extract VPN tunnel establishment/disconnection details including user, assigned IP, and session duration",
      "conf": {
        "source": "message",
        "regex": "/VPN tunnel (?<vpn_action>established|disconnected) for user (?<user>\\w+)(?:, assigned IP (?<dst_ip>[0-9.]+))?(?:, session duration (?<session_duration>[0-9:]+))?/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "module=='Admin' && message && message.startsWith('Administrator')",
      "disabled": false,
      "description": "Extract admin user, source IP and protocol for administrator login events",
      "conf": {
        "source": "message",
        "regex": "/Administrator (?<user>\\w+) logged in from (?<src_ip>[0-9.]+) via (?<protocol>\\w+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "module=='Security'",
      "disabled": false,
      "description": "Extract source IP, optional user, and description for security alerts such as policy violations and brute force detections",
      "conf": {
        "source": "message",
        "regex": "/(?:for user (?<user>\\w+) )?from (?<src_ip>[0-9.]+)(?:\\s*-\\s*(?<description>.*))?/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize action, severity, and protocol fields based on module and extracted event context",
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "auth_result ? (auth_result=='successful' ? 'success' : 'failure') : vpn_action ? vpn_action : module=='Security' ? 'alert' : module=='Admin' ? 'config_change' : module=='WebServer' ? 'webrequest' : module=='System' ? 'info' : 'unknown'"
          },
          {
            "name": "severity",
            "value": "module=='Security' ? 'high' : (module=='Auth' && auth_result=='failed') ? 'medium' : module=='Admin' ? 'medium' : 'low'"
          },
          {
            "name": "protocol",
            "value": "protocol ? protocol : (module=='VPNTunneling' ? 'vpn' : (module=='WebServer' ? 'http' : 'n/a'))"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}