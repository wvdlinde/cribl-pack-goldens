  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'Network_Traffic'"
          },
          {
            "name": "category_uid",
            "value": "'Network'"
          },
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "src_ip || ''"
          },
          {
            "name": "dest_port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "vendor_action",
