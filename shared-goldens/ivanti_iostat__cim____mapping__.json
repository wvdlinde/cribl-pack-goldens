          },
          {
            "name": "app",
            "value": "auth_module || proc || ''"
          },
          {
            "name": "user",
            "value": "user || ''"
          },
          {
            "name": "session_id",
            "value": "session_id || ''"
          },
          {
            "name": "dvc",
            "value": "host || ''"
          },
          {
            "name": "process",
            "value": "proc || auth_module || ''"
          },
          {
            "name": "signature",
            "value": "event || ''"
          },
          {
            "name": "object",
            "value": "device || ''"
          },
          {
            "name": "severity",
            "value": "(severity || '').toLowerCase()"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "severity_id",
            "value": "severity == 'CRITICAL' ? 10 : severity == 'WARN' ? 6 : severity == 'INFO' ? 3 : 0"
          },
          {
            "name": "message_id",
            "value": "msg || ''"
          },
          {
            "name": "vendor_product",
            "value": "proc || auth_module || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_iostat'"
          }
        ]
      }
    }
