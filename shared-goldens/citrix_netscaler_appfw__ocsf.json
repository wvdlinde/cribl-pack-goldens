{
  "key": "citrix_netscaler_appfw::ocsf",
  "sourcetype": "citrix_netscaler_appfw",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:01:19.699Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<syslog_ts>\\w+\\s+\\d+\\s+\\d+:\\d+:\\d+)\\s+\\S+\\s+(?<netscaler_ts>\\d{2}\\/\\d{2}\\/\\d{4}:\\d{2}:\\d{2}:\\d{2})\\s+GMT\\s+\\S+\\s+(?<ppe>\\S+)\\s+:\\s+APPFW\\s+(?<sig_category>\\S+)\\s+(?<result>\\S+)\\s+(?<session_id>\\d+)\\s+(?<seq>\\d+)\\s+:\\s+(?<src_ip>\\S+)\\s+(?<port_pair>\\S+)\\s+(?<profile>\\S+)\\s+(?<method>\\S+)\\s+(?<url>\\S+)\\s+(?<policy_name>\\S+)\\s+(?<signature>\\S+)\\s+(?<severity>\\S+)\\s+(?<action>\\S+)\\s+threat_index=(?<threat_index>[\\d.]+)\\s+status=(?<status>\\d+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract core Citrix NetScaler AppFW fields from syslog line"
    },
    {
      "id": "regex_extract",
      "filter": "port_pair && port_pair !== '-' && port_pair.indexOf('-') > -1",
      "disabled": false,
      "conf": {
        "source": "port_pair",
        "regex": "/^(?<src_port>\\d+)-(?<dst_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Split combined src-dst port field into separate ports"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "timestamp",
            "value": "netscaler_ts ? netscaler_ts.replace(/^(\\d{2})\\/(\\d{2})\\/(\\d{4}):/, '$3-$1-$2T') : syslog_ts"
          }
        ]
      },
      "description": "Build ISO timestamp field from NetScaler timestamp components"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action_normalized",
            "value": "action === 'BLOCKED' ? 'blocked' : action === 'DROPPED' ? 'dropped' : action === 'RESET' ? 'reset' : action === 'TRANSFORMED' ? 'transformed' : action === 'NONE' ? 'allowed' : 'unknown'"
          },
          {
            "name": "protocol",
            "value": "'tcp'"
          }
        ]
      },
      "description": "Normalize action and protocol fields, set static protocol for HTTP-based AppFW events"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "port_pair"
        ]
      },
      "description": "Cleanup scratch fields no longer needed after port split"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "action_normalized == 'BLOCKED' || action_normalized == 'DROPPED' ? 5 : action_normalized == 'RESET' ? 3 : action_normalized == 'TRANSFORMED' ? 1 : 99"
          },
          {
            "name": "type_uid",
            "value": "4001 * 100 + (action_normalized == 'BLOCKED' || action_normalized == 'DROPPED' ? 5 : action_normalized == 'RESET' ? 3 : action_normalized == 'TRANSFORMED' ? 1 : 99)"
          },
          {
            "name": "severity_id",
            "value": "severity == 'CRITICAL' ? 5 : severity == 'HIGH' ? 4 : severity == 'ERROR' ? 3 : severity == 'WARNING' ? 2 : 1"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "metadata.product.name",
            "value": "'NetScaler AppFW'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Citrix'"
          },
          {
            "name": "metadata.version",
            "value": "'1.0.0'"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "time",
            "value": "Number(_time) * 1000"
          }
        ]
      },
      "description": "Map fields (continued 16-16)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'citrix:netscaler:appfw'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}