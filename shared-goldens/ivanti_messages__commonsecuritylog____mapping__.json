          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'CommonSecurityLog'"
          },
          {
            "name": "category_uid",
            "value": "'Custom-CommonSecurityLog'"
          },
          {
            "name": "event_type",
            "value": "'Microsoft-CommonSecurityLog'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : new Date((_time || Date.now()/1000) * 1000).toISOString()"
          },
          {
            "name": "DeviceVendor",
            "value": "'Ivanti'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Connect Secure'"
          },
          {
            "name": "DeviceVersion",
            "value": "(message || '').match(/build\\s+(\\S+)/) ? (message || '').match(/build\\s+(\\S+)/)[1] : ''"
          },
          {
            "name": "DeviceEventClassID",
            "value": "String(event_code || module || '')"
          },
          {
            "name": "Activity",
            "value": "module == 'AUT' ? ((action || '').toLowerCase() == 'failure' || (action || '').toLowerCase() == 'failed' ? 'Authentication Failed' : 'Authentication Successful') : module == 'NWC' ? 'VPN Session Event' : module == 'ADM' ? 'Administrative Change' : module == 'SEC' ? 'Security Alert' : module == 'SYS' ? 'System Event' : 'Ivanti Event'"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || ''"
          },
          {
            "name": "SourceUserName",
            "value": "user || ''"
          },
          {
            "name": "DeviceAction",
            "value": "(action || '').toLowerCase() == 'success' ? 'success' : (action || '').toLowerCase() == 'failure' ? 'failure' : (action || '')"
          },
          {
            "name": "LogSeverity",
            "value": "String(vendor_severity || severity || '').toLowerCase() == 'critical' ? '10' : String(vendor_severity || severity || '').toLowerCase() == 'major' ? '8' : String(vendor_severity || severity || '').toLowerCase() == 'warning' ? '6' : String(vendor_severity || severity || '').toLowerCase() == 'notice' ? '4' : String(vendor_severity || severity || '').toLowerCase() == 'info' ? '2' : '0'"
          },
          {
            "name": "DeviceName",
            "value": "host || ''"
          },
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-21)",
      "conf": {
        "add": [
          {
            "name": "ApplicationProtocol",
            "value": "module == 'NWC' ? 'VPN' : module == 'AUT' ? 'HTTPS' : ''"
          },
          {
            "name": "SentBytes",
            "value": "(message || '').match(/tx=(\\d+)/) ? Number((message || '').match(/tx=(\\d+)/)[1]) : 0"
          },
          {
            "name": "ReceivedBytes",
            "value": "(message || '').match(/rx=(\\d+)/) ? Number((message || '').match(/rx=(\\d+)/)[1]) : 0"
          },
          {
            "name": "DestinationIP",
            "value": "(message || '').match(/to\\s+((?:\\d{1,3}\\.){3}\\d{1,3})/) ? (message || '').match(/to\\s+((?:\\d{1,3}\\.){3}\\d{1,3})/)[1] : ''"
          },
          {
            "name": "DestinationUserName",
            "value": "module == 'ADM' && user ? user : ''"
          },
          {
            "name": "RequestURL",
            "value": "(message || '').match(/(https?:\\/\\/\\S+)/) ? (message || '').match(/(https?:\\/\\/\\S+)/)[1] : ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_messages'"
          }
        ]
      }
    }
  ],
