            "value": "message_name || message_type || ''"
          },
          {
            "name": "SourceIP",
            "value": "Address || NAS_IP_Address || Remote_Address || AdminIPAddress || ''"
          },
          {
            "name": "SourcePort",
            "value": "Number(NAS_Port || Port || 0)"
          },
          {
            "name": "DestinationIP",
            "value": "DestinationIPAddress || ''"
          },
          {
            "name": "DestinationPort",
            "value": "Number(DestinationPort || 0)"
          },
          {
            "name": "Protocol",
            "value": "Protocol || ''"
          },
          {
            "name": "DeviceAction",
            "value": "action || FailureReason || AuthenticationStatus || ''"
          },
          {
            "name": "SourceUserName",
            "value": "UserName || User_Name || User || OriginalUserName || ''"
          },
          {
            "name": "SentBytes",
            "value": "Number(sent || 0)"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-20)",
      "conf": {
        "add": [
          {
            "name": "ReceivedBytes",
            "value": "Number(rcvd || 0)"
          },
          {
            "name": "ApplicationProtocol",
            "value": "Service_Type || Service || ''"
          },
          {
            "name": "DeviceName",
            "value": "NetworkDeviceName || host || ''"
          },
          {
            "name": "LogSeverity",
            "value": "severity == 'CRITICAL' ? '10' : severity == 'ALERT' ? '9' : severity == 'ERROR' ? '8' : severity == 'WARNING' ? '6' : severity == 'NOTICE' ? '5' : severity == 'INFO' ? '3' : severity == 'DEBUG' ? '2' : String(vendor_severity || '3')"
          },
          {
            "name": "RequestURL",
            "value": "cisco_av_pair_url_redirect || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'cisco_ise'"
          }
        ]
