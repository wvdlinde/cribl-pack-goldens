{
  "key": "tenable_sc_vuln::commonsecuritylog::__mapping__",
  "sourcetype": "tenable_sc_vuln",
  "dest_format": "commonsecuritylog::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 648,
  "updated_at": "2026-08-31T11:58:05.119Z",
  "functions": [
    {
      "id": "eval",
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'CommonSecurityLog'"
          },
          {
            "name": "category_uid",
            "value": "'Vulnerability'"
          },
          {
            "name": "event_type",
            "value": "'tenable_sc_vuln_detected'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : new Date(_time * 1000).toISOString()"
          },
          {
            "name": "DeviceVendor",
            "value": "'Tenable'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Tenable.sc'"
          },
          {
            "name": "DeviceVersion",
            "value": "String(type || 'vuln')"
          },
          {
            "name": "DeviceEventClassID",
            "value": "String(pluginID || event || '')"
          },
          {
            "name": "Activity",
            "value": "event == 'vuln_critical_detected' ? 'Critical Vulnerability Detected' : (event == 'vuln_scan_completed' ? 'Scan Completed' : (event == 'vuln_detected' ? 'Vulnerability Detected' : String(event || 'Vulnerability Event')))"
          },
          {
            "name": "DestinationIP",
            "value": "ip || ''"
          },
          {
            "name": "DestinationPort",
            "value": "Number(port || 0)"
          },
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "ApplicationProtocol",
            "value": "Number(port || 0) == 443 ? 'HTTPS' : (Number(port || 0) == 80 ? 'HTTP' : (Number(port || 0) == 22 ? 'SSH' : (Number(port || 0) == 445 ? 'SMB' : (Number(port || 0) == 8080 ? 'HTTP' : ''))))"
          },
          {
            "name": "DeviceName",
            "value": "dnsName || ip || ''"
          },
          {
            "name": "LogSeverity",
            "value": "String(severityName == 'Critical' ? 10 : (severityName == 'High' ? 8 : (severityName == 'Medium' ? 5 : (severityName == 'Low' ? 3 : Number(severity || 0)))))"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "DeviceAction",
            "value": "status || (event == 'vuln_scan_completed' ? 'Completed' : 'Detected')"
          },
          {
            "name": "RequestURL",
            "value": "cve ? 'https://nvd.nist.gov/vuln/detail/' + String(cve).split(',')[0] : ''"
          },
          {
            "name": "DestinationTranslatedAddress",
            "value": "macAddress ? ip : ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'tenable_sc_vuln'"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
