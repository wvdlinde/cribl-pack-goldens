  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3})\\s+(?<severity>\\w+)\\s+\\[(?<logger>[^\\]]+)\\]\\s+(?<__kvp_rest>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract timestamp, severity, logger class, and remaining key=value payload from raw Hypori log line"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp_rest",
        "cleanFields": true
      },
      "description": "Parse the trailing key=value pairs (user, host, clientIp, action, result, etc.) from the scratch field into structured fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "clientIp"
          },
          {
            "name": "dst_host",
            "value": "host"
          }
        ]
      },
      "description": "Normalize network and host fields to standard naming conventions (src_ip, dst_host)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : severity"
          },
          {
            "name": "action_result",
            "value": "result ? action + '_' + result : action"
          }
        ]
      },
      "description": "Normalize severity casing and derive a unified action outcome field from action/result"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [],
        "remove": [
          "__kvp_rest",
          "clientIp",
          "host"
        ]
      },
      "description": "Cleanup scratch and duplicate fields, retaining only normalized field names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
