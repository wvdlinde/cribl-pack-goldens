            "value": "user && user != '-' ? user : ''"
          },
          {
            "name": "action",
            "value": "(status || '').toUpperCase() == 'SUCCESS' ? 'allowed' : ((status || '').toUpperCase() == 'FAILURE' ? 'blocked' : 'unknown')"
          },
          {
            "name": "vendor_action",
            "value": "action_taken || action || event || status || ''"
          },
          {
            "name": "session_id",
            "value": "session_id || ''"
          },
          {
            "name": "rule",
