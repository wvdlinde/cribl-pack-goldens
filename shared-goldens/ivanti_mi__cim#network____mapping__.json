          },
          {
            "name": "src_mac",
            "value": "device_id && String(device_id).match(/^[0-9A-Fa-f]{12}$/) ? String(device_id).toUpperCase().replace(/(..)(?=.)/g, '$1:') : ''"
          },
          {
            "name": "flow_id",
            "value": "device_id && device_id != '-' ? String(device_id) : ''"
          },
          {
            "name": "vendor_account",
            "value": "initiated_by || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-20)",
      "conf": {
        "add": [
          {
            "name": "app",
            "value": "platform && platform != '-' ? 'IvantiMI-' + platform : 'IvantiMI'"
          },
          {
            "name": "direction",
            "value": "src_ip ? (C.Net.isPrivate(src_ip) ? 'internal' : 'inbound') : ''"
          },
          {
            "name": "packets",
