{
  "key": "trendmicro_interscan::ocsf",
  "sourcetype": "trendmicro_interscan",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:56:58.623Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^CEF:(?<cef_version>\\d+)\\|(?<vendor>[^|]*)\\|(?<product>[^|]*)\\|(?<product_version>[^|]*)\\|(?<signature_id>[^|]*)\\|(?<event_name>[^|]*)\\|(?<severity>[^|]*)\\|(?<extension>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse CEF header fields (vendor, product, version, signature, name, severity) and isolate the extension KVP blob"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "extension",
        "cleanFields": true
      },
      "description": "Extract space-delimited key=value pairs from the CEF extension into individual fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "timestamp",
            "value": "rt"
          },
          {
            "name": "src_ip",
            "value": "src"
          },
          {
            "name": "dst_ip",
            "value": "dst"
          },
          {
            "name": "dst_port",
            "value": "dpt"
          },
          {
            "name": "protocol",
            "value": "proto"
          },
          {
            "name": "action",
            "value": "act"
          },
          {
            "name": "user",
            "value": "suser"
          },
          {
            "name": "dst_user",
            "value": "duser"
          },
          {
            "name": "url",
            "value": "request"
          },
          {
            "name": "dst_host",
            "value": "dhost"
          },
          {
            "name": "message",
            "value": "msg"
          },
          {
            "name": "file_size",
            "value": "cn1"
          },
          {
            "name": "threat_name",
            "value": "cs1"
          }
        ],
        "remove": [
          "rt",
          "src",
          "dst",
          "dpt",
          "proto",
          "act",
          "suser",
          "duser",
          "request",
          "dhost",
          "msg",
          "cn1",
          "cs1",
          "cs1Label",
          "cn1Label",
          "extension"
        ]
      },
      "description": "Normalize CEF extension abbreviations to standard field names and drop the raw KVP keys"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "protocol",
            "value": "protocol ? protocol.toUpperCase() : protocol"
          },
          {
            "name": "vendor_action",
            "value": "action || undefined"
          },
          {
            "name": "action",
            "value": "action ? action.toLowerCase() : action"
          },
          {
            "name": "severity_label",
            "value": "Number(severity) >= 8 ? 'critical' : Number(severity) >= 5 ? 'high' : Number(severity) >= 3 ? 'medium' : 'low'"
          }
        ]
      },
      "description": "Normalize protocol/action casing and derive a human-readable severity label"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "actor.user.name",
            "value": "user || dst_user || ''"
          },
          {
            "name": "metadata.product.name",
            "value": "product || ''"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "vendor || ''"
          },
          {
            "name": "metadata.version",
            "value": "product_version || ''"
          },
          {
            "name": "time",
            "value": "Number(_time) ? Number(_time) : (timestamp ? Date.parse(timestamp)/1000 : Date.now()/1000)"
          },
          {
            "name": "activity_id",
            "value": "action == 'Blocked' ? 2 : action == 'Allowed' ? 1 : action == 'Quarantined' ? 2 : action == 'Cleaned' ? 2 : action == 'Delivered' ? 1 : action == 'Failed' ? 4 : 99"
          },
          {
            "name": "type_uid",
            "value": "4001 * 100 + (action == 'Blocked' ? 2 : action == 'Allowed' ? 1 : action == 'Quarantined' ? 2 : action == 'Cleaned' ? 2 : action == 'Delivered' ? 1 : action == 'Failed' ? 4 : 99)"
          },
          {
            "name": "severity_id",
            "value": "Number(severity) <= 2 ? 1 : Number(severity) <= 4 ? 2 : Number(severity) <= 6 ? 3 : Number(severity) <= 8 ? 4 : 5"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'trendmicro:interscan'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}