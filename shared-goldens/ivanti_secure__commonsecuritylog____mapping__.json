{
  "key": "ivanti_secure::commonsecuritylog::__mapping__",
  "sourcetype": "ivanti_secure",
  "dest_format": "commonsecuritylog::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 648,
  "updated_at": "2026-08-31T11:38:46.220Z",
  "functions": [
    {
      "id": "eval",
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'CommonSecurityLog'"
          },
          {
            "name": "category_uid",
            "value": "'Microsoft-CommonSecurityLog'"
          },
          {
            "name": "event_type",
            "value": "'Custom-CommonSecurityLog'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : new Date(_time * 1000).toISOString()"
          },
          {
            "name": "DeviceName",
            "value": "host || ''"
          },
          {
            "name": "DeviceVendor",
            "value": "'Ivanti'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Ivanti Connect Secure'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "String(event_id || module || '')"
          },
          {
            "name": "Activity",
            "value": "module == 'AUT' ? ((message || '').indexOf('failed') > -1 ? 'Authentication Failed' : 'Authentication Succeeded') : (module == 'VPN' ? 'VPN Tunnel Established' : (module == 'WEB' ? 'Web Request' : (module == 'ADM' ? 'Admin Configuration Change' : (module == 'NWC' ? 'Connection Blocked' : (module == 'SYS' ? 'System Event' : 'Ivanti Secure Event')))))"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || ''"
          },
          {
            "name": "DestinationIP",
            "value": "dst_ip || ''"
          },
          {
            "name": "DestinationPort",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "ApplicationProtocol",
            "value": "module == 'WEB' ? 'HTTPS' : (module == 'VPN' ? ((protocol || '').toUpperCase() == 'ESP' ? 'IPSEC' : 'SSL-VPN') : '')"
          },
          {
            "name": "DeviceAction",
            "value": "action || ((message || '').match(/blocked|denied/i) ? 'blocked' : ((message || '').match(/failed/i) ? 'failure' : 'permitted'))"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "SourceUserName",
            "value": "user || ''"
          },
          {
            "name": "LogSeverity",
            "value": "(severity || '').toLowerCase() == 'critical' ? '9' : ((severity || '').toLowerCase() == 'error' ? '7' : ((severity || '').toLowerCase() == 'warn' ? '6' : ((severity || '').toLowerCase() == 'notice' ? '4' : ((severity || '').toLowerCase() == 'info' ? '3' : '1'))))"
          },
          {
            "name": "RequestURL",
            "value": "(message || '').match(/(\\/[A-Za-z0-9_\\-\\.\\/]+)/) ? (message || '').match(/(\\/[A-Za-z0-9_\\-\\.\\/]+)/)[1] : ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_secure'"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "kvp",
      "keys": [
        "dport",
        "dst",
        "id",
        "msg",
        "proto",
        "realm",
        "roles",
        "severity",
        "src",
        "user",
        "vpn"
      ]
    }
  },
  "report": null
}