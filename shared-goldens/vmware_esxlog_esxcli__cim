          },
          {
            "name": "session_id",
            "value": "String(opid || '')"
          },
          {
            "name": "action",
            "value": "action ? action : ((result || '').toLowerCase() == 'success' ? 'allowed' : ((result || '').toLowerCase() == 'failed' ? 'blocked' : 'unknown'))"
          },
          {
            "name": "vendor_action",
            "value": "result || action || ''"
          },
          {
            "name": "protocol",
            "value": "(protocol || '').toLowerCase()"
          },
          {
            "name": "transport",
            "value": "(protocol || '').toLowerCase()"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-21)",
      "conf": {
        "add": [
          {
            "name": "app",
            "value": "(message || '').indexOf('esxcli') >= 0 ? 'esxcli' : 'esxi'"
          },
          {
            "name": "rule",
            "value": "message || ''"
          },
          {
            "name": "direction",
            "value": "src_ip == '127.0.0.1' ? 'internal' : (C.Net.isPrivate(src_ip || '0.0.0.0') ? 'internal' : 'inbound')"
          },
          {
            "name": "src_zone",
            "value": "src_ip == '127.0.0.1' ? 'local' : (C.Net.isPrivate(src_ip || '0.0.0.0') ? 'internal' : 'external')"
          },
          {
            "name": "dvc_zone",
            "value": "host && host.split('.').length > 1 ? host.split('.')[1] : ''"
          },
          {
            "name": "vendor_product",
            "value": "'VMware ESXi'"
          }
        ]
      }
    },
