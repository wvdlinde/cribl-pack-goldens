          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'CommonSecurityLog'"
          },
          {
            "name": "category_uid",
            "value": "'Security'"
          },
          {
            "name": "event_type",
            "value": "'jira_security_event'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp || _time"
          },
          {
            "name": "DeviceVendor",
            "value": "'Atlassian'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Jira'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "event_name || auth_result || action || 'jira_security_event'"
          },
          {
            "name": "Activity",
            "value": "auth_result == 'success' ? 'Login Success' : auth_result == 'failure' ? 'Login Failure' : (event_name ? event_name.replace(/_/g,' ') : 'Security Event')"
          },
          {
            "name": "SourceIP",
            "value": "src_ip"
          },
          {
            "name": "DeviceAction",
            "value": "action || auth_result || ''"
          },
          {
            "name": "SourceUserName",
            "value": "user"
          },
          {
            "name": "DeviceName",
            "value": "dst_host"
          },
          {
            "name": "LogSeverity",
            "value": "level=='ERROR'?8:level=='WARN'?5:level=='INFO'?2:Number(severity||0)"
          },
          {
            "name": "RequestURL",
            "value": "url || ''"
          },
          {
            "name": "ApplicationProtocol",
            "value": "method ? 'HTTP' : ''"
          }
        ]
      }
    },
    {
