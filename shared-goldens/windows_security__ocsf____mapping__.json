            "value": "ip_address"
          },
          {
            "name": "unmapped.impersonation_level",
            "value": "impersonation_level"
          },
          {
            "name": "unmapped.computer",
            "value": "computer"
          },
          {
            "name": "unmapped.target_user_name",
            "value": "target_user_name"
          },
          {
            "name": "unmapped.target_domain_name",
            "value": "target_domain_name"
          },
          {
            "name": "unmapped.process_name",
            "value": "process_name"
          }
        ]
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract Windows Security XML authentication fields used for OCSF mapping.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/<EventID>(?<event_id>[^<]+)<\\/EventID>/gm",
        "regexList": [
          {
            "regex": "/<TimeCreated\\s+SystemTime='(?<event_time>[^']+)'/gm"
          },
          {
            "regex": "/<Execution\\s+ProcessID='(?<execution_pid>\\d+)'/gm"
          },
          {
            "regex": "/<Data\\s+Name='SubjectUserSid'>(?<subject_user_sid>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='SubjectUserName'>(?<subject_user_name>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='TargetUserSid'>(?<target_user_sid>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='TargetUserName'>(?<target_user_name>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='TargetLogonId'>(?<target_logon_id>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='LogonType'>(?<logon_type_id>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='AuthenticationPackageName'>(?<auth_package>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='ProcessId'>(?<process_id>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='ProcessName'>(?<process_path>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='IpAddress'>(?<ip_address>[^<]*)<\\/Data>/gm"
          },
          {
            "regex": "/<Data\\s+Name='LogonGuid'>(?<logon_guid>[^<]*)<\\/Data>/gm"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Create OCSF authentication target schema fields from extracted Windows event values.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "time",
            "value": "event_time ? Date.parse(event_time)/1000 : _time"
          },
          {
            "name": "activity_id",
            "value": "event_id==='4624'?1:(event_id==='4634'||event_id==='4647'?2:(event_id==='4768'?3:(event_id==='4769'?4:(event_id==='4770'?5:(event_id==='4771'?6:0)))))"
          },
          {
            "name": "status_id",
            "value": "event_id==='4624'||event_id==='4634'||event_id==='4647'||event_id==='4768'||event_id==='4769'||event_id==='4770'?1:(event_id==='4771'?2:0)"
          },
          {
            "name": "status",
            "value": "status_id===1?'Success':(status_id===2?'Failure':'Unknown')"
          },
          {
            "name": "logon_type",
            "value": "logon_type_id==='2'?'Interactive':(logon_type_id==='3'?'Network':(logon_type_id==='4'?'Batch':(logon_type_id==='5'?'Service':(logon_type_id==='7'?'Unlock':(logon_type_id==='8'?'NetworkCleartext':(logon_type_id==='9'?'NewCredentials':(logon_type_id==='10'?'RemoteInteractive':(logon_type_id==='11'?'CachedInteractive':'Other'))))))))"
          },
          {
            "name": "is_mfa",
            "value": "false"
          },
          {
            "name": "session",
            "value": "{}"
          },
          {
            "name": "session.created_time",
            "value": "event_id==='4624' && event_time ? Date.parse(event_time)/1000 : null"
          },
          {
            "name": "session.is_remote",
            "value": "ip_address && ip_address !== '-' ? true : (logon_type_id==='3'||logon_type_id==='10'?true:false)"
          },
          {
            "name": "session.issuer",
            "value": "auth_package"
          },
          {
            "name": "session.uid",
            "value": "target_logon_id"
          },
          {
            "name": "actor",
            "value": "{}"
          },
          {
            "name": "actor.user",
            "value": "{}"
          },
          {
            "name": "actor.user.name",
            "value": "subject_user_name && subject_user_name !== '-' ? subject_user_name : target_user_name"
          },
          {
            "name": "actor.user.uid",
            "value": "subject_user_sid && subject_user_sid !== '-' ? subject_user_sid : target_user_sid"
          },
          {
            "name": "actor.user.type_id",
            "value": "actor.user.name==='SYSTEM'||actor.user.name==='LOCAL SERVICE'||actor.user.name==='NETWORK SERVICE'||(actor.user.name && actor.user.name.endsWith('$'))?3:(actor.user.name==='Administrator'?2:(actor.user.name?1:0))"
          },
          {
            "name": "actor.user.has_mfa",
            "value": "false"
          },
          {
            "name": "actor.process",
            "value": "{}"
          },
          {
            "name": "actor.process.pid",
            "value": "execution_pid ? execution_pid * 1 : null"
          },
          {
            "name": "actor.process.uid",
            "value": "process_id ? process_id : logon_guid"
          },
          {
            "name": "actor.process.name",
            "value": "process_path ? process_path.split('\\\\').pop() : null"
          },
          {
            "name": "actor.process.file",
            "value": "{}"
          },
          {
            "name": "actor.process.file.path",
            "value": "process_path"
          },
          {
            "name": "actor.process.file.name",
            "value": "process_path ? process_path.split('\\\\').pop() : null"
          },
          {
            "name": "actor.process.file.ext",
            "value": "process_path && process_path.indexOf('.') >= 0 ? process_path.split('.').pop() : null"
          },
          {
            "name": "actor.process.file.type_id",
            "value": "process_path && process_path.toLowerCase().endsWith('.exe') ? 8 : (process_path ? 1 : 0)"
          },
          {
            "name": "user",
            "value": "{}"
          },
          {
            "name": "user.name",
            "value": "target_user_name"
          },
          {
            "name": "user.uid",
            "value": "target_user_sid"
          },
          {
            "name": "user.type_id",
            "value": "target_user_name==='SYSTEM'||target_user_name==='LOCAL SERVICE'||target_user_name==='NETWORK SERVICE'||(target_user_name && target_user_name.endsWith('$'))?3:(target_user_name==='Administrator'?2:(target_user_name?1:0))"
          },
          {
            "name": "user.has_mfa",
            "value": "false"
          }
        ]
      }
    },
