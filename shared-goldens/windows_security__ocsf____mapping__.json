    {
      "id": "regex_extract",
      "description": "Extract Windows Security XML fields needed for OCSF authentication mapping.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/<EventID>(?<event_id>[^<]+)<\\/EventID>/gm",
        "regexList": [
          {
            "regex": "/<Data Name='LogonType'>(?<logon_type>[^<]+)<\\/Data>/gm"
          },
          {
            "regex": "/<Data Name='IpAddress'>(?<ip_address>[^<]+)<\\/Data>/gm"
          },
          {
            "regex": "/<Data Name='ImpersonationLevel'>(?<impersonation_level>[^<]+)<\\/Data>/gm"
          },
          {
            "regex": "/<Computer>(?<computer>[^<]+)<\\/Computer>/gm"
          },
          {
            "regex": "/<Data Name='TargetUserName'>(?<target_user_name>[^<]+)<\\/Data>/gm"
          },
          {
            "regex": "/<Data Name='TargetDomainName'>(?<target_domain_name>[^<]+)<\\/Data>/gm"
          },
          {
            "regex": "/<Data Name='ProcessName'>(?<process_name>[^<]+)<\\/Data>/gm"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set target OCSF authentication fields from extracted Windows Security fields.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "category_uid",
            "value": "3"
          },
          {
            "name": "message",
            "value": "event_id==='4624' ? 'Windows successful logon event' : event_id==='4634' ? 'Windows account logoff event' : 'Windows authentication event'"
          },
          {
            "name": "status_code",
            "value": "event_id"
          },
          {
            "name": "status_detail",
            "value": "event_id==='4624' ? 'Success' : event_id==='4634' ? 'LOGOFF_USER_INITIATED' : 'Unknown'"
          },
          {
            "name": "is_remote",
            "value": "(logon_type==='3' || logon_type==='10' || (ip_address && ip_address !== '-')) ? true : false"
          },
          {
            "name": "account_switch_type_id",
            "value": "impersonation_level && impersonation_level !== '-' ? 2 : 0"
          },
          {
            "name": "unmapped",
            "value": "{}"
          },
          {
            "name": "unmapped.event_id",
            "value": "event_id"
          },
          {
            "name": "unmapped.logon_type",
            "value": "logon_type"
          },
