{
  "key": "ivanti_linux_audit::ocsf",
  "sourcetype": "ivanti_linux_audit",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:01:57.433Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<syslog_pri>\\d+)>(?<syslog_time>\\w+\\s+\\d+\\s+\\d+:\\d+:\\d+)\\s+(?<host>\\S+)\\s+audit\\[(?<pid>\\d+)\\]:\\s+id=(?<id>\\S+)\\s+sn=(?<sn>\\d+)\\s+time=\"(?<event_time>[^\"]+)\"\\s+fw=(?<fw>\\S+)\\s+pri=(?<severity_num>\\d+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract syslog envelope and core audit header fields (priority, timestamp, host, pid, id, sn, event time, firewall name, syslog severity level)"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/(?:vpn=(?<vpn>\\S+)\\s+)?(?:realm=\"(?<realm>[^\"]*)\"\\s+)?(?:roles=\"(?<roles>[^\"]*)\"\\s+)?msg=\"(?<msg_code>[^\"]+)\"\\s+(?:user=\"(?<user>[^\"]+)\"\\s+)?(?:src=(?<src_ip>[0-9a-fA-F:.]+)\\s+)?(?:dst=(?<dst_ip>[0-9a-fA-F:.]+)\\s+)?(?:dstport=(?<dst_port>\\d+)\\s+)?(?:proto=(?<protocol>\\w+)\\s+)?(?:auth_server=\"(?<auth_server>[^\"]+)\"\\s+)?details=\"(?<message>[^\"]+)\"/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract optional VPN/network/auth fields, message code, and human-readable details message that may or may not be present depending on event type"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "timestamp",
            "value": "event_time"
          },
          {
            "name": "severity",
            "value": "severity_num=='0'?'emergency':severity_num=='1'?'alert':severity_num=='2'?'critical':severity_num=='3'?'error':severity_num=='4'?'warning':severity_num=='5'?'notice':severity_num=='6'?'info':severity_num=='7'?'debug':'unknown'"
          },
          {
            "name": "action",
            "value": "message && message.startsWith('Login succeeded') ? 'login_success' : message && message.startsWith('Login failed') ? 'login_failure' : message && message.startsWith('Account locked') ? 'account_locked' : message && message.startsWith('Access denied') ? 'access_denied' : message && message.startsWith('Access granted') ? 'access_granted' : message && message.startsWith('Session ended') ? 'session_end' : message && message.startsWith('Suspicious login') ? 'suspicious_login' : message && message.startsWith('Admin') ? 'admin_change' : message && message.startsWith('Configuration') ? 'config_change' : message && message.startsWith('Scheduled') ? 'system_task' : message && message.startsWith('Certificate') ? 'cert_warning' : 'other'"
          },
          {
            "name": "direction",
            "value": "src_ip ? (src_ip.match(/^(10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[0-1])\\.)/) ? 'internal' : 'external') : undefined"
          }
        ],
        "remove": [
          "event_time",
          "severity_num",
          "syslog_time",
          "fw"
        ]
      },
      "description": "Normalize timestamp, map syslog severity level to text, classify action based on message/msg_code content, and derive network direction from src_ip"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          },
          {
            "name": "device.hostname",
            "value": "host || ''"
          },
          {
            "name": "time",
            "value": "_time ? Number(_time) : Math.floor(Date.parse(timestamp)/1000)"
          },
          {
            "name": "severity_id",
            "value": "severity ? Number(severity) : (syslog_pri ? (8 - Number(syslog_pri)) : 1)"
          },
          {
            "name": "activity_id",
            "value": "action && action.toLowerCase().indexOf('fail') !== -1 ? 2 : (action && action.toLowerCase().indexOf('deny') !== -1 ? 2 : 1)"
          },
          {
            "name": "metadata.product.name",
            "value": "'Ivanti Connect Secure'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Ivanti'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_linux_audit'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}