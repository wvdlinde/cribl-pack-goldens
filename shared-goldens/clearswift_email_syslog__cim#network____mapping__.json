          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'Network_Traffic.All_Traffic'"
          },
          {
            "name": "category_uid",
            "value": "'Network_Traffic'"
          },
          {
            "name": "event_type",
            "value": "'network_traffic'"
          },
          {
            "name": "src_ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src",
            "value": "src_ip || ''"
          },
          {
            "name": "dest_ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dest",
            "value": "dst_ip || ''"
          },
          {
            "name": "dest_port",
            "value": "dst_port ? Number(dst_port) : null"
          },
          {
            "name": "app",
            "value": "(protocol || 'smtp').toLowerCase()"
          },
          {
            "name": "transport",
            "value": "(protocol || '').toUpperCase() == 'SMTP' ? 'tcp' : (protocol ? String(protocol).toLowerCase() : 'tcp')"
          },
          {
            "name": "protocol",
            "value": "protocol ? String(protocol).toLowerCase() : ''"
          },
          {
            "name": "action",
            "value": "action_norm || (result == 'Success' ? 'allowed' : (result == 'Blocked' || result == 'Rejected' || result == 'Failure' ? 'blocked' : ''))"
          },
          {
            "name": "vendor_action",
            "value": "action || event || result || ''"
          },
          {
            "name": "bytes",
            "value": "size ? Number(size) : null"
          },
          {
            "name": "bytes_out",
            "value": "size && direction == 'outbound' ? Number(size) : null"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-28)",
      "conf": {
        "add": [
          {
            "name": "bytes_in",
            "value": "size && direction == 'inbound' ? Number(size) : null"
          },
          {
            "name": "user",
            "value": "user || dst_user || ''"
          },
          {
            "name": "vendor_account",
            "value": "dst_user || user || ''"
          },
          {
            "name": "dvc",
            "value": "host || ''"
          },
          {
            "name": "process_id",
            "value": "pid ? Number(pid) : null"
          },
          {
            "name": "rule",
            "value": "policy || route || ''"
          },
          {
            "name": "rule_id",
            "value": "policy || ''"
          },
          {
            "name": "session_id",
            "value": "message_id || ''"
          },
          {
            "name": "flow_id",
            "value": "message_id || ''"
          },
          {
            "name": "direction",
            "value": "direction ? String(direction).toLowerCase() : ''"
          },
          {
            "name": "protocol_version",
            "value": "tls && String(tls).toLowerCase() == 'yes' ? 'tls' : ''"
          },
          {
            "name": "packets",
            "value": "attempts ? Number(attempts) : null"
          },
          {
            "name": "vendor_product",
            "value": "'Clearswift Secure Email Gateway'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'clearswift_email_syslog'"
          }
        ]
      }
    }
  ],
