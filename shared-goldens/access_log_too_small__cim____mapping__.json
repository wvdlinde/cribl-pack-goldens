  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "clientip || src_ip || ''"
          },
          {
            "name": "user",
            "value": "auth || ident || ''"
          },
          {
            "name": "action",
            "value": "Number(response) >= 400 ? 'blocked' : 'allowed'"
          },
          {
            "name": "bytes_out",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "bytes",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "url",
            "value": "request || ''"
          },
          {
            "name": "vendor_action",
            "value": "verb || ''"
          },
          {
            "name": "severity",
            "value": "Number(response) >= 500 ? 'high' : (Number(response) >= 400 ? 'medium' : 'informational')"
          },
          {
            "name": "severity_id",
            "value": "Number(response) >= 500 ? 4 : (Number(response) >= 400 ? 3 : 1)"
          },
          {
            "name": "transport",
            "value": "'tcp'"
          },
          {
            "name": "protocol",
            "value": "'HTTP/' + (httpversion || '')"
          },
          {
            "name": "object",
            "value": "agent || ''"
          },
          {
            "name": "subject",
            "value": "referrer || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'access_log_too_small'"
          }
        ]
      }
    }
