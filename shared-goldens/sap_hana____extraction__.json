{
  "key": "sap_hana::__extraction__",
  "sourcetype": "sap_hana",
  "dest_format": "__extraction__",
  "score": 92,
  "part": "extraction",
  "author": "unknown",
  "build": 427,
  "updated_at": "2026-08-11T15:42:31.540Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse base syslog envelope: timestamp, host, process, pid, message",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\w+\\s+\\d+\\s+\\d+:\\d+:\\d+)\\s+(?<host>\\S+)\\s+(?<process>[^\\[]+)\\[(?<pid>\\d+)\\]:\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/^(Accepted publickey for|Failed password for)/)",
      "disabled": false,
      "description": "Parse SSH login success/failure events for user, src_ip, src_port",
      "conf": {
        "source": "message",
        "regex": "/^(?:Accepted publickey for|Failed password for(?: invalid user)?)\\s+(?<user>\\S+)\\s+from\\s+(?<src_ip>\\S+)\\s+port\\s+(?<src_port>\\d+)\\s+ssh2$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/COMMAND=/)",
      "disabled": false,
      "description": "Parse sudo TTY/PWD/COMMAND execution lines",
      "conf": {
        "source": "message",
        "regex": "/^(?<user>\\S+)\\s+:\\s+TTY=(?<tty>\\S+)\\s+;\\s+PWD=(?<pwd>\\S+)\\s+;\\s+COMMAND=(?<command>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.startsWith('UFW BLOCK')",
      "disabled": false,
      "description": "Parse UFW firewall block events for interfaces, IPs, protocol, ports",
      "conf": {
        "source": "message",
        "regex": "/^UFW BLOCK IN=(?<in_iface>\\S*) OUT=(?<out_iface>\\S*) SRC=(?<src_ip>\\S+) DST=(?<dst_ip>\\S+) PROTO=(?<protocol>\\S+) SPT=(?<src_port>\\d+) DPT=(?<dst_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/^\\(.*\\)\\s+CMD\\s+\\(/)",
      "disabled": false,
      "description": "Parse cron-style (user) CMD (command) events",
      "conf": {
        "source": "message",
        "regex": "/^\\((?<user>\\S+)\\)\\s+CMD\\s+\\((?<command>.*)\\)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/session opened for user|Started Session/)",
      "disabled": false,
      "description": "Parse session opened/started events for user",
      "conf": {
        "source": "message",
        "regex": "/(?:session opened for user|Started Session\\s+\\d+\\s+of user)\\s+(?<user>\\S+)\\.?$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Classify action/severity, normalize protocol casing, derive direction for network events",
      "conf": {
        "add": [
          {
            "name": "severity",
            "value": "action == 'login_failure' || action == 'blocked' ? 'high' : action == 'login_success' || action == 'session_start' ? 'info' : 'low'"
          },
          {
            "name": "protocol",
            "value": "typeof protocol !== 'undefined' && protocol ? protocol.toLowerCase() : protocol"
          },
          {
            "name": "direction",
            "value": "action == 'blocked' ? 'inbound' : undefined"
          }
        ],
        "remove": []
      }
    }
  ],
  "recipe": null,
  "report": null
}