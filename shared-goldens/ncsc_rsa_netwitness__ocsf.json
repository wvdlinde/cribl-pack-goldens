{
  "key": "ncsc_rsa_netwitness::ocsf",
  "sourcetype": "ncsc_rsa_netwitness",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:57:10.197Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<priority>\\d+)>(?<syslog_timestamp>[A-Za-z]{3}\\s+\\d{1,2}\\s+\\d{4}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+NetWitness\\[(?<process>\\w+)\\]:\\s+(?<__kvp_body>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse syslog header (priority, timestamp, host, process) and isolate the NetWitness KVP body into a scratch field"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp_body",
        "cleanFields": true
      },
      "description": "Extract the NetWitness key=value pairs (sessionid, time, ip.src/dst, tcp/udp ports, action, result, severity, etc.) from the scratch KVP body field"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "timestamp",
            "value": "typeof time !== 'undefined' ? time : syslog_timestamp"
          },
          {
            "name": "src_ip",
            "value": "typeof ip !== 'undefined' ? ip.src : undefined"
          },
          {
            "name": "dst_ip",
            "value": "typeof ip !== 'undefined' && ip.dst ? ip.dst : undefined"
          },
          {
            "name": "src_port",
            "value": "typeof tcp !== 'undefined' && tcp.srcport ? tcp.srcport : (typeof udp !== 'undefined' && udp.srcport ? udp.srcport : undefined)"
          },
          {
            "name": "dst_port",
            "value": "typeof tcp !== 'undefined' && tcp.dstport ? tcp.dstport : (typeof udp !== 'undefined' && udp.dstport ? udp.dstport : undefined)"
          },
          {
            "name": "protocol",
            "value": "typeof protocol !== 'undefined' ? protocol : undefined"
          },
          {
            "name": "vendor_action",
            "value": "action || undefined"
          },
          {
            "name": "action",
            "value": "typeof action !== 'undefined' ? action : undefined"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "typeof severity !== 'undefined' ? severity : 'info'"
          },
          {
            "name": "user",
            "value": "typeof user !== 'undefined' ? (user.src ? user.src : user.dst) : undefined"
          },
          {
            "name": "dst_host",
            "value": "typeof alias !== 'undefined' ? alias.host : undefined"
          },
          {
            "name": "direction",
            "value": "typeof direction !== 'undefined' ? direction : undefined"
          }
        ],
        "remove": [
          "__kvp_body"
        ]
      },
      "description": "Normalize extracted NetWitness fields into consistent names: src_ip, dst_ip, src_port, dst_port, protocol, action, severity, user, timestamp, dst_host"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'6004'"
          },
          {
            "name": "category_uid",
            "value": "'6'"
          },
          {
            "name": "event_type",
            "value": "'web_proxy'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "ip_src"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "ip_dst"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(tcp_srcport || udp_srcport || 0)"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(tcp_dstport || udp_dstport || 0)"
          },
          {
            "name": "actor.user.name",
            "value": "user_src || user_dst || ''"
          },
          {
            "name": "http_request.url",
            "value": "query"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(payload_bytes || 0)"
          },
          {
            "name": "time",
            "value": "Date.parse(time || timestamp || _time) / 1000"
          },
          {
            "name": "activity_id",
            "value": "action == 'allow' ? 1 : (action == 'deny' ? 2 : 0)"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : (severity == 'high' ? 4 : (severity == 'medium' ? 3 : (severity == 'low' ? 2 : 1)))"
          },
          {
            "name": "category_name",
            "value": "result"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.product.name",
            "value": "'NetWitness'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'RSA'"
          },
          {
            "name": "metadata.version",
            "value": "'1.0.0'"
          },
          {
            "name": "actor.user.name",
            "value": "user_dst || user_src || ''"
          }
        ]
      },
      "description": "Map fields (continued 16-19)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ncsc:rsa:netwitness'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
