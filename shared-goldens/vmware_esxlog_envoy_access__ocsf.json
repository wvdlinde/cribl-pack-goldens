{
  "key": "vmware_esxlog_envoy_access::ocsf",
  "sourcetype": "vmware_esxlog_envoy_access",
  "dest_format": "ocsf",
  "score": 90,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:56:11.328Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<priority>\\d+)>(?<timestamp>[^ ]+) (?<host>[^ ]+) Envoy: \\[(?<log_timestamp>[^\\]]+)\\] \"(?<http_method>[^ ]+) (?<http_path>[^ ]+) (?<http_version>[^\"]+)\" (?<http_status>\\d+) (?<response_flags>[^ ]+) (?<bytes_received>\\d+) (?<bytes_sent>\\d+) (?<duration_ms>[^ ]+) (?<upstream_time_ms>[^ ]+) \"(?<forwarded_for>[^\"]*)\" \"(?<user_agent>[^\"]*)\" \"(?<request_id>[^\"]*)\" \"(?<dst_host>[^\"]*)\" \"(?<__upstream_addr>[^\"]*)\" (?<__src_addr>.+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse Envoy access log syslog wrapper and HTTP request/response fields"
    },
    {
      "id": "regex_extract",
      "filter": "__src_addr && __src_addr.startsWith('[')",
      "disabled": false,
      "conf": {
        "source": "__src_addr",
        "regex": "/^\\[(?<src_ip>[^\\]]+)\\]:(?<src_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract IPv6 client src_ip/src_port from bracketed address"
    },
    {
      "id": "regex_extract",
      "filter": "__src_addr && !__src_addr.startsWith('[')",
      "disabled": false,
      "conf": {
        "source": "__src_addr",
        "regex": "/^(?<src_ip>[^:]+):(?<src_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract IPv4 client src_ip/src_port"
    },
    {
      "id": "regex_extract",
      "filter": "__upstream_addr && __upstream_addr !== '-'",
      "disabled": false,
      "conf": {
        "source": "__upstream_addr",
        "regex": "/^(?<dst_ip>[^:]+):(?<dst_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract upstream/backend dst_ip and dst_port"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "protocol",
            "value": "'http'"
          },
          {
            "name": "action",
            "value": "http_status && parseInt(http_status) < 400 ? 'allowed' : 'blocked'"
          },
          {
            "name": "severity",
            "value": "http_status && parseInt(http_status) >= 500 ? 'high' : (http_status && parseInt(http_status) >= 400 ? 'medium' : 'low')"
          },
          {
            "name": "message",
            "value": "http_method + ' ' + http_path + ' -> ' + http_status"
          }
        ],
        "remove": [
          "__src_addr",
          "__upstream_addr"
        ]
      },
      "description": "Normalize protocol, action, severity, and build message; remove scratch fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4002'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'HTTP Activity'"
          },
          {
            "name": "time",
            "value": "Math.round((_time || Date.now()/1000) * 1000)"
          },
          {
            "name": "activity_id",
            "value": "(http_method || '').toUpperCase() == 'GET' ? 3 : ((http_method || '').toUpperCase() == 'POST' ? 6 : ((http_method || '').toUpperCase() == 'PUT' ? 4 : ((http_method || '').toUpperCase() == 'DELETE' ? 2 : ((http_method || '').toUpperCase() == 'HEAD' ? 5 : ((http_method || '').toUpperCase() == 'CONNECT' ? 1 : ((http_method || '').toUpperCase() == 'OPTIONS' ? 7 : ((http_method || '').toUpperCase() == 'TRACE' ? 8 : ((http_method || '').toUpperCase() == 'PATCH' ? 9 : 0))))))))"
          },
          {
            "name": "type_uid",
            "value": "400200 + ((http_method || '').toUpperCase() == 'GET' ? 3 : ((http_method || '').toUpperCase() == 'POST' ? 6 : ((http_method || '').toUpperCase() == 'PUT' ? 4 : ((http_method || '').toUpperCase() == 'DELETE' ? 2 : ((http_method || '').toUpperCase() == 'HEAD' ? 5 : ((http_method || '').toUpperCase() == 'CONNECT' ? 1 : ((http_method || '').toUpperCase() == 'OPTIONS' ? 7 : ((http_method || '').toUpperCase() == 'TRACE' ? 8 : ((http_method || '').toUpperCase() == 'PATCH' ? 9 : 0)))))))))"
          },
          {
            "name": "severity_id",
            "value": "Number(http_status || 0) >= 500 ? 4 : (Number(http_status || 0) >= 400 ? 3 : 1)"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || forwarded_for || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "http_request.url",
            "value": "http_path || ''"
          },
          {
            "name": "http_request.http_method",
            "value": "(http_method || '').toUpperCase()"
          },
          {
            "name": "http_request.user_agent",
            "value": "user_agent == '-' ? '' : (user_agent || '')"
          },
          {
            "name": "http_response.code",
            "value": "Number(http_status || 0)"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "traffic.bytes_in",
            "value": "Number(bytes_received || 0)"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(bytes_sent || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(http_version || '').toLowerCase().indexOf('https') > -1 ? 'https' : 'http'"
          },
          {
            "name": "actor.user.name",
            "value": "''"
          },
          {
            "name": "category_name",
            "value": "'Network Activity'"
          },
          {
            "name": "metadata.product.name",
            "value": "'VMware ESXi Envoy'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'VMware'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          },
          {
            "name": "class_uid",
            "value": "4002"
          },
          {
            "name": "category_uid",
            "value": "4"
          }
        ]
      },
      "description": "Map fields (continued 16-25)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware:esxlog:envoy-access'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
