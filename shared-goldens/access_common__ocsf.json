      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<src_ip>\\S+)\\s+(?<__ident>\\S+)\\s+(?<user>\\S+)\\s+\\[(?<__ts>[^\\]]+)\\]\\s+\"(?<http_method>[A-Z]+)\\s+(?<uri>\\S+)\\s+(?<http_version>[^\"]*)\"\\s+(?<status>\\d{3})\\s+(?<bytes_out>\\d+|-)\\s+\"(?<http_referrer>[^\"]*)\"\\s+\"(?<http_user_agent>[^\"]*)\"\\s+(?<duration>\\d+)\\s+(?<dst_host>\\S+)/"
      },
      "description": "Parse extended NCSA common access log line (IPv4/IPv6 client, ident, user, ts, request, status, bytes, referrer, UA, duration, server host)"
    },
    {
      "id": "regex_extract",
      "filter": "uri",
      "disabled": false,
      "conf": {
        "source": "uri",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<uri_path>[^?]*)(?:\\?(?<uri_query>.*))?$/"
      },
      "description": "Split URI into path and query string"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "__ts ? C.Time.strptime(__ts, '%d/%b/%Y:%H:%M:%S %z').getTime()/1000 : _time"
          },
          {
            "name": "timestamp",
            "value": "__ts"
          },
          {
            "name": "user",
            "value": "user == '-' ? undefined : user"
          },
          {
            "name": "http_referrer",
            "value": "http_referrer == '-' ? undefined : http_referrer"
          },
          {
            "name": "status",
            "value": "Number(status)"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out == '-' ? 0 : Number(bytes_out)"
          },
          {
            "name": "duration_ms",
            "value": "Number(duration)"
          },
          {
            "name": "protocol",
            "value": "'tcp'"
          },
          {
            "name": "app_protocol",
            "value": "String(http_version).match(/^HTTPS/i) ? 'https' : 'http'"
          },
          {
            "name": "ip_version",
            "value": "String(src_ip).indexOf(':') > -1 ? 'ipv6' : 'ipv4'"
          },
          {
            "name": "action",
            "value": "Number(status) < 400 ? 'allowed' : 'blocked'"
          },
          {
            "name": "severity",
            "value": "Number(status) >= 500 ? 'high' : (Number(status) >= 400 ? 'medium' : 'low')"
          },
          {
            "name": "direction",
            "value": "String(src_ip).match(/^(10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|127\\.|fd|fe80)/i) ? 'internal' : 'inbound'"
          },
          {
            "name": "message",
            "value": "http_method + ' ' + uri + ' ' + status"
          }
        ],
        "remove": [
          "__ts",
          "__ident",
          "duration"
        ]
      },
      "description": "Normalize timestamp, numerics, user, protocol, action, severity and direction"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "String(uri_path).match(/login/i) ? 'authentication' : (String(uri_path).match(/^\\/(healthz|metrics)$/) ? 'health_check' : 'web_request')"
          },
          {
            "name": "auth_result",
            "value": "String(uri_path).match(/login/i) ? (Number(status) < 400 ? 'success' : 'failure') : undefined"
          },
          {
            "name": "is_suspicious",
            "value": "String(uri).match(/(\\.env|wp-login|\\.\\.\\/|etc\\/passwd)/i) || String(http_user_agent).match(/(sqlmap|nmap|nikto|python-requests|curl)/i) ? true : false"
          },
          {
            "name": "tool_signature",
            "value": "String(http_user_agent).match(/sqlmap/i) ? 'sqlmap' : (String(http_user_agent).match(/Nmap/i) ? 'nmap' : (String(http_user_agent).match(/python-requests/i) ? 'python-requests' : (String(http_user_agent).match(/curl/i) ? 'curl' : undefined)))"
          }
        ]
      },
