          },
          {
            "name": "dest_zone",
            "value": "dst_host && String(dst_host).indexOf('-') > -1 ? String(dst_host).split('.')[0].split('-')[1] : ''"
          },
          {
            "name": "action",
            "value": "action == 'denied' || action == 'deny' || action == 'blocked' || action == 'failure' || action == 'failed' ? 'blocked' : (action == 'success' || action == 'allowed' || action == 'completed' ? 'allowed' : (action || 'unknown'))"
          },
          {
            "name": "vendor_action",
            "value": "action || ''"
          },
          {
            "name": "user",
            "value": "user || ''"
          },
          {
            "name": "vendor_account",
            "value": "user && String(user).indexOf('@') > -1 ? String(user).split('@')[1] : ''"
          },
          {
            "name": "app",
            "value": "component || process || 'BackupCheck'"
          },
          {
            "name": "process_id",
            "value": "Number(pid || 0)"
          },
          {
            "name": "duration",
            "value": "Number(duration || 0)"
          }
        ]
