{
  "key": "pan_system_csv::ocsf",
  "sourcetype": "pan_system_csv",
  "dest_format": "ocsf",
  "score": 95,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:57:26.716Z",
  "functions": [
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "csv",
        "srcField": "_raw",
        "fields": [
          "future_use1",
          "receive_time",
          "serial",
          "log_type",
          "subtype",
          "future_use2",
          "generate_time",
          "vsys",
          "eventid",
          "object",
          "future_use3",
          "future_use4",
          "module",
          "severity",
          "message",
          "seqno",
          "actionflags",
          "future_use5",
          "future_use6",
          "future_use7",
          "future_use8",
          "vsys_name",
          "device_name",
          "future_use9",
          "future_use10",
          "timestamp"
        ],
        "cleanFields": true
      },
      "description": "Parse PAN-OS SYSTEM log CSV fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "new Date(timestamp.replace(/\\//g,'-')).getTime()/1000"
          }
        ]
      },
      "description": "Derive _time from the millisecond-precision timestamp field"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('logged in via WebUI') !== -1",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/User (?<user>\\S+) logged in via WebUI from (?<src_ip>[\\d.]+) using (?<protocol>\\S+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract user, src_ip, protocol from successful WebUI login messages"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('Failed login attempt') !== -1",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/Failed login attempt for user (?<user>\\S+) from (?<src_ip>[\\d.]+) using (?<protocol>\\S+): (?<reason>.+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract user, src_ip, protocol, and reason from failed login attempt messages"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('Repeated authentication failures') !== -1",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/Repeated authentication failures detected for user (?<user>\\S+) from (?<src_ip>[\\d.]+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract user and src_ip from repeated authentication failure messages"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message.indexOf('Failed')!==-1 || message.indexOf('failures')!==-1 || message.indexOf('failed')!==-1 || message.indexOf('down')!==-1 || message.indexOf('exceeded')!==-1 ? 'failure' : (message.indexOf('succeeded')!==-1 || message.indexOf('successfully')!==-1 || message.indexOf('successful')!==-1) ? 'success' : 'info'"
          }
        ]
      },
      "description": "Classify action as success, failure, or info based on message content"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "time",
            "value": "timestamp ? new Date(timestamp.replace(/\\//g,'-')).getTime() : Number(_time) * 1000"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || ''"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          },
          {
            "name": "device.hostname",
            "value": "device_name || ''"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : severity == 'high' ? 4 : severity == 'medium' ? 3 : severity == 'low' ? 2 : severity == 'informational' ? 1 : 0"
          },
          {
            "name": "activity_id",
            "value": "action ? Number(action) : 0"
          },
          {
            "name": "metadata.product.name",
            "value": "'PAN-OS'"
          },
          {
            "name": "metadata.version",
            "value": "'1.0.0'"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'pan:system'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "_raw",
          "msg_body",
          "msg_format",
          "event_category",
          "event_action",
          "__*"
        ]
      },
      "description": "Keep mapped CIM fields + all extracted source fields before serialization"
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
