          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "'network'"
          },
          {
            "name": "TimeGenerated",
            "value": "time || _time || timestamp"
          },
          {
            "name": "DeviceEventClassID",
            "value": "event_type || ''"
          },
          {
            "name": "Activity",
            "value": "alert || action || 'network-event'"
          },
          {
            "name": "SourceIP",
            "value": "ip_src || ''"
          },
          {
            "name": "DestinationIP",
            "value": "ip_dst || ''"
          },
          {
            "name": "SourcePort",
            "value": "Number(tcp_srcport || udp_srcport || 0)"
          },
          {
            "name": "DestinationPort",
            "value": "Number(tcp_dstport || udp_dstport || 0)"
          },
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "DeviceAction",
            "value": "action || vendor_action || ''"
          },
          {
            "name": "SourceUserName",
            "value": "user_src || ''"
          },
          {
            "name": "DestinationUserName",
            "value": "user_dst || ''"
          },
          {
            "name": "SentBytes",
            "value": "Number(payload_bytes || 0)"
          },
          {
            "name": "ApplicationProtocol",
            "value": "String(service || '')"
          },
          {
            "name": "DeviceName",
            "value": "host || alias_host || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-19)",
      "conf": {
        "add": [
          {
            "name": "LogSeverity",
            "value": "severity == 'critical' ? '10' : severity == 'high' ? '8' : severity == 'medium' ? '5' : severity == 'low' ? '2' : (vendor_severity || '0')"
          },
          {
            "name": "RequestURL",
            "value": "query || ''"
          },
          {
            "name": "DeviceVendor",
            "value": "'RSA'"
          },
          {
            "name": "DeviceProduct",
            "value": "'NetWitness'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ncsc_rsa_netwitness'"
          }
        ]
      }
    }
  ],
