  "build": 379,
  "updated_at": "2026-08-07T15:17:28.988Z",
  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "src_ip"
          },
          {
            "name": "src_port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "dest",
            "value": "dst_ip"
          },
          {
            "name": "dest_port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "transport",
            "value": "(protocol || '').toLowerCase()"
          },
          {
            "name": "action",
            "value": "action == 'allow' ? 'allowed' : (action == 'deny' ? 'blocked' : action)"
          },
          {
            "name": "bytes_in",
            "value": "Number(bytes_in || 0)"
          },
          {
            "name": "bytes_out",
            "value": "Number(bytes_out || 0)"
          },
          {
            "name": "bytes",
            "value": "Number(bytes_in || 0) + Number(bytes_out || 0)"
          },
          {
            "name": "duration",
            "value": "Number(duration || 0)"
          },
          {
            "name": "src_zone",
            "value": "zone_src"
          },
          {
            "name": "dest_zone",
            "value": "zone_dst"
          },
          {
            "name": "user",
            "value": "user == '-' ? '' : user"
          },
          {
            "name": "app",
            "value": "app"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-20)",
      "conf": {
        "add": [
          {
            "name": "dvc",
            "value": "host"
          },
          {
            "name": "signature_id",
            "value": "threat_id || ''"
          },
          {
            "name": "signature",
            "value": "threat_name || ''"
          },
          {
            "name": "category",
            "value": "category || ''"
          },
          {
            "name": "severity",
            "value": "sev || severity || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'nci_splk_nci_splk_nu_network_data'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
