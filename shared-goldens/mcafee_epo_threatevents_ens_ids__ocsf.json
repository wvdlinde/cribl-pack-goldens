{
  "key": "mcafee_epo_threatevents_ens_ids::ocsf",
  "sourcetype": "mcafee_epo_threatevents_ens_ids",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:59:31.412Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^CEF:(?<cef_version>\\d+)\\|(?<vendor>[^|]*)\\|(?<product>[^|]*)\\|(?<product_version>[^|]*)\\|(?<signature_id>[^|]*)\\|(?<signature_name>[^|]*)\\|(?<cef_severity>[^|]*)\\|/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse CEF header (pipe-delimited) into vendor/product/signature fields"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/rt=(?<rt>\\w{3}\\s+\\d{1,2}\\s+\\d{4}\\s+\\d{2}:\\d{2}:\\d{2})\\s+src=(?<src_ip>\\S+)\\s+dst=(?<dst_ip>\\S+)\\s+spt=(?<src_port>\\d+)\\s+dpt=(?<dst_port>\\d+)\\s+proto=(?<proto_raw>\\S+)\\s+cat=(?<category>\\S+)\\s+act=(?<act_raw>\\S+)\\s+cs1=(?<threat_name>.*?)\\s+cs1Label=/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse CEF extension core network fields (space-delimited KVP with space-bearing cs1 value)"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/\\bdvchost=(?<dst_host>\\S+)/",
        "regexList": [
          {
            "regex": "/\\bduser=(?<user>[^\\s=]+)/"
          },
          {
            "regex": "/(?:^|\\s)dvc=(?<dvc_ip>\\S+)/"
          },
          {
            "regex": "/\\bcs2=(?<payload_note>\\S+)/"
          },
          {
            "regex": "/\\boutcome=(?<outcome>\\S+)/"
          }
        ],
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse remaining CEF extension fields (device host, user, device ip, extra payload note, outcome)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "rt ? strptime(rt, '%b %d %Y %H:%M:%S') / 1000 : _time"
          },
          {
            "name": "timestamp",
            "value": "rt"
          },
          {
            "name": "protocol",
            "value": "proto_raw ? proto_raw.toLowerCase() : undefined"
          },
          {
            "name": "action",
            "value": "act_raw ? (act_raw.toLowerCase() === 'blocked' ? 'blocked' : (act_raw.toLowerCase() === 'allowed' ? 'allowed' : act_raw.toLowerCase())) : undefined"
          },
          {
            "name": "severity_id",
            "value": "cef_severity ? Number(cef_severity) : undefined"
          },
          {
            "name": "severity",
            "value": "Number(cef_severity) >= 9 ? 'critical' : (Number(cef_severity) >= 7 ? 'high' : (Number(cef_severity) >= 4 ? 'medium' : 'low'))"
          },
          {
            "name": "ip_version",
            "value": "src_ip && src_ip.indexOf(':') > -1 ? 6 : 4"
          },
          {
            "name": "src_is_internal",
            "value": "src_ip ? (src_ip.match(/^(10\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|127\\.|fe80:|fc|fd)/i) ? true : false) : undefined"
          },
          {
            "name": "dst_is_internal",
            "value": "dst_ip ? (dst_ip.match(/^(10\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|127\\.|fe80:|fc|fd)/i) ? true : false) : undefined"
          },
          {
            "name": "direction",
            "value": "src_is_internal && dst_is_internal ? 'internal' : (src_is_internal ? 'outbound' : (dst_is_internal ? 'inbound' : 'external'))"
          },
          {
            "name": "event_type",
            "value": "category ? category.toLowerCase() : 'firewall.ids'"
          },
          {
            "name": "message",
            "value": "signature_name && threat_name ? signature_name + ': ' + threat_name : signature_name"
          },
          {
            "name": "user",
            "value": "user && user.length > 0 ? user : undefined"
          }
        ],
        "remove": [
          "rt",
          "proto_raw",
          "act_raw",
          "cef_severity"
        ]
      },
      "description": "Normalize timestamp, protocol, action, severity, direction and IP version"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "(action || '').toLowerCase() == 'blocked' ? 5 : ((action || '').toLowerCase() == 'allowed' ? 1 : 0)"
          },
          {
            "name": "type_uid",
            "value": "400100 + ((action || '').toLowerCase() == 'blocked' ? 5 : ((action || '').toLowerCase() == 'allowed' ? 1 : 0))"
          },
          {
            "name": "severity_id",
            "value": "Number(severity_id || severity || 0) >= 9 ? 5 : (Number(severity_id || severity || 0) >= 7 ? 4 : (Number(severity_id || severity || 0) >= 5 ? 3 : (Number(severity_id || severity || 0) >= 3 ? 2 : 1)))"
          },
          {
            "name": "time",
            "value": "timestamp ? Math.round(new Date(timestamp).getTime()) : Math.round(_time * 1000)"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toLowerCase()"
          },
          {
            "name": "actor.user.name",
            "value": "user || ''"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "device.hostname",
            "value": "dst_host || ''"
          },
          {
            "name": "metadata.product.name",
            "value": "product || 'ePolicy Orchestrator'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "vendor || 'McAfee'"
          },
          {
            "name": "metadata.version",
            "value": "String(product_version || cef_version || '')"
          }
        ]
      },
      "description": "Map fields (continued 16-19)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'McAfee:ePO:ThreatEvents:ENS:IDS'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}