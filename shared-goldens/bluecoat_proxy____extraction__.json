  "functions": [
    {
      "id": "regex_extract",
      "description": "Extract proxy HTTP access log fields from raw text.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<date>\\d{4}-\\d{2}-\\d{2})\\s+(?<event_time>\\d{2}:\\d{2}:\\d{2})\\s+(?<duration_ms>\\d+)\\s+(?<client_ip>\\S+)\\s+(?<user>\\S+)\\s+(?<group>\\S+)\\s+(?<auth_method>\\S+)\\s+(?<disposition>\\S+)\\s+\"(?<category>[^\"]*)\"\\s+(?<policy>\\S+)\\s+(?<http_status>\\d+)\\s+(?<cache_result>\\S+)\\s+(?<method>\\S+)\\s+(?<content_type>\\S+)\\s+(?<scheme>\\S+)\\s+(?<host>\\S+)\\s+(?<port>\\d+)\\s+(?<path>\\S+)\\s+(?<query>\\S+)\\s+(?<referrer>\\S+)\\s+\"(?<user_agent>[^\"]*)\"\\s+(?<proxy_ip>\\S+)\\s+(?<bytes_in>\\d+)\\s+(?<bytes_out>\\d+)\\s+(?<exception>\\S+)$/gm"
      }
    },
    {
      "id": "numerify",
      "description": "Convert extracted numeric fields used by the target mapping to numbers.",
      "filter": "true",
      "conf": {
        "depth": 5,
        "ignoreFields": [],
        "filterExpr": "name==='http_status' || name==='bytes_in' || name==='bytes_out' || name==='duration_ms' || name==='port'",
        "format": "none"
      }
    },
    {
      "id": "eval",
      "description": "Create OCSF HTTP Activity target schema fields.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "time",
            "value": "Date.parse(date + 'T' + event_time + 'Z')/1000"
          },
          {
            "name": "http_response",
            "value": "{}"
          },
          {
            "name": "http_response.code",
            "value": "http_status"
          },
          {
            "name": "http_response.http_headers",
            "value": "[{name:'Content-Type', value:content_type}, {name:'User-Agent', value:user_agent}]"
          },
          {
            "name": "traffic",
            "value": "{}"
          },
          {
            "name": "traffic.bytes",
            "value": "bytes_in!=null && bytes_out!=null ? bytes_in + bytes_out : null"
          },
          {
            "name": "message",
            "value": "method + ' ' + scheme + '://' + host + ':' + port + path + (query && query !== '-' ? '?' + query : '')"
          },
          {
            "name": "status_code",
            "value": "cache_result"
          },
          {
            "name": "status_detail",
            "value": "disposition + ' ' + cache_result"
          },
          {
            "name": "unmapped",
            "value": "{}"
          },
