  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "google_workspace to OCSF pipeline.\nParses events, drops noise, maps to OCSF schema, and outputs compact JSON."
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 1: Parse raw events ---"
      }
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "json",
        "srcField": "_raw"
      },
      "description": "Try JSON parse"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 2: Reduction — drop noise events ---"
      }
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise)",
      "final": true
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Extract event fields for mapping ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_appName",
            "value": "id && id.applicationName ? id.applicationName : ''"
          },
          {
            "name": "_evtName",
            "value": "events && events[0] ? events[0].name : ''"
          },
          {
            "name": "_evtType",
            "value": "events && events[0] ? events[0].type : ''"
          },
          {
            "name": "_params",
            "value": "events && events[0] && events[0].parameters ? events[0].parameters : []"
          }
        ]
      },
      "description": "Extract event parameters into flat temp fields"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 4: Map fields to OCSF schema ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "time",
            "value": "new Date(id && id.time ? id.time : _time).getTime()"
          },
          {
            "name": "class_uid",
            "value": "_appName == 'login' ? 3002 : (_appName == 'admin' ? 3005 : (_appName == 'drive' ? 4010 : 4010))"
          },
          {
            "name": "class_name",
            "value": "_appName == 'login' ? 'Authentication' : (_appName == 'admin' ? 'User Account Management' : (_appName == 'drive' ? 'File System Activity' : 'File System Activity'))"
          },
          {
            "name": "category_uid",
            "value": "_appName == 'login' ? 3 : (_appName == 'admin' ? 3 : 4)"
          },
          {
            "name": "category_name",
            "value": "_appName == 'login' ? 'Identity & Access Management' : (_appName == 'admin' ? 'Identity & Access Management' : 'System Activity')"
          },
          {
            "name": "activity_id",
            "value": "_appName == 'login' ? (_evtName == 'login_success' ? 1 : (_evtName == 'login_failure' ? 6 : (_evtName == 'login_logout' ? 2 : 1))) : (_appName == 'admin' ? (_evtName == 'CREATE_USER' ? 1 : (_evtName == 'DELETE_USER' ? 2 : 3)) : (_evtName == 'download' ? 2 : (_evtName == 'change_user_access' ? 6 : 99)))"
          },
          {
            "name": "activity_name",
            "value": "_appName == 'login' ? (_evtName == 'login_success' ? 'Logon' : (_evtName == 'login_failure' ? 'Logon' : (_evtName == 'login_logout' ? 'Logoff' : 'Logon'))) : (_appName == 'admin' ? (_evtName == 'CREATE_USER' ? 'Create' : (_evtName == 'DELETE_USER' ? 'Delete' : 'Other')) : (_evtName == 'download' ? 'Read' : (_evtName == 'change_user_access' ? 'Set Attributes' : 'Other')))"
          },
          {
            "name": "type_uid",
            "value": "(_appName == 'login' ? 3002 : (_appName == 'admin' ? 3005 : 4010)) * 100 + (_appName == 'login' ? (_evtName == 'login_success' ? 1 : (_evtName == 'login_failure' ? 6 : (_evtName == 'login_logout' ? 2 : 1))) : (_appName == 'admin' ? (_evtName == 'CREATE_USER' ? 1 : (_evtName == 'DELETE_USER' ? 2 : 3)) : (_evtName == 'download' ? 2 : (_evtName == 'change_user_access' ? 6 : 99))))"
          },
          {
            "name": "type_name",
            "value": "_appName == 'login' ? (_evtName == 'login_success' ? 'Authentication: Logon' : (_evtName == 'login_failure' ? 'Authentication: Logon' : 'Authentication: Logoff')) : (_appName == 'admin' ? (_evtName == 'CREATE_USER' ? 'User Account Management: Create' : 'User Account Management: Other') : (_evtName == 'download' ? 'File System Activity: Read' : 'File System Activity: Set Attributes'))"
          },
          {
            "name": "severity_id",
            "value": "_evtName == 'login_failure' ? 3 : (_evtName == 'change_user_access' ? 3 : 1)"
          },
          {
            "name": "severity",
            "value": "_evtName == 'login_failure' ? 'Medium' : (_evtName == 'change_user_access' ? 'Medium' : 'Informational')"
          },
          {
            "name": "status",
            "value": "_appName == 'login' ? (_evtName == 'login_success' ? 'Success' : (_evtName == 'login_failure' ? 'Failure' : 'Success')) : 'Success'"
          },
          {
            "name": "status_id",
            "value": "_appName == 'login' ? (_evtName == 'login_success' ? 1 : (_evtName == 'login_failure' ? 2 : 1)) : 1"
          },
          {
            "name": "status_detail",
            "value": "_login_failure_type || ''"
          },
          {
            "name": "metadata",
            "value": "{version:'1.4.0',product:{name:'Google Workspace',vendor_name:'Google'},log_name:_appName,uid:id && id.uniqueQualifier ? id.uniqueQualifier : ''}"
          },
          {
            "name": "actor",
            "value": "{'user':{'email_addr':id && actor && actor.email ? actor.email : '','uid':actor && actor.profileId ? actor.profileId : '','name':actor && actor.email ? actor.email : ''}}"
          },
          {
            "name": "src_endpoint",
            "value": "{'ip':ipAddress || ''}"
          },
          {
            "name": "unmapped_data",
            "value": "{'login_type':_login_type,'login_challenge_method':_login_challenge,'login_failure_type':_login_failure_type,'event_name':_evtName,'event_type':_evtType,'target_user':_target_user,'org_unit':_org_unit,'old_value':_old_value,'new_value':_new_value}"
          }
        ]
      },
      "description": "Map core OCSF fields"
    },
    {
      "id": "eval",
      "filter": "_appName == 'login'",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "auth_protocol",
            "value": "_login_type == 'saml' ? 'SAML' : (_login_type == 'google_password' ? 'Other' : 'Other')"
          },
          {
            "name": "auth_protocol_id",
            "value": "_login_type == 'saml' ? 4 : 99"
          },
          {
            "name": "is_mfa",
            "value": "_login_challenge == 'totp' || _login_challenge == 'idv_preregistered_phone' ? true : false"
          }
        ]
      },
      "description": "Auth-specific fields"
    },
    {
      "id": "eval",
      "filter": "_appName == 'drive'",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "file",
            "value": "{'name':_doc_title,'type':_doc_type,'owner':{'email_addr':_doc_owner},'path':_doc_title}"
          }
        ]
      },
      "description": "Drive file object"
    },
    {
      "id": "eval",
      "filter": "_appName == 'admin'",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "{'email_addr':_user_email_param,'name':_user_email_param}"
          },
          {
            "name": "group",
            "value": "{'name':_org_unit}"
          }
        ]
      },
      "description": "Admin user management object"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "time ? time / 1000 : _time"
          },
          {
            "name": "sourcetype",
            "value": "'google_workspace'"
          }
        ]
      },
      "description": "Set _time from OCSF time field"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 5: Final cleanup — remove raw/intermediate fields ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "_raw",
          "_appName",
          "_evtName",
          "_evtType",
          "_params",
          "_login_type",
          "_login_failure_type",
          "_login_challenge",
          "_doc_title",
          "_doc_type",
          "_doc_owner",
          "_target_user",
          "_user_email_param",
          "_org_unit",
          "_old_value",
          "_new_value",
          "kind",
          "id",
          "ipAddress",
          "events",
          "__*",
          "msg_body",
          "msg_format",
          "event_category",
          "event_action",
          "__kvp_src"
        ]
      },
      "description": "Remove raw/intermediate source fields"
    }
  ],
