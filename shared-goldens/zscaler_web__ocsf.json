{
  "key": "zscaler_web::ocsf",
  "sourcetype": "zscaler_web",
  "dest_format": "ocsf",
  "score": 91,
  "part": null,
  "author": "wvdlinde",
  "build": 273,
  "updated_at": "2026-07-16T18:17:46.176Z",
  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "zscaler_web to OCSF pipeline.\nParses events, drops noise, maps to OCSF schema, and outputs compact JSON."
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 1: Parse raw events ---"
      }
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "json",
        "srcField": "_raw"
      },
      "description": "Extract all JSON fields from Zscaler Web log"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "timestamp ? Date.parse(timestamp) / 1000 : _time"
          },
          {
            "name": "action",
            "value": "action == 'Blocked' ? 'block' : action == 'Allowed' ? 'allow' : action == 'Cautioned' ? 'caution' : action"
          },
          {
            "name": "protocol",
            "value": "protocol ? protocol.toLowerCase() : protocol"
          },
          {
            "name": "transport",
            "value": "'tcp'"
          },
          {
            "name": "direction",
            "value": "(src_ip && (src_ip.startsWith('10.') || src_ip.startsWith('172.16.') || src_ip.startsWith('192.168.'))) ? 'outbound' : 'inbound'"
          },
          {
            "name": "severity",
            "value": "risk_score >= 90 ? 'critical' : risk_score >= 70 ? 'high' : risk_score >= 40 ? 'medium' : risk_score >= 20 ? 'low' : 'info'"
          },
          {
            "name": "has_threat",
            "value": "threat_name && threat_name != '' ? true : false"
          },
          {
            "name": "has_dlp",
            "value": "dlp_rule && dlp_rule != '' ? true : false"
          },
          {
            "name": "dst_port",
            "value": "dst_port ? Number(dst_port) : dst_port"
          },
          {
            "name": "request_size",
            "value": "request_size ? Number(request_size) : request_size"
          },
          {
            "name": "response_size",
            "value": "response_size ? Number(response_size) : response_size"
          },
          {
            "name": "risk_score",
            "value": "risk_score ? Number(risk_score) : risk_score"
          }
        ]
      },
      "description": "Normalize timestamp, action, protocol, and derive direction/severity"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "user == 'unknown' || user == '' ? 'anonymous' : user"
          },
          {
            "name": "department",
            "value": "department && department != '' ? department : 'Unknown'"
          },
          {
            "name": "threat_name",
            "value": "threat_name && threat_name != '' ? threat_name : undefined"
          },
          {
            "name": "dlp_rule",
            "value": "dlp_rule && dlp_rule != '' ? dlp_rule : undefined"
          }
        ]
      },
      "description": "Normalize anonymous/unknown user and empty department fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "log_time",
            "value": "_time"
          }
        ]
      },
      "description": "Alias _time to log_time"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 2: Reduction ---"
      }
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (enable in Cribl UI to activate)",
      "final": true
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Map fields to OCSF schema ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4002"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "event_type",
            "value": "'HTTP Activity'"
          },
          {
            "name": "time",
            "value": "log_time ? log_time * 1000 : Date.parse(timestamp)"
          },
          {
            "name": "activity_id",
            "value": "action == 'allow' ? 1 : action == 'block' ? 5 : action == 'caution' ? 3 : 0"
          },
          {
            "name": "type_uid",
            "value": "action == 'allow' ? 400201 : action == 'block' ? 400205 : action == 'caution' ? 400203 : 400200"
          },
          {
            "name": "severity_id",
            "value": "Number(risk_score) >= 90 ? 5 : Number(risk_score) >= 70 ? 4 : Number(risk_score) >= 50 ? 3 : Number(risk_score) >= 30 ? 2 : Number(risk_score) >= 10 ? 1 : 0"
          },
          {
            "name": "src_endpoint",
            "value": "{'ip': src_ip || ''}"
          },
          {
            "name": "dst_endpoint",
            "value": "{'ip': dst_ip || '', 'port': Number(dst_port) || 0}"
          },
          {
            "name": "connection_info",
            "value": "{'protocol_name': protocol ? protocol.toUpperCase() : '', 'direction': direction, 'protocol_ver': '4'}"
          },
          {
            "name": "actor",
            "value": "{'user': {'name': user || '', 'email_addr': user || ''}}"
          },
          {
            "name": "traffic",
            "value": "{'bytes_out': Number(request_size) || 0, 'bytes_in': Number(response_size) || 0}"
          },
          {
            "name": "device",
            "value": "{'hostname': src_ip || ''}"
          },
          {
            "name": "metadata",
            "value": "{'version': '1.4.0', 'product': {'name': 'Zscaler Internet Access', 'vendor_name': 'Zscaler'}}"
          },
          {
            "name": "http_request",
            "value": "{'url': {'text': url || ''}, 'user_agent': user_agent || ''}"
          },
          {
            "name": "web_resources_activity",
            "value": "{'category': url_category || ''}"
          },
          {
            "name": "risk_details",
            "value": "{'score': Number(risk_score) || 0, 'has_threat': has_threat, 'has_dlp': has_dlp}"
          }
        ]
      },
      "description": "Map fields to OCSF schema"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 4: Final cleanup ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "_raw",
          "msg_body",
          "msg_format",
          "event_category",
          "event_action",
          "__kvp_src",
          "__*"
        ]
      },
      "description": "Drop raw and intermediate fields, retain all OCSF-mapped fields"
    }
  ],
