          },
          {
            "name": "Protocol",
            "value": "(protocol || 'TCP').toUpperCase()"
          },
          {
            "name": "ApplicationProtocol",
            "value": "'HTTPS'"
          },
          {
            "name": "DeviceAction",
            "value": "action || (Number(status || 0) >= 400 ? 'blocked' : 'allowed')"
          },
          {
            "name": "SourceUserName",
            "value": "user || ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-19)",
      "conf": {
        "add": [
          {
            "name": "DestinationUserName",
            "value": "user || ''"
          },
          {
            "name": "SentBytes",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "LogSeverity",
            "value": "severity ? String(severity) : (Number(status || 0) == 401 ? '8' : (Number(status || 0) == 403 ? '7' : (Number(status || 0) >= 500 ? '6' : '3')))"
          },
          {
            "name": "RequestURL",
            "value": "uri || ''"
          }
        ]
      }
    },
