  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d+):/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract leading timestamp from the event"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/username:\\s*(?<target_user>\\S+)\\s+configured/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract the username being configured (AAA-6-USERNAME_CONFIGURATION)"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/privilege updated with priv-(?<privilege>\\d+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract the privilege level assigned to the target user"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/User:(?<admin_user>\\S+)\\s+logged command:username\\s+\\S+\\s+privilege\\s+\\d+\\s+secret/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract the admin user who issued the configuration command"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/!config:\\s*(?<config_status>[^\\n]*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract the config change status message (e.g. USER TABLE MODIFIED)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
