            "value": "parsed.cluster || null"
          },
          {
            "name": "metadata.reporter.uid",
            "value": "parsed.GUID || parsed.QID || null"
          },
          {
            "name": "metadata.reporter.ip.address",
            "value": "parsed.senderIP || null"
          }
        ],
        "keep": [
          "metadata.*",
          "cribl_*",
          "__*"
        ],
        "remove": [
          "_raw",
          "_time",
          "parsed"
        ]
      },
      "id": "eval",
      "description": "Create OCSF metadata fields from Proofpoint event values"
    }
