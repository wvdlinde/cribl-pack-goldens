    {
      "id": "serde",
      "description": "Parse the Proofpoint JSON payload from _raw into a working object.",
      "filter": "true",
      "conf": {
        "mode": "extract",
        "type": "json",
        "srcField": "_raw",
        "dstField": "pp",
        "remove": [],
        "overwrite": true
      }
    },
    {
      "id": "eval",
      "description": "Map parsed Proofpoint fields to the requested OCSF email_activity schema fields.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "activity_id",
            "value": "pp.action==='messagesDelivered'?2:3"
          },
          {
            "name": "status_id",
            "value": "pp.action==='messagesDelivered'?1:0"
          },
          {
            "name": "status",
            "value": "pp.action==='messagesDelivered'?'Success':'Unknown'"
          },
          {
            "name": "protocol_name",
            "value": "'SMTP'"
          },
          {
            "name": "message_trace_uid",
            "value": "pp.GUID ? pp.GUID : pp.QID"
          },
          {
            "name": "from",
            "value": "pp.sender ? {email_addr: pp.sender} : (pp.fromAddress && pp.fromAddress[0] ? {email_addr: pp.fromAddress[0]} : {})"
          },
          {
            "name": "to",
            "value": "pp.recipient ? pp.recipient : (pp.toAddresses ? pp.toAddresses : [])"
          },
          {
            "name": "email.from",
            "value": "pp.fromAddress && pp.fromAddress[0] ? {email_addr: pp.fromAddress[0]} : (pp.sender ? {email_addr: pp.sender} : {})"
          },
          {
            "name": "email.message_uid",
            "value": "pp.messageID"
          },
          {
            "name": "email.size.bytes",
            "value": "pp.messageSize"
          },
          {
            "name": "email.subject",
            "value": "pp.subject"
          },
          {
            "name": "email.to",
            "value": "pp.toAddresses ? pp.toAddresses : (pp.recipient ? pp.recipient : [])"
          },
          {
            "name": "email.uid",
            "value": "pp.GUID ? pp.GUID : pp.id"
          }
        ]
      }
    },
    {
      "filter": "true",
      "conf": {
        "mode": "extract",
        "type": "json",
        "srcField": "_raw",
        "dstField": "proofpoint",
        "remove": [],
        "overwrite": true
      },
      "id": "serde",
      "description": "Parse Proofpoint JSON event from _raw into proofpoint object"
    },
    {
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4009"
          },
          {
            "name": "timezone_offset",
            "value": "0"
          },
          {
            "name": "direction_id",
            "value": "proofpoint.policyRoutes && proofpoint.policyRoutes.toString().toLowerCase().indexOf('inbound') >= 0 ? 1 : (proofpoint.policyRoutes && proofpoint.policyRoutes.toString().toLowerCase().indexOf('outbound') >= 0 ? 2 : 0)"
          },
          {
            "name": "severity_id",
            "value": "proofpoint.threatsInfoMap && proofpoint.threatsInfoMap[0] && proofpoint.threatsInfoMap[0].classification && proofpoint.threatsInfoMap[0].classification.toLowerCase()==='malware' ? 4 : (proofpoint.threatsInfoMap && proofpoint.threatsInfoMap[0] ? 3 : 1)"
          },
          {
            "name": "type_uid",
            "value": "400903"
          },
          {
            "name": "src_endpoint.ip",
            "value": "proofpoint.senderIP ? proofpoint.senderIP : null"
          },
          {
            "name": "src_endpoint.uid",
            "value": "proofpoint.sender ? proofpoint.sender : null"
          },
          {
            "name": "src_endpoint.name",
            "value": "proofpoint.sender ? proofpoint.sender : null"
          },
          {
            "name": "src_endpoint.type_id",
            "value": "0"
          },
          {
            "name": "dst_endpoint.name",
            "value": "proofpoint.cluster ? proofpoint.cluster : null"
          },
          {
            "name": "dst_endpoint.svc_name",
            "value": "'Proofpoint Email Protection'"
          },
          {
            "name": "dst_endpoint.type_id",
            "value": "1"
          }
        ]
      },
      "id": "eval",
      "description": "Map selected OCSF Email Activity target fields from parsed Proofpoint data"
    },
