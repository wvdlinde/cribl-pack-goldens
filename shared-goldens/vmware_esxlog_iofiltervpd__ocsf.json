{
  "key": "vmware_esxlog_iofiltervpd::ocsf",
  "sourcetype": "vmware_esxlog_iofiltervpd",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:00:44.123Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+) (?<host>\\S+) Iofiltervpd\\[(?<pid>\\d+)\\]: (?<severity>\\w+)\\s+IOFilterVPD: (?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract base fields (timestamp, host, pid, severity, message) from raw IOFilterVPD log line"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/@\\d{1,3}(\\.\\d{1,3}){3}/)",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/(?:user=)?(?<user>[\\w.]+)@(?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3})/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract user and source IP from messages containing user@ip pattern (e.g. user=root@10.20.4.51)"
    },
    {
      "id": "regex_extract",
      "filter": "message && !src_ip && message.match(/from (vCenter|host)?\\s*\\d{1,3}(\\.\\d{1,3}){3}/)",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/from (?:vCenter|host)?\\s*(?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3})/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract source IP from vCenter/host connection or authentication related messages without user context"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message.match(/blocking source|rejected|failed|Failed|crashed/) ? 'blocked' : message.match(/approved|accepted|registered|completed|started|applied/) ? 'allowed' : 'info'"
          }
        ]
      },
      "description": "Classify action based on message keywords (allowed, blocked, or informational)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "Date.parse(timestamp)/1000"
          }
        ]
      },
      "description": "Convert extracted timestamp string into epoch _time for downstream time-based processing"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip"
          },
          {
            "name": "device.hostname",
            "value": "host"
          },
          {
            "name": "actor.user.name",
            "value": "user"
          },
          {
            "name": "time",
            "value": "Number(_time) * 1000"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : severity == 'error' ? 4 : severity == 'warning' ? 3 : severity == 'info' ? 1 : 0"
          },
          {
            "name": "actor.user.name",
            "value": "action"
          },
          {
            "name": "metadata.product.name",
            "value": "'ESXi IOFilterVPD'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'VMware'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "1"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "type_uid",
            "value": "400101"
          }
        ]
      },
      "description": "Map fields (continued 16-16)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware:esxlog:iofiltervpd'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
