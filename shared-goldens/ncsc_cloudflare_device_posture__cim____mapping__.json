{
  "key": "ncsc_cloudflare_device_posture::cim::__mapping__",
  "sourcetype": "ncsc_cloudflare_device_posture",
  "dest_format": "cim::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 378,
  "updated_at": "2026-08-07T13:23:03.822Z",
  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'Network_Traffic'"
          },
          {
            "name": "category_uid",
            "value": "'Network'"
          },
          {
            "name": "event_type",
            "value": "'posture_check'"
          },
          {
            "name": "src",
            "value": "String(ip || '')"
          },
          {
            "name": "user",
            "value": "String(user_email || '')"
          },
          {
            "name": "vendor_action",
            "value": "String(result || '')"
          },
          {
            "name": "action",
            "value": "result == 'pass' ? 'allowed' : result == 'fail' ? 'blocked' : String(result || '')"
          },
          {
            "name": "rule",
            "value": "String(check_type || '')"
          },
          {
            "name": "signature",
            "value": "String(reason || '')"
          },
          {
            "name": "dvc",
            "value": "String(hostname || '')"
          },
          {
            "name": "dvc_id",
            "value": "String(device_id || '')"
          },
          {
            "name": "os",
            "value": "String(os || '')"
          },
          {
            "name": "os_version",
            "value": "String(os_version || '')"
          },
          {
            "name": "category",
            "value": "String(event_type || '')"
          },
          {
            "name": "object",
            "value": "String(serial_number || '')"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-17)",
      "conf": {
        "add": [
          {
            "name": "severity",
            "value": "severity == 'info' ? 'informational' : String(severity || '')"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : severity == 'high' ? 4 : severity == 'medium' ? 3 : severity == 'low' ? 2 : severity == 'info' ? 1 : 0"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ncsc:cloudflare:device_posture'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}