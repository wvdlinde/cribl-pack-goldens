{
  "key": "cisco_ise::ocsf",
  "sourcetype": "cisco_ise",
  "dest_format": "ocsf",
  "score": 97,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:00:40.198Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<pri>\\d+)>(?<syslog_time>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<message_type>CISE_\\S+)\\s+(?<seq1>\\d+)\\s+(?<seq2>\\d+)\\s+(?<seq3>\\d+)\\s+(?<timestamp>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)\\s+(?<tz>[+-]\\d{2}:\\d{2})\\s+(?<seq4>\\d+)\\s+(?<message_code>\\d+)\\s+(?<severity>\\w+)\\s+(?<message_name>[^:]+):\\s*(?<message>[^,]+),\\s*(?<kvp>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse standard Cisco ISE syslog header, message metadata, and trailing key-value payload"
    },
    {
      "id": "regex_extract",
      "filter": "!message_name && _raw.indexOf('CISE_Alarm')>-1",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<pri>\\d+)>(?<syslog_time>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<message_type>CISE_\\S+)\\s+(?<severity>\\w+):\\s+(?<message_name>[^:]+):\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse alternate CISE_Alarm format that lacks sequence numbers and structured timestamp"
    },
    {
      "id": "serde",
      "filter": "kvp",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "kvp",
        "cleanFields": true
      },
      "description": "Extract key=value pairs from the trailing KVP payload into individual top-level fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "this['User_Name'] ? this['User_Name'] : (this['UserName'] ? this['UserName'] : (this['AdminName'] ? this['AdminName'] : (this['GuestUserName'] ? this['GuestUserName'] : (this['User'] ? this['User'] : null))))"
          },
          {
            "name": "src_ip",
            "value": "this['Device_IP_Address'] ? this['Device_IP_Address'] : (this['NAS_IP_Address'] ? this['NAS_IP_Address'] : (this['AdminIPAddress'] ? this['AdminIPAddress'] : (this['IpAddress'] ? this['IpAddress'] : null)))"
          },
          {
            "name": "dst_ip",
            "value": "this['DestinationIPAddress'] ? this['DestinationIPAddress'] : null"
          },
          {
            "name": "dst_port",
            "value": "this['DestinationPort'] ? Number(this['DestinationPort']) : null"
          },
          {
            "name": "protocol",
            "value": "this['Protocol'] ? this['Protocol'] : null"
          },
          {
            "name": "action",
            "value": "message_name ? message_name : null"
          }
        ]
      },
      "description": "Normalize common identity, network, and protocol fields from the extracted KVP data"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity=='NOTICE' ? 'info' : severity=='WARN' ? 'warning' : severity=='DEBUG' ? 'debug' : severity=='INFO' ? 'info' : severity=='ERR' ? 'error' : 'unknown'"
          },
          {
            "name": "_time",
            "value": "timestamp ? new Date(timestamp.replace(' ','T') + (tz ? tz : '')).getTime()/1000 : _time"
          }
        ]
      },
      "description": "Normalize severity levels and derive event time from parsed timestamp and timezone offset"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "Address || NAS_IP_Address || Remote_Address || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "DestinationIPAddress || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(Port || 0)"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(DestinationPort || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "Protocol || ''"
          },
          {
            "name": "actor.user.name",
            "value": "UserName || User_Name || User || AdminName || ''"
          },
          {
            "name": "device.hostname",
            "value": "NetworkDeviceName || host || ''"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(sent || 0)"
          },
          {
            "name": "traffic.bytes_in",
            "value": "Number(rcvd || 0)"
          },
          {
            "name": "time",
            "value": "Date.parse(timestamp) ? Date.parse(timestamp) : Date.parse(syslog_time)"
          },
          {
            "name": "severity_id",
            "value": "Number(severity || vendor_severity || 0)"
          },
          {
            "name": "metadata.version",
            "value": "Version || ''"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.product.vendor_name",
            "value": "'Cisco'"
          },
          {
            "name": "metadata.product.name",
            "value": "'Cisco ISE'"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "AuthenticationResult == 'succeeded' || AuthenticationStatus == 'Success' ? 1 : 2"
          },
          {
            "name": "type_uid",
            "value": "400101"
          }
        ]
      },
      "description": "Map fields (continued 16-21)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'cisco:ise'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
