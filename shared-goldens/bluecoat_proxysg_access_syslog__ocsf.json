{
  "key": "bluecoat_proxysg_access_syslog::ocsf",
  "sourcetype": "bluecoat_proxysg_access_syslog",
  "dest_format": "ocsf",
  "score": 97,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:54:39.177Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<timestamp>\\d{4}-\\d{2}-\\d{2}\\s\\d{2}:\\d{2}:\\d{2})\\s+(?<time_taken>\\d+)\\s+(?<src_ip>\\S+)\\s+(?<user>\\S+)\\s+(?<auth_group>\\S+)\\s+(?<proxy_action>\\S+)\\s+(?<status>\\d+)\\s+(?<dst_ip>\\S+)\\s+(?<http_method>\\S+)\\s+(?<content_type>\\S+)\\s+(?<protocol>\\S+)\\s+(?<dst_host>\\S+)\\s+(?<dst_port>\\d+)\\s+(?<uri_path>\\S+)\\s+(?<uri_query>\\S+)\\s+\"(?<http_user_agent>[^\"]*)\"\\s+(?<bytes_out>\\d+)\\s+(?<bytes_in>\\d+)\\s+(?<virus_id>\\S+)\\s*$/"
      },
      "description": "Parse Blue Coat ProxySG main access log format (space delimited, quoted user-agent)"
    },
    {
      "id": "eval",
      "filter": "timestamp",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "strptime(timestamp, '%Y-%m-%d %H:%M:%S')"
          },
          {
            "name": "user",
            "value": "(user == '-' || user == '') ? undefined : user"
          },
          {
            "name": "auth_group",
            "value": "(auth_group == '-' || auth_group == '') ? undefined : auth_group"
          },
          {
            "name": "content_type",
            "value": "content_type == '-' ? undefined : content_type"
          },
          {
            "name": "uri_query",
            "value": "uri_query == '-' ? undefined : uri_query"
          },
          {
            "name": "uri_path",
            "value": "uri_path == '-' ? undefined : uri_path"
          },
          {
            "name": "http_user_agent",
            "value": "(http_user_agent == '-' || http_user_agent == '') ? undefined : http_user_agent"
          },
          {
            "name": "virus_id",
            "value": "virus_id == '-' ? undefined : virus_id"
          },
          {
            "name": "dst_port",
            "value": "Number(dst_port)"
          },
          {
            "name": "status",
            "value": "Number(status)"
          },
          {
            "name": "bytes_in",
            "value": "Number(bytes_in)"
          },
          {
            "name": "bytes_out",
            "value": "Number(bytes_out)"
          },
          {
            "name": "bytes",
            "value": "Number(bytes_in) + Number(bytes_out)"
          },
          {
            "name": "duration_ms",
            "value": "Number(time_taken)"
          }
        ],
        "remove": [
          "time_taken"
        ]
      },
      "description": "Normalize placeholder dashes, numeric types and event time"
    },
    {
      "id": "eval",
      "filter": "proxy_action",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "proxy_action.match(/DENIED|BLOCK|FAIL/i) ? 'blocked' : 'allowed'"
          },
          {
            "name": "cache_result",
            "value": "proxy_action.match(/^TCP_/) ? proxy_action : undefined"
          },
          {
            "name": "protocol",
            "value": "protocol.toLowerCase()"
          },
          {
            "name": "app_protocol",
            "value": "protocol.toLowerCase() == 'https' ? 'ssl' : protocol.toLowerCase()"
          },
          {
            "name": "transport",
            "value": "'tcp'"
          },
          {
            "name": "ip_version",
            "value": "String(src_ip).indexOf(':') > -1 ? 'ipv6' : 'ipv4'"
          },
          {
            "name": "url",
            "value": "dst_host ? (protocol.toLowerCase() + '://' + dst_host + (uri_path ? uri_path : '') + (uri_query ? '?' + uri_query : '')) : undefined"
          }
        ]
      },
      "description": "Normalize action, protocol, IP version and derive URL"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "direction",
            "value": "String(src_ip).match(/^(10\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|fe80:|fc|fd)/i) ? 'outbound' : 'inbound'"
          },
          {
            "name": "severity",
            "value": "virus_id ? 'high' : (action == 'blocked' ? 'medium' : 'low')"
          },
          {
            "name": "event_type",
            "value": "virus_id ? 'malware' : (action == 'blocked' ? 'proxy_denied' : 'proxy_allowed')"
          },
          {
            "name": "message",
            "value": "(action == 'blocked' ? 'Blocked ' : 'Allowed ') + http_method + ' ' + dst_host + ' status=' + status + (virus_id ? ' threat=' + virus_id : '')"
          }
        ]
      },
      "description": "Derive direction and severity, set summary message"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity: Traffic'"
          },
          {
            "name": "time",
            "value": "timestamp ? Math.round(new Date(timestamp).getTime()) : Date.now()"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(transport || protocol || app_protocol || '').toLowerCase()"
          },
          {
            "name": "traffic.bytes_in",
            "value": "Number(bytes_in || 0)"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(bytes_out || 0)"
          },
          {
            "name": "actor.user.name",
            "value": "user && user != '-' && user != 'anonymous' ? user : ''"
          },
          {
            "name": "device.hostname",
            "value": "dst_host && dst_host != '-' ? dst_host : ''"
          },
          {
            "name": "activity_id",
            "value": "(proxy_action || action || '').match(/DENIED|DENY|BLOCK/i) ? 5 : ((proxy_action || action || '').match(/MISS|ERROR|FAIL/i) && Number(status || 0) >= 500 ? 4 : 6)"
          },
          {
            "name": "type_uid",
            "value": "400100 + ((proxy_action || action || '').match(/DENIED|DENY|BLOCK/i) ? 5 : ((proxy_action || action || '').match(/MISS|ERROR|FAIL/i) && Number(status || 0) >= 500 ? 4 : 6))"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : (severity == 'high' ? 4 : (severity == 'medium' ? 3 : (severity == 'low' ? 2 : (Number(severity) || (virus_id && virus_id != '-' ? 4 : (Number(status || 0) >= 400 ? 3 : 1))))))"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          },
          {
            "name": "metadata.product.name",
            "value": "'ProxySG'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Broadcom'"
          }
        ]
      },
      "description": "Map fields (continued 16-20)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'bluecoat:proxysg:access:syslog'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [
      {
        "severity": "medium",
        "field": "_value",
        "issue": "sample value \"x11;\" was not extracted/mapped into the output",
        "pointImpact": 0
      },
      {
        "severity": "medium",
        "field": "_value",
        "issue": "sample value \"1.0\" was not extracted/mapped into the output",
        "pointImpact": 0
      }
    ],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}