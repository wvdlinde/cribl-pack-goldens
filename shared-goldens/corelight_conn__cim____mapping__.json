{
  "key": "corelight_conn::cim::__mapping__",
  "sourcetype": "corelight_conn",
  "dest_format": "cim::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 302,
  "updated_at": "2026-08-04T06:01:45.292Z",
  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'Network_Traffic'"
          },
          {
            "name": "category_uid",
            "value": "'network'"
          },
          {
            "name": "event_type",
            "value": "'network_traffic'"
          },
          {
            "name": "src",
            "value": "__e['id.orig_h'] || ''"
          },
          {
            "name": "dest",
            "value": "__e['id.resp_h'] || ''"
          },
          {
            "name": "src_port",
            "value": "Number(__e['id.orig_p'] || 0)"
          },
          {
            "name": "dest_port",
            "value": "Number(__e['id.resp_p'] || 0)"
          },
          {
            "name": "transport",
            "value": "(proto || '').toLowerCase()"
          },
          {
            "name": "app",
            "value": "service || ''"
          },
          {
            "name": "duration",
            "value": "Number(duration || 0)"
          },
          {
            "name": "bytes_out",
            "value": "Number(orig_bytes || 0)"
          },
          {
            "name": "bytes_in",
            "value": "Number(resp_bytes || 0)"
          },
          {
            "name": "bytes",
            "value": "Number(orig_bytes || 0) + Number(resp_bytes || 0)"
          },
          {
            "name": "packets_out",
            "value": "Number(orig_pkts || 0)"
          },
          {
            "name": "packets_in",
            "value": "Number(resp_pkts || 0)"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-20)",
      "conf": {
        "add": [
          {
            "name": "packets",
            "value": "Number(orig_pkts || 0) + Number(resp_pkts || 0)"
          },
          {
            "name": "action",
            "value": "(conn_state == 'SF' || conn_state == 'S1' || conn_state == 'RSTO' || conn_state == 'RSTR') ? 'allowed' : (conn_state == 'REJ' || conn_state == 'RSTOS0' || conn_state == 'RSTRH') ? 'blocked' : 'unknown'"
          },
          {
            "name": "session_id",
            "value": "uid || ''"
          },
          {
            "name": "direction",
            "value": "local_orig && !local_resp ? 'outbound' : !local_orig && local_resp ? 'inbound' : local_orig && local_resp ? 'internal' : 'unknown'"
          },
          {
            "name": "vendor_product",
            "value": "'Corelight'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}