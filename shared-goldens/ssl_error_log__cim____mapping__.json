{
  "key": "ssl_error_log::cim::__mapping__",
  "sourcetype": "ssl_error_log",
  "dest_format": "cim::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 378,
  "updated_at": "2026-08-07T14:19:32.669Z",
  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "client_ip"
          },
          {
            "name": "src_port",
            "value": "Number(client_port || 0)"
          },
          {
            "name": "dest",
            "value": "message && message.match(/server\\s+([^:]+):/) ? message.match(/server\\s+([^:]+):/)[1] : ''"
          },
          {
            "name": "dest_port",
            "value": "message && message.match(/server\\s+[^:]+:(\\d+)/) ? Number(message.match(/server\\s+[^:]+:(\\d+)/)[1]) : ''"
          },
          {
            "name": "signature",
            "value": "message && message.match(/AH\\d+/) ? message.match(/AH\\d+/)[0] : ''"
          },
          {
            "name": "tls_peer_cn",
            "value": "message && message.match(/CN=([^:,\\s]+)/) ? message.match(/CN=([^:,\\s]+)/)[1] : ''"
          },
          {
            "name": "category",
            "value": "log_module || ''"
          },
          {
            "name": "severity",
            "value": "log_module && log_module.indexOf(':') > -1 ? log_module.split(':')[1] : log_module"
          },
          {
            "name": "process_id",
            "value": "String(pid || '')"
          },
          {
            "name": "subject",
            "value": "message || ''"
          },
          {
            "name": "protocol",
            "value": "'ssl'"
          },
          {
            "name": "transport",
            "value": "'tcp'"
          },
          {
            "name": "app",
            "value": "'ssl'"
          },
          {
            "name": "vendor_product",
            "value": "'Apache mod_ssl'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ssl_error_log'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}