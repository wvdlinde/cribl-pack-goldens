          },
          {
            "name": "metadata.product",
            "value": "{}"
          },
          {
            "name": "metadata.product.name",
            "value": "'Ingress Sensor'"
          },
          {
            "name": "metadata.product.uid",
            "value": "parsed.sensor_id != null ? parsed.sensor_id.toString() : null"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Ingress'"
          },
          {
            "name": "metadata.product.version",
            "value": "'unknown'"
          },
          {
            "name": "metadata.reporter",
            "value": "{}"
          },
          {
            "name": "metadata.reporter.name",
            "value": "parsed.hostname"
          },
          {
            "name": "metadata.reporter.uid",
            "value": "parsed.sensor_id != null ? parsed.sensor_id.toString() : null"
          },
          {
            "name": "metadata.tenant_uid",
            "value": "parsed.sensor_id != null ? parsed.sensor_id.toString() : null"
          },
          {
            "name": "metadata.version",
            "value": "'1.8.0'"
          }
        ],
        "remove": [
          "_raw",
          "_time",
          "parsed"
        ]
      },
      "id": "eval",
      "description": "Create target OCSF type_uid and metadata fields"
    }
  ],
