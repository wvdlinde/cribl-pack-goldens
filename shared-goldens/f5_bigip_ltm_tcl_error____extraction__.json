{
  "key": "f5_bigip_ltm_tcl_error::__extraction__",
  "sourcetype": "f5_bigip_ltm_tcl_error",
  "dest_format": "__extraction__",
  "score": 93,
  "part": "extraction",
  "author": "unknown",
  "build": 379,
  "updated_at": "2026-08-07T15:31:46.944Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse the BIG-IP syslog header and message envelope",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<severity>\\S+)\\s+(?<process>\\w+)\\[(?<pid>\\d+)\\]:\\s+(?<message_id>[0-9A-Fa-f]+):(?<message_severity_code>\\d+):\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.includes(' invoked from within ')",
      "disabled": false,
      "description": "Parse TCL errors containing an invoked-from context",
      "conf": {
        "source": "message",
        "regex": "/^TCL error:\\s+(?<irule>\\S+)\\s+<(?<irule_event>[^>]+)>\\s+-\\s+(?<error_message>.*?)\\s+while executing\\s+\"(?<executing_command>.*?)\"\\s+invoked from within\\s+\"(?<invoked_from>.*)\"$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && !message.includes(' invoked from within ')",
      "disabled": false,
      "description": "Parse TCL errors without an invoked-from context",
      "conf": {
        "source": "message",
        "regex": "/^TCL error:\\s+(?<irule>\\S+)\\s+<(?<irule_event>[^>]+)>\\s+-\\s+(?<error_message>.*?)\\s+while executing\\s+\"(?<executing_command>.*)\"$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize the event action and derive application protocol",
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "'error'"
          },
          {
            "name": "event_type",
            "value": "'tcl_error'"
          },
          {
            "name": "protocol",
            "value": "irule_event && irule_event.startsWith('HTTP_') ? 'HTTP' : irule_event === 'DNS_REQUEST' ? 'DNS' : irule_event === 'CLIENTSSL_CLIENTHELLO' ? 'TLS' : 'UNKNOWN'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}