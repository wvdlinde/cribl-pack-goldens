{
  "key": "ivanti_splunkd::ocsf",
  "sourcetype": "ivanti_splunkd",
  "dest_format": "ocsf",
  "score": 85,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:56:30.400Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})\\s+-\\s+(?<dvc_host>\\S+)\\s+-\\s+\\[(?<src_ip>[^\\]]+)\\](?:\\s+(?<user>[^\\s(]+)\\((?<user_realm>[^)]*)\\)\\[(?<user_role>[^\\]]*)\\])?\\s+-\\s+(?<event_code>[A-Z]{3}\\d+)\\s+-\\s+(?<message>.*)$/"
      },
      "description": "Parse Ivanti ICS base structure: timestamp, appliance host, source IP, optional user(realm)[role], event code, message"
    },
    {
      "id": "regex_extract",
      "filter": "event_code && event_code.startsWith('AUT')",
      "disabled": false,
      "conf": {
        "source": "message",
        "iterations": 4,
        "overwrite": false,
        "regex": "/(?:using auth server (?<auth_server>[^\\s.]+))|(?:unknown username '(?<attempted_user>[^']+)')|(?:\\((?<failure_reason>[^)]+)\\))|(?:attempt (?<attempt_count>\\d+))/"
      },
      "description": "Extract authentication specifics: auth server, failure reason, attempted username, attempt count"
    },
    {
      "id": "regex_extract",
      "filter": "message && (message.match(/assigned IP|session duration|bytes transferred|on port/) != null)",
      "disabled": false,
      "conf": {
        "source": "message",
        "iterations": 4,
        "overwrite": false,
        "regex": "/(?:assigned IP (?<vpn_assigned_ip>[0-9a-fA-F:.]+))|(?:session duration (?<session_duration>[\\d:]+))|(?:bytes transferred (?<bytes>\\d+))|(?:on port (?<dst_port>\\d+)\\/(?<__transport>[a-zA-Z]+))/"
      },
      "description": "Extract VPN/session/network details: assigned tunnel IP, duration, bytes, destination port and transport"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "timestamp ? strptime(timestamp, '%Y-%m-%d %H:%M:%S') : _time"
          },
          {
            "name": "event_category",
            "value": "event_code ? (event_code.startsWith('AUT') ? 'authentication' : event_code.startsWith('ADM') ? 'administration' : event_code.startsWith('VPN') ? 'vpn' : event_code.startsWith('SEC') ? 'security' : event_code.startsWith('SYS') ? 'system' : 'other') : 'other'"
          },
          {
            "name": "action",
            "value": "message ? (message.match(/Blocked/i) ? 'blocked' : message.match(/successful|established|completed successfully|logged into|modified/i) ? 'success' : message.match(/failed|failure|locked|invalid|brute force/i) ? 'failure' : message.match(/timed out|terminated|expiration/i) ? 'info' : 'info') : 'info'"
          },
          {
            "name": "severity",
            "value": "event_code && event_code.startsWith('SEC') ? 'high' : (action == 'failure' ? 'medium' : 'low')"
          },
          {
            "name": "protocol",
            "value": "__transport ? __transport.toLowerCase() : undefined"
          },
          {
            "name": "src_ip_version",
            "value": "src_ip ? (src_ip.indexOf(':') > -1 ? 6 : 4) : undefined"
          },
          {
            "name": "user",
            "value": "user ? user : attempted_user"
          },
          {
            "name": "dst_host",
            "value": "dvc_host"
          }
        ],
        "remove": [
          "__transport"
        ]
      },
      "description": "Normalize timestamp, classify event category/action/severity, normalize protocol and IP version"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_host || dvc_host || vpn_assigned_ip || ''"
          },
          {
            "name": "actor.user.name",
            "value": "user || attempted_user || ''"
          },
          {
            "name": "device.hostname",
            "value": "dvc_host || ''"
          },
          {
            "name": "time",
            "value": "Number(Date.parse(timestamp))"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : severity == 'error' ? 4 : severity == 'warning' ? 3 : severity == 'informational' ? 1 : 0"
          },
          {
            "name": "activity_id",
            "value": "action == 'success' || action == 'established' ? 1 : (action == 'failure' || action == 'terminated' ? 2 : 99)"
          },
          {
            "name": "type_uid",
            "value": "400100 + (action == 'success' || action == 'established' ? 1 : (action == 'failure' || action == 'terminated' ? 2 : 99))"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "event_code && event_code.indexOf('VPN') === 0 ? 'VPN' : ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(0)"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.product.name",
            "value": "'Ivanti Connect Secure'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Ivanti'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          }
        ]
      },
      "description": "Map fields (continued 16-18)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_splunkd'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
