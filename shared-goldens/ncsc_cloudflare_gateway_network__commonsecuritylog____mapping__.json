            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'NetworkActivity'"
          },
          {
            "name": "TimeGenerated",
            "value": "typeof (Datetime||datetime) === 'number' ? (String(Datetime||datetime).length > 12 ? new Date((Datetime||datetime)/1000000).toISOString() : new Date((Datetime||datetime)*1000).toISOString()) : new Date(Datetime||datetime).toISOString()"
          },
          {
            "name": "DeviceVendor",
            "value": "'Cloudflare'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Cloudflare Gateway'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "Action || action"
          },
          {
            "name": "Activity",
            "value": "(Action||action) === 'blocked' ? 'Blocked' : (Action||action) === 'allowedOnRuleMatch' ? 'Allowed by Rule' : (Action||action) === 'allowedOnNoRuleMatch' ? 'Allowed by Default' : (Action||action)"
          },
          {
            "name": "DeviceAction",
            "value": "Action || action"
          },
          {
            "name": "LogSeverity",
            "value": "(Action||action) && (Action||action).toLowerCase().indexOf('block') >= 0 ? '8' : '3'"
          },
          {
            "name": "SourceIP",
            "value": "(/^(\\d{1,3}(\\.\\d{1,3}){3}|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]+)$/.test(String((SourceIP || sourceip || ''))) ? (SourceIP || sourceip || '') : undefined)"
          },
          {
            "name": "SourcePort",
            "value": "Number(SourcePort || sourceport || 0)"
          },
          {
            "name": "DestinationIP",
            "value": "(/^(\\d{1,3}(\\.\\d{1,3}){3}|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]+)$/.test(String((DestinationIP || destinationip || ''))) ? (DestinationIP || destinationip || '') : undefined)"
          },
          {
            "name": "DestinationPort",
            "value": "Number(DestinationPort || destinationport || 0)"
          },
          {
            "name": "Protocol",
            "value": "(Transport || transport || '').toUpperCase()"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-21)",
      "conf": {
        "add": [
          {
            "name": "SourceUserName",
            "value": "Email || email || ''"
          },
          {
            "name": "DeviceName",
            "value": "DeviceName || devicename || ''"
          },
          {
            "name": "RequestURL",
            "value": "SNI || sni || ''"
          },
          {
            "name": "SourceTranslatedAddress",
            "value": "SourceInternalIP || sourceinternalip || ''"
          },
          {
            "name": "DestinationTranslatedAddress",
            "value": "OverrideIP || overrideip || ''"
          },
          {
            "name": "ApplicationProtocol",
            "value": "(Transport || transport || '').toUpperCase()"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ncsc:cloudflare:gateway_network'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Force Sentinel TimeGenerated (required ingest-time column)",
      "conf": {
        "add": [
          {
            "name": "TimeGenerated",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}(\\.\\d+)?$/.test(String(log_time)) ? new Date(Number(log_time)).toISOString() : /^\\d{10}(\\.\\d+)?$/.test(String(log_time)) ? new Date(Number(log_time)*1000).toISOString() : new Date(log_time).toISOString()) : new Date(_time ? _time*1000 : Date.now()).toISOString()"
          }
        ]
      }
    }
