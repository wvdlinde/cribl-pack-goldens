{
  "key": "nginx_plus_access::ocsf",
  "sourcetype": "nginx_plus_access",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:58:59.631Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<src_ip>\\S+) - (?<user>\\S+) \\[(?<timestamp>[^\\]]+)\\] \"(?<http_method>\\S+) (?<url>\\S+) (?<http_version>[^\"]+)\" (?<status>\\d+) (?<bytes>\\d+) \"(?<referer>[^\"]*)\" \"(?<user_agent>[^\"]*)\" \"-\" rt=(?<request_time>\\S+) uct=\"(?<upstream_connect_time>[^\"]*)\" uht=\"(?<upstream_header_time>[^\"]*)\" urt=\"(?<upstream_response_time>[^\"]*)\" us=\"(?<upstream_status>[^\"]*)\" ua=\"(?<upstream_addr>[^\"]*)\"/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse nginx plus access log base fields (client IP, user, timestamp, request line, status, bytes, referer, user agent, upstream timing/addr)"
    },
    {
      "id": "regex_extract",
      "filter": "upstream_addr && upstream_addr !== '-'",
      "disabled": false,
      "conf": {
        "source": "upstream_addr",
        "regex": "/^(?<dst_ip>[^:]+):(?<dst_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Split upstream address into destination IP and port when present"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "user === '-' ? null : user"
          },
          {
            "name": "status",
            "value": "Number(status)"
          },
          {
            "name": "bytes",
            "value": "Number(bytes)"
          },
          {
            "name": "dst_port",
            "value": "dst_port ? Number(dst_port) : null"
          },
          {
            "name": "protocol",
            "value": "'http'"
          }
        ]
      },
      "description": "Normalize user field, cast numeric fields, set protocol"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "status >= 400 ? 'blocked' : 'allowed'"
          },
          {
            "name": "severity",
            "value": "status >= 500 ? 'high' : status >= 400 ? 'medium' : 'low'"
          }
        ]
      },
      "description": "Derive action and severity from HTTP status code"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'6001'"
          },
          {
            "name": "category_uid",
            "value": "'6'"
          },
          {
            "name": "event_type",
            "value": "'Web Proxy Activity'"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || (upstream_addr ? upstream_addr.split(':')[1] : 0))"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "upstream_addr && upstream_addr !== '-' ? upstream_addr.split(':')[0] : ''"
          },
          {
            "name": "actor.user.name",
            "value": "user && user !== '-' ? user : ''"
          },
          {
            "name": "http_request.url",
            "value": "url"
          },
          {
            "name": "http_request.http_method",
            "value": "http_method"
          },
          {
            "name": "http_request.user_agent",
            "value": "user_agent"
          },
          {
            "name": "http_response.code",
            "value": "Number(status)"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || 'HTTP'"
          },
          {
            "name": "time",
            "value": "Number(_time) * 1000"
          },
          {
            "name": "severity_id",
            "value": "Number(status) >= 500 ? 4 : Number(status) >= 400 ? 3 : 1"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "6001"
          },
          {
            "name": "category_uid",
            "value": "6"
          },
          {
            "name": "activity_id",
            "value": "1"
          },
          {
            "name": "type_uid",
            "value": "600101"
          },
          {
            "name": "category_name",
            "value": "'Network Activity'"
          },
          {
            "name": "metadata.product.name",
            "value": "'NGINX Plus'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'F5/NGINX'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          }
        ]
      },
      "description": "Map fields (continued 16-23)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'nginx:plus:access'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}