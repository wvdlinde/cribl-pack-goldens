{
  "key": "vmware_esxlog_settingsd::cim::__mapping__",
  "sourcetype": "vmware_esxlog_settingsd",
  "dest_format": "cim::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 379,
  "updated_at": "2026-08-07T15:37:54.833Z",
  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'network_traffic'"
          },
          {
            "name": "category_uid",
            "value": "'network'"
          },
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "message.match(/(?:from|via vCenter) (\\d{1,3}(?:\\.\\d{1,3}){3})/) ? message.match(/(?:from|via vCenter) (\\d{1,3}(?:\\.\\d{1,3}){3})/)[1] : ''"
          },
          {
            "name": "user",
            "value": "message.match(/User (\\S+)/) ? message.match(/User (\\S+)/)[1] : ''"
          },
          {
            "name": "dvc",
            "value": "message.match(/host (\\S+)/) ? message.match(/host (\\S+)/)[1] : ''"
          },
          {
            "name": "action",
            "value": "message.match(/failed authentication|unauthorized|Permission denied|ERROR/i) ? 'blocked' : (message.match(/successful|Applying|initiated|changed|loaded/i) ? 'allowed' : '')"
          },
          {
            "name": "signature",
            "value": "message.match(/^(WARNING|ERROR|SECURITY):?\\s*(.*)/i) ? message.match(/^(WARNING|ERROR|SECURITY):?\\s*(.*)/i)[2] : message"
          },
          {
            "name": "severity",
            "value": "message.match(/SECURITY/i) ? 'critical' : (message.match(/ERROR/i) ? 'high' : (message.match(/WARNING/i) ? 'medium' : 'informational'))"
          },
          {
            "name": "severity_id",
            "value": "message.match(/SECURITY/i) ? 5 : (message.match(/ERROR/i) ? 4 : (message.match(/WARNING/i) ? 3 : 1))"
          },
          {
            "name": "process",
            "value": "process || 'settingsd'"
          },
          {
            "name": "process_id",
            "value": "String(pid || '')"
          },
          {
            "name": "vendor_product",
            "value": "'VMware ESXi'"
          },
          {
            "name": "app",
            "value": "'settingsd'"
          },
          {
            "name": "transport",
            "value": "message.match(/to '(udp|tcp):\\/\\//i) ? message.match(/to '(udp|tcp):\\/\\//i)[1].toLowerCase() : ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "dest",
            "value": "message.match(/to '(?:udp|tcp):\\/\\/([\\d.]+):/i) ? message.match(/to '(?:udp|tcp):\\/\\/([\\d.]+):/i)[1] : ''"
          },
          {
            "name": "dest_port",
            "value": "message.match(/to '(?:udp|tcp):\\/\\/[\\d.]+:(\\d+)'/i) ? Number(message.match(/to '(?:udp|tcp):\\/\\/[\\d.]+:(\\d+)'/i)[1]) : null"
          },
          {
            "name": "rule",
            "value": "message.match(/'([A-Za-z0-9_.]+)' __e['with'] value|'([A-Za-z0-9_.]+)' changed/) ? (message.match(/'([A-Za-z0-9_.]+)'/) ? message.match(/'([A-Za-z0-9_.]+)'/)[1] : '') : ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware_esxlog_settingsd'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}