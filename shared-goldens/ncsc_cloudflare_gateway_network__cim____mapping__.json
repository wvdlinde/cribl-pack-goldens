          },
          {
            "name": "transport",
            "value": "(protocol || '').toLowerCase()"
          },
          {
            "name": "bytes_in",
            "value": "Number(bytes_received || 0)"
          },
          {
            "name": "bytes_out",
            "value": "Number(bytes_sent || 0)"
          },
          {
            "name": "user",
            "value": "String(user_email || '')"
          },
          {
            "name": "rule",
            "value": "String(policy_name || '')"
          },
          {
            "name": "session_id",
            "value": "String(session_id || '')"
          }
