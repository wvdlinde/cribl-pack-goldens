{
  "key": "email_fpc_metadata::ocsf",
  "sourcetype": "email_fpc_metadata",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:58:17.695Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<__kvp_body>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Split leading ISO timestamp from the KVP body of the raw email FPC metadata event"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp_body",
        "cleanFields": true
      },
      "description": "Extract space-delimited key=value pairs (sensor, event_id, src_ip, dst_ip, ports, protocol, sender, recipient, subject, attachment_name, mime_type, size_bytes, spf/dkim/dmarc, disposition, severity, action, threat_name, session_id, etc.) from the scratch KVP body field"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "protocol",
            "value": "protocol ? protocol.toUpperCase() : protocol"
          },
          {
            "name": "src_port",
            "value": "src_port ? Number(src_port) : src_port"
          },
          {
            "name": "dst_port",
            "value": "dst_port ? Number(dst_port) : dst_port"
          },
          {
            "name": "size_bytes",
            "value": "size_bytes ? Number(size_bytes) : size_bytes"
          },
          {
            "name": "user",
            "value": "sender && sender.length > 0 ? sender : recipient"
          },
          {
            "name": "direction",
            "value": "direction ? direction.toLowerCase() : direction"
          },
          {
            "name": "vendor_action",
            "value": "action || undefined"
          },
          {
            "name": "action",
            "value": "action ? action.toLowerCase() : action"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : severity"
          }
        ]
      },
      "description": "Normalize protocol casing, coerce numeric fields, derive user field from sender, and standardize direction/action values"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "is_ipv6",
            "value": "(src_ip && src_ip.indexOf(':') !== -1) || (dst_ip && dst_ip.indexOf(':') !== -1) ? true : false"
          }
        ],
        "remove": [
          "__kvp_body"
        ]
      },
      "description": "Flag email/message events with a source or destination IPv6 address for downstream handling"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "time",
            "value": "Date.parse(timestamp || _time) || Date.parse(_time)"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "traffic.bytes_out",
            "value": "direction == 'outbound' ? Number(size_bytes || 0) : 0"
          },
          {
            "name": "traffic.bytes_in",
            "value": "direction == 'inbound' ? Number(size_bytes || 0) : 0"
          },
          {
            "name": "actor.user.name",
            "value": "user || sender || ''"
          },
          {
            "name": "device.hostname",
            "value": "sensor || ''"
          },
          {
            "name": "severity_id",
            "value": "severity == 'critical' ? 5 : severity == 'high' ? 4 : severity == 'medium' ? 3 : severity == 'low' ? 2 : 0"
          },
          {
            "name": "class_uid",
            "value": "4001"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "1"
          },
          {
            "name": "type_uid",
            "value": "400101"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          },
          {
            "name": "metadata.product.name",
            "value": "'Email FPC'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Generic'"
          }
        ]
      },
      "description": "Map fields (continued 16-21)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'email_fpc_metadata'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
