  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<src_ip>\\S+) - (?<user>\\S+) \\[(?<timestamp>[^\\]]+)\\] \"(?<http_method>\\S+) (?<url>\\S+) (?<http_version>[^\"]+)\" (?<status>\\d+) (?<bytes>\\d+) \"(?<referer>[^\"]*)\" \"(?<user_agent>[^\"]*)\" \"-\" rt=(?<request_time>\\S+) uct=\"(?<upstream_connect_time>[^\"]*)\" uht=\"(?<upstream_header_time>[^\"]*)\" urt=\"(?<upstream_response_time>[^\"]*)\" us=\"(?<upstream_status>[^\"]*)\" ua=\"(?<upstream_addr>[^\"]*)\"/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse nginx plus access log base fields (client IP, user, timestamp, request line, status, bytes, referer, user agent, upstream timing/addr)"
    },
    {
      "id": "regex_extract",
      "filter": "upstream_addr && upstream_addr !== '-'",
      "disabled": false,
      "conf": {
        "source": "upstream_addr",
        "regex": "/^(?<dst_ip>[^:]+):(?<dst_port>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Split upstream address into destination IP and port when present"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "user === '-' ? null : user"
          },
          {
            "name": "status",
            "value": "Number(status)"
          },
          {
            "name": "bytes",
            "value": "Number(bytes)"
          },
          {
            "name": "dst_port",
            "value": "dst_port ? Number(dst_port) : null"
          },
          {
            "name": "protocol",
            "value": "'http'"
          }
        ]
      },
      "description": "Normalize user field, cast numeric fields, set protocol"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "status >= 400 ? 'blocked' : 'allowed'"
          },
          {
            "name": "severity",
            "value": "status >= 500 ? 'high' : status >= 400 ? 'medium' : 'low'"
          }
        ]
      },
      "description": "Derive action and severity from HTTP status code"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
