{
  "key": "vmware_esxlog_vsansystem::commonsecuritylog::__mapping__",
  "sourcetype": "vmware_esxlog_vsansystem",
  "dest_format": "commonsecuritylog::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 648,
  "updated_at": "2026-08-31T11:53:33.419Z",
  "functions": [
    {
      "id": "eval",
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'vsansystem'"
          },
          {
            "name": "category_uid",
            "value": "'Storage'"
          },
          {
            "name": "event_type",
            "value": "'vSAN System Event'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : new Date((_time || 0) * 1000).toISOString()"
          },
          {
            "name": "DeviceName",
            "value": "host || ''"
          },
          {
            "name": "DeviceVendor",
            "value": "'VMware'"
          },
          {
            "name": "DeviceProduct",
            "value": "'ESXi'"
          },
          {
            "name": "DeviceVersion",
            "value": "'vsansystem'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "component ? 'vsansystem:' + String(component).toLowerCase() : 'vsansystem:general'"
          },
          {
            "name": "Activity",
            "value": "action == 'failure' || action == 'failed' ? 'vSAN Operation Failed' : (action == 'success' ? 'vSAN Operation Succeeded' : (component ? String(component) + ' Status Report' : 'vSAN System Event'))"
          },
          {
            "name": "LogSeverity",
            "value": "(severity || '').toUpperCase() == 'ERROR' ? 8 : ((severity || '').toUpperCase() == 'CRITICAL' ? 9 : ((severity || '').toUpperCase() == 'WARNING' ? 6 : ((severity || '').toUpperCase() == 'DEBUG' ? 1 : 3)))"
          },
          {
            "name": "DeviceAction",
            "value": "action || ''"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || (/^\\d+\\.\\d+\\.\\d+\\.\\d+$/.test(host || '') ? host : '')"
          },
          {
            "name": "DestinationIP",
            "value": "/^\\d+\\.\\d+\\.\\d+\\.\\d+$/.test(dst_host || '') ? dst_host : ''"
          },
          {
            "name": "DestinationPort",
            "value": "Number(dst_port || 0)"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-19)",
      "conf": {
        "add": [
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "ApplicationProtocol",
            "value": "(component || '').toUpperCase() == 'RDT' ? 'RDT' : ((component || '').toUpperCase() == 'CMMDS' ? 'CMMDS' : '')"
          },
          {
            "name": "SourceTranslatedAddress",
            "value": "src_ip || ''"
          },
          {
            "name": "DestinationTranslatedAddress",
            "value": "/^\\d+\\.\\d+\\.\\d+\\.\\d+$/.test(dst_host || '') ? dst_host : ''"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware_esxlog_vsansystem'"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "unstructured",
      "keys": []
    }
  },
  "report": null
}