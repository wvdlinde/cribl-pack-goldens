{
  "key": "json_3::cim::__mapping__",
  "sourcetype": "json_3",
  "dest_format": "cim::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 379,
  "updated_at": "2026-08-07T15:47:21.359Z",
  "functions": [
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "event_type",
            "value": "'Network_Traffic'"
          },
          {
            "name": "src",
            "value": "event.csip || ''"
          },
          {
            "name": "src_port",
            "value": "Number(event.csport || 0)"
          },
          {
            "name": "dest",
            "value": "event.cdip || ''"
          },
          {
            "name": "dest_port",
            "value": "Number(event.cdport || 0)"
          },
          {
            "name": "src_translated_ip",
            "value": "event.ssip || ''"
          },
          {
            "name": "src_translated_port",
            "value": "Number(event.ssport || 0)"
          },
          {
            "name": "dest_translated_ip",
            "value": "event.sdip || ''"
          },
          {
            "name": "dest_translated_port",
            "value": "Number(event.sdport || 0)"
          },
          {
            "name": "transport",
            "value": "(event.proto || '').toLowerCase()"
          },
          {
            "name": "app",
            "value": "event.nwapp || ''"
          },
          {
            "name": "user",
            "value": "(event.user || '').replace(/%20/g,' ')"
          },
          {
            "name": "action",
            "value": "(event.action || '').toLowerCase().indexOf('allow') >= 0 ? 'allowed' : 'blocked'"
          },
          {
            "name": "bytes_in",
            "value": "Number(event.inbytes || 0)"
          },
          {
            "name": "bytes_out",
            "value": "Number(event.outbytes || 0)"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-23)",
      "conf": {
        "add": [
          {
            "name": "bytes",
            "value": "Number(event.inbytes || 0) + Number(event.outbytes || 0)"
          },
          {
            "name": "duration",
            "value": "Number(event.duration || 0)"
          },
          {
            "name": "rule",
            "value": "(event.rulelabel || '').replace(/%20/g,' ')"
          },
          {
            "name": "dvc",
            "value": "event.devicehostname || ''"
          },
          {
            "name": "category",
            "value": "event.ipcat || ''"
          },
          {
            "name": "signature",
            "value": "event.threatname && event.threatname !== 'None' ? event.threatname : ''"
          },
          {
            "name": "src_zone",
            "value": "(event.locationname || '').replace(/%20/g,' ')"
          },
          {
            "name": "vendor_product",
            "value": "'Zscaler NSS'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'json_3'"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}