  "functions": [
    {
      "id": "serde",
      "description": "Parse firewall key-value pairs from _raw into top-level fields.",
      "filter": "true",
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "_raw",
        "cleanFields": true,
        "allowedKeyChars": [
          "_"
        ],
        "allowedValueChars": [
          ".",
          ":",
          "/",
          "-"
        ],
        "overwrite": true
      }
    },
    {
      "id": "numerify",
      "description": "Convert numeric firewall counters and identifiers needed for calculations to numbers.",
      "filter": "true",
      "conf": {
        "depth": 5,
        "ignoreFields": [
          "device_name",
          "device_id",
          "log_id",
          "log_type",
          "log_component",
          "log_subtype",
          "status",
          "date",
