    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "authorizationInfo",
        "regex": "/\\{\"granted\":(?<__granted>[^,]+),\"permission\":\"(?<permission>[^\"]+)\",\"resource\":\"(?<authz_resource>[^\"]+)\"/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract first authorizationInfo entry fields (permission, granted, resource)"
