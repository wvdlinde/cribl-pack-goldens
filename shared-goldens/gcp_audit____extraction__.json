    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "logName",
        "regex": "/projects\\/(?<project_id>[^\\/]+)\\/logs\\/(?<log_type>.+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract project_id and log type from logName"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "user",
            "value": "principalEmail"
          },
          {
            "name": "src_ip",
            "value": "callerIp"
          },
          {
