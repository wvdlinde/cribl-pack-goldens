          },
          {
            "name": "resource",
            "value": "resourceName"
          },
          {
            "name": "granted",
            "value": "__granted == 'true' ? true : false"
          },
          {
            "name": "outcome",
            "value": "__granted == 'true' ? 'allow' : 'deny'"
          },
          {
            "name": "user_agent",
            "value": "callerSuppliedUserAgent"
          },
          {
            "name": "log_type",
            "value": "log_type ? decodeURIComponent(log_type) : log_type"
          },
          {
            "name": "timestamp",
            "value": "timestamp"
          }
        ],
        "remove": [
          "__granted",
          "principalEmail",
          "principalSubject",
          "callerIp",
          "methodName",
          "serviceName",
          "resourceName",
          "callerSuppliedUserAgent",
          "authenticationInfo",
          "requestMetadata",
          "authorizationInfo",
          "protoPayload",
          "requestAttributes",
          "destinationAttributes",
          "request",
          "resource",
          "_type",
          "serviceAccountKeyName"
        ]
      },
      "description": "Normalize fields to standard schema: user, src_ip, action, service, resource, severity, timestamp, granted, log_type"
    },
    {
      "id": "eval",
      "filter": "true",
