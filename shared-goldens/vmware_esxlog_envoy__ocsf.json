{
  "key": "vmware_esxlog_envoy::ocsf",
  "sourcetype": "vmware_esxlog_envoy",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:00:58.581Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<dst_host>\\S+)\\s+Envoy:\\s+\\[Originator@\\d+\\s+sub=(?<sub>\\w+)\\]\\s+(?:(?<severity>Info|Warning|Error):\\s+)?(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse base Envoy log structure: timestamp, host, sub-component, optional severity, and message"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.startsWith('Accepted TCP connection')",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/Accepted TCP connection from (?<__src_addr>\\[[0-9a-fA-F:]+\\]|[\\d.]+):(?<src_port>\\d+) to (?<__dst_addr>\\[[0-9a-fA-F:]+\\]|[\\d.]+):(?<dst_port>\\d+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract src/dst address:port for accepted TCP connections"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.startsWith('Request')",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/Request (?<http_method>\\w+) (?<url>\\S+) from (?<__src_addr>\\[[0-9a-fA-F:]+\\]|[\\d.]+):(?<src_port>\\d+) completed with status (?<status>\\d+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract HTTP request method, url, client address:port and response status"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.startsWith('Authentication failed')",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/Authentication failed for user (?<user>\\S+) from (?<__src_addr>\\[[0-9a-fA-F:]+\\]|[\\d.]+):(?<src_port>\\d+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract user and client address:port for failed authentication events"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "__src_addr ? __src_addr.replace(/[\\[\\]]/g,'') : undefined"
          },
          {
            "name": "dst_ip",
            "value": "__dst_addr ? __dst_addr.replace(/[\\[\\]]/g,'') : undefined"
          },
          {
            "name": "protocol",
            "value": "'tcp'"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : 'info'"
          },
          {
            "name": "action",
            "value": "message && message.startsWith('Accepted') ? 'accepted' : message && message.startsWith('Authentication failed') ? 'denied' : message && message.startsWith('Request') ? 'completed' : severity === 'Error' ? 'error' : severity === 'Warning' ? 'warning' : 'info'"
          },
          {
            "name": "direction",
            "value": "src_ip && dst_ip ? 'inbound' : undefined"
          }
        ],
        "remove": [
          "__src_addr",
          "__dst_addr"
        ]
      },
      "description": "Normalize IP fields (strip IPv6 brackets), set protocol/action/severity/direction, and clean up scratch fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "time",
            "value": "Math.round((_time || Date.parse(timestamp) / 1000) * 1000)"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "(action || '').toLowerCase() == 'accepted' ? 1 : ((action || '').toLowerCase() == 'closed' ? 2 : ((action || '').toLowerCase() == 'failed' || (action || '').toLowerCase() == 'blocked' ? 4 : ((action || '').toLowerCase() == 'refused' || (action || '').toLowerCase() == 'throttled' ? 5 : 6)))"
          },
          {
            "name": "type_uid",
            "value": "400100 + ((action || '').toLowerCase() == 'accepted' ? 1 : ((action || '').toLowerCase() == 'closed' ? 2 : ((action || '').toLowerCase() == 'failed' || (action || '').toLowerCase() == 'blocked' ? 4 : ((action || '').toLowerCase() == 'refused' || (action || '').toLowerCase() == 'throttled' ? 5 : 6))))"
          },
          {
            "name": "severity_id",
            "value": "(severity || vendor_severity || 'info').toLowerCase() == 'error' ? 4 : ((severity || vendor_severity || 'info').toLowerCase() == 'warning' ? 3 : ((severity || vendor_severity || 'info').toLowerCase() == 'critical' ? 5 : ((severity || vendor_severity || 'info').toLowerCase() == 'debug' ? 1 : 2)))"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip || ''"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "device.hostname",
            "value": "dst_host || ''"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol ? String(protocol).toLowerCase() : (src_port || dst_port ? 'tcp' : '')"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.product.name",
            "value": "'VMware ESXi Envoy' + (sub ? ' (' + sub + ')' : '')"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'VMware'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          }
        ]
      },
      "description": "Map fields (continued 16-18)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware:esxlog:envoy'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}