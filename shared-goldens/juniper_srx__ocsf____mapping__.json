{
  "key": "juniper_srx::ocsf::__mapping__",
  "sourcetype": "juniper_srx",
  "dest_format": "ocsf::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "push",
  "build": 0,
  "updated_at": "2026-08-07T13:00:17.084Z",
  "functions": [
    {
      "id": "regex_extract",
      "description": "Extract syslog header fields and Junos structured-data key/value payload.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^<\\d+>1\\s+(?<event_time>\\S+)/gm",
        "regexList": [
          {
            "regex": "/^<\\d+>1\\s+\\S+\\s+(?<device>\\S+)/gm"
          },
          {
            "regex": "/^<\\d+>1\\s+\\S+\\s+\\S+\\s+\\S+\\s+-\\s+(?<event_name>\\S+)/gm"
          },
          {
            "regex": "/\\[junos@[^\\s]+\\s+(?<kv_str>[^\\]]+)\\]$/gm"
          }
        ]
      }
    },
    {
      "id": "serde",
      "description": "Parse Junos structured-data key/value pairs into an object.",
      "filter": "kv_str != null",
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "kv_str",
        "dstField": "junos",
        "cleanFields": true,
        "overwrite": true
      }
    },
    {
      "id": "auto_timestamp",
      "description": "Extract event occurrence time from the syslog timestamp into OCSF time.",
      "conf": {
        "srcField": "_raw",
        "dstField": "time",
        "defaultTimezone": "UTC"
      }
    },
    {
      "id": "eval",
      "description": "Populate target OCSF fields and retain source-specific fields under unmapped.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "message",
            "value": "event_name"
          },
          {
            "name": "status_code",
            "value": "event_name"
          },
          {
            "name": "status_id",
            "value": "event_name==='RT_FLOW_SESSION_CREATE'?1:(event_name==='RT_FLOW_SESSION_DENY'?2:0)"
          },
          {
            "name": "status_detail",
            "value": "junos && junos.policy_name ? junos.policy_name : event_name"
          },
          {
            "name": "unmapped",
            "value": "{}"
          },
          {
            "name": "unmapped.device",
            "value": "device"
          },
          {
            "name": "unmapped.event_time",
            "value": "event_time"
          },
          {
            "name": "unmapped.junos",
            "value": "junos"
          }
        ]
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract Juniper SRX RT_FLOW header and key-value fields needed for OCSF mapping.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^<(?<syslog_pri>\\d+)>/gm",
        "regexList": [
          {
            "regex": "/^<\\d+>\\d+\\s+(?<event_time>\\S+)/gm"
          },
          {
            "regex": "/^<\\d+>\\d+\\s+\\S+\\s+(?<device_name>\\S+)/gm"
          },
          {
            "regex": "/^<\\d+>\\d+\\s+\\S+\\s+\\S+\\s+\\S+\\s+-\\s+(?<event_action>\\S+)/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])source-address=\\\"(?<src_ip>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])destination-address=\\\"(?<dst_ip>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])destination-port=\\\"(?<dst_port>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])service-name=\\\"(?<service_name>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])protocol-id=\\\"(?<protocol_id>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])policy-name=\\\"(?<policy_name>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])destination-zone-name=\\\"(?<dst_zone>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])session-id-32=\\\"(?<session_id>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/(?:^|[\\s\\[])application=\\\"(?<application>[^\\\"]+)\\\"/gm"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Create OCSF Network Activity fields from extracted Juniper SRX values.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "status",
            "value": "event_action==='RT_FLOW_SESSION_DENY'?'Failure':'Success'"
          },
          {
            "name": "activity_id",
            "value": "event_action==='RT_FLOW_SESSION_CREATE'?1:event_action==='RT_FLOW_SESSION_CLOSE'?2:event_action==='RT_FLOW_SESSION_DENY'?5:99"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "severity_id",
            "value": "syslog_pri%8<=2?5:syslog_pri%8===3?4:syslog_pri%8===4?3:syslog_pri%8===5?2:1"
          },
          {
            "name": "timezone_offset",
            "value": "event_time && event_time.endsWith('Z')?0:null"
          },
          {
            "name": "dst_endpoint",
            "value": "{}"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "dst_ip"
          },
          {
            "name": "dst_endpoint.port",
            "value": "dst_port"
          },
          {
            "name": "dst_endpoint.svc_name",
            "value": "service_name"
          },
          {
            "name": "dst_endpoint.name",
            "value": "dst_zone"
          },
          {
            "name": "dst_endpoint.uid",
            "value": "session_id"
          },
          {
            "name": "url",
            "value": "{}"
          },
          {
            "name": "url.scheme",
            "value": "application==='HTTPS'?'https':service_name && service_name.indexOf('https')>=0?'https':service_name && service_name.indexOf('http')>=0?'http':null"
          },
          {
            "name": "url.port",
            "value": "dst_port"
          },
          {
            "name": "observables",
            "value": "[]"
          }
        ]
      }
    },
    {
      "id": "numerify",
      "description": "Convert OCSF numeric fields and ports from strings to numbers.",
      "filter": "true",
      "conf": {
        "depth": 5,
        "ignoreFields": [],
        "filterExpr": "name==='activity_id'||name==='class_uid'||name==='severity_id'||name==='timezone_offset'||name==='dst_endpoint.port'||name==='url.port'||name==='observables[0].type_id'||name==='observables[1].type_id'",
        "format": "none",
        "digits": 2
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract Juniper SRX syslog header and RT_FLOW key-value fields needed for OCSF mapping.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^<\\d+>1\\s+(?<event_time>\\S+)\\s+(?<device_name>\\S+)\\s+(?<log_name>\\S+)\\s+\\S+\\s+(?<event_action>\\S+)/gm",
        "regexList": [
          {
            "regex": "/[\\s\\[]source-address=\\\"(?<src_ip>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]source-port=\\\"(?<src_port>\\d+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]destination-address=\\\"(?<dst_ip>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]protocol-id=\\\"(?<protocol_num>\\d+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]source-zone-name=\\\"(?<source_zone_name>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]destination-zone-name=\\\"(?<destination_zone_name>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]session-id-32=\\\"(?<session_uid>[^\\\"]+)\\\"/gm"
          },
          {
            "regex": "/[\\s\\[]packet-incoming-interface=\\\"(?<src_interface_name>[^\\\"]+)\\\"/gm"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Create OCSF Network Activity fields from extracted SRX RT_FLOW values.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "type_uid",
            "value": "event_action==='RT_FLOW_SESSION_CREATE'?400101:(event_action==='RT_FLOW_SESSION_DENY'?400104:400100)"
          },
          {
            "name": "src_endpoint",
            "value": "{}"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip"
          },
          {
            "name": "src_endpoint.port",
            "value": "src_port"
          },
          {
            "name": "src_endpoint.interface_name",
            "value": "src_interface_name"
          },
          {
            "name": "is_src_dst_assignment_known",
            "value": "true"
          },
          {
            "name": "connection_info",
            "value": "{}"
          },
          {
            "name": "connection_info.direction_id",
            "value": "source_zone_name==='trust'&&destination_zone_name==='untrust'?2:(source_zone_name==='untrust'&&destination_zone_name==='trust'?1:(source_zone_name===destination_zone_name?3:0))"
          },
          {
            "name": "connection_info.boundary_id",
            "value": "source_zone_name==='trust'&&destination_zone_name==='untrust'?3:(source_zone_name==='untrust'&&destination_zone_name==='trust'?3:(source_zone_name===destination_zone_name?2:0))"
          },
          {
            "name": "connection_info.protocol_num",
            "value": "protocol_num"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol_num==='6'?'tcp':(protocol_num==='17'?'udp':(protocol_num==='1'?'icmp':null))"
          },
          {
            "name": "connection_info.protocol_ver_id",
            "value": "(src_ip && src_ip.indexOf(':')>=0) || (dst_ip && dst_ip.indexOf(':')>=0) ? 6 : 4"
          },
          {
            "name": "connection_info.uid",
            "value": "session_uid"
          },
          {
            "name": "metadata",
            "value": "{}"
          },
          {
            "name": "metadata.log_name",
            "value": "log_name"
          },
          {
            "name": "metadata.original_time",
            "value": "event_time"
          },
          {
            "name": "metadata.product",
            "value": "{}"
          },
          {
            "name": "metadata.product.name",
            "value": "'SRX Series Services Gateway'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Juniper Networks'"
          },
          {
            "name": "metadata.reporter",
            "value": "{}"
          },
          {
            "name": "metadata.reporter.name",
            "value": "device_name"
          },
          {
            "name": "metadata.version",
            "value": "'1.8.0'"
          }
        ],
        "keep": [
          "type_uid",
          "src_endpoint.*",
          "metadata.*",
          "is_src_dst_assignment_known",
          "connection_info.*"
        ],
        "remove": [
          "_raw",
          "_time",
          "event_time",
          "device_name",
          "log_name",
          "event_action",
          "src_ip",
          "src_port",
          "dst_ip",
          "protocol_num",
          "source_zone_name",
          "destination_zone_name",
          "session_uid",
          "src_interface_name"
        ]
      }
    },
    {
      "id": "numerify",
      "description": "Convert numeric OCSF fields parsed from strings into numbers.",
      "filter": "true",
      "conf": {
        "depth": 5,
        "filterExpr": "name==='src_endpoint.port'||name==='connection_info.protocol_num'||name==='connection_info.direction_id'||name==='connection_info.boundary_id'||name==='connection_info.protocol_ver_id'||name==='type_uid'",
        "format": "none"
      }
    }
  ],
  "recipe": null,
  "report": null
}