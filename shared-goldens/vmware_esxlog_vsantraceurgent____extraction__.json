{
  "key": "vmware_esxlog_vsantraceurgent::__extraction__",
  "sourcetype": "vmware_esxlog_vsantraceurgent",
  "dest_format": "__extraction__",
  "score": 92,
  "part": "extraction",
  "author": "push",
  "build": 0,
  "updated_at": "2026-09-01T11:57:15.622Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse RFC5424 syslog header and vsantrace module/message from _raw",
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<syslog_pri>\\d+)>(?<syslog_ver>\\d)\\s+(?<timestamp>\\S+)\\s+(?<dst_host>\\S+)\\s+(?<app_name>\\S+)\\s+-\\s+-\\s+-\\s+vsantrace:\\s*(?<module>[^:]+):\\s*(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Derive numeric and text severity from syslog PRI value (facility*8+severity)",
      "conf": {
        "add": [
          {
            "name": "__sev_num",
            "value": "syslog_pri % 8"
          },
          {
            "name": "severity",
            "value": "__sev_num==0?'emergency':__sev_num==1?'alert':__sev_num==2?'critical':__sev_num==3?'error':__sev_num==4?'warning':__sev_num==5?'notice':__sev_num==6?'info':'debug'"
          }
        ],
        "remove": [
          "__sev_num"
        ]
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.length > 0",
      "disabled": false,
      "description": "Extract source IP (IPv4 or IPv6) and optional port referenced in the vsantrace message",
      "conf": {
        "source": "message",
        "regex": "/(?<src_ip>(?:\\d{1,3}\\.){3}\\d{1,3}|[0-9a-fA-F]{1,4}(?::[0-9a-fA-F]{0,4}){2,7})(?::(?<src_port>\\d+))?/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Classify vSAN trace event action based on message content keywords",
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message.match(/blocking traffic/) ? 'blocked' : message.match(/rejected/) ? 'rejected' : message.match(/removed from cluster/) ? 'removed' : message.match(/completed successfully/) ? 'completed' : message.match(/failure|inaccessible|lost quorum|data loss/) ? 'failed' : 'observed'"
          },
          {
            "name": "protocol",
            "value": "'vsan'"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "unstructured",
      "keys": []
    }
  },
  "report": null
}