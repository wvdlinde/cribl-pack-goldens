{
  "key": "aemerror::__extraction__",
  "sourcetype": "aemerror",
  "dest_format": "__extraction__",
  "score": 93,
  "part": "extraction",
  "author": "push",
  "build": 0,
  "updated_at": "2026-09-16T11:08:27.787Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse AEM error.log base structure: timestamp, level, request context, logger class, message",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<__date>\\d{2}\\.\\d{2}\\.\\d{4}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3})\\s+\\*(?<log_level>[A-Z]+)\\*\\s+\\[\\s*(?<src_ip>[^\\s\\[\\]]*)\\s*\\[(?<request_id>\\d+)\\]\\s+(?<http_method>[A-Z]+)\\s+(?<uri_path>\\S+)\\s+(?<http_version>[^\\]]+?)\\]\\s+(?<logger_class>\\S+)\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && /\\d{1,3}(?:\\.\\d{1,3}){3}:\\d{1,5}/.test(message)",
      "disabled": false,
      "description": "Extract target host and port from messages referencing a downstream endpoint",
      "conf": {
        "source": "message",
        "regex": "/(?<dst_ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?<dst_port>\\d{1,5})/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize timestamp, severity, protocol, action and IPv6 loopback; clean scratch fields",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "request_id ? Math.round(Number(request_id)/1000) : _time"
          },
          {
            "name": "timestamp",
            "value": "__date"
          },
          {
            "name": "severity",
            "value": "log_level == 'ERROR' ? 'high' : (log_level == 'WARN' ? 'medium' : (log_level == 'INFO' ? 'informational' : 'low'))"
          },
          {
            "name": "protocol",
            "value": "http_version ? http_version.split('/')[0].toLowerCase() : 'http'"
          },
          {
            "name": "http_version",
            "value": "http_version ? http_version.split('/')[1] : http_version"
          },
          {
            "name": "src_ip",
            "value": "src_ip ? (src_ip == '0:0:0:0:0:0:0:1' ? '::1' : src_ip) : null"
          },
          {
            "name": "dst_port",
            "value": "dst_port ? Number(dst_port) : null"
          },
          {
            "name": "action",
            "value": "log_level == 'ERROR' ? 'failure' : (log_level == 'WARN' ? 'warning' : 'success')"
          },
          {
            "name": "app",
            "value": "'aem'"
          }
        ],
        "remove": [
          "__date"
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "unstructured",
      "keys": []
    }
  },
  "report": null
}