{
  "key": "aemerror::__extraction__",
  "sourcetype": "aemerror",
  "dest_format": "__extraction__",
  "score": 90,
  "part": "extraction",
  "author": "unknown",
  "build": 378,
  "updated_at": "2026-08-07T13:05:43.733Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Extract timestamp, severity, thread, logger and message from AEM error log line",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\d{2}\\.\\d{2}\\.\\d{4} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}) \\*(?<severity>\\w+)\\* \\[(?<thread>[^\\]]+)\\] (?<logger>\\S+) (?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/from external IP/)",
      "disabled": false,
      "description": "Extract source IP from brute-force/login attack messages",
      "conf": {
        "source": "message",
        "regex": "/from external IP (?<src_ip>\\d{1,3}(?:\\.\\d{1,3}){3})/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/^Asset (created at|uploaded successfully:) /)",
      "disabled": false,
      "description": "Extract asset path for asset creation/upload events",
      "conf": {
        "source": "message",
        "regex": "/^Asset (?:created at|uploaded successfully:) (?<asset_path>\\S+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Classify action based on message content and normalize severity",
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message && message.match(/brute force/) ? 'blocked' : message && message.match(/created|uploaded successfully/) ? 'allowed' : 'info'"
          },
          {
            "name": "category",
            "value": "message && message.match(/login attempts/) ? 'authentication' : message && message.match(/Asset/) ? 'asset_management' : message && message.match(/Job queue/) ? 'job_management' : 'general'"
          },
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : severity"
          }
        ]
      }
    }
  ],
  "recipe": null,
  "report": null
}