          },
          {
            "name": "DeviceEventClassID",
            "value": "component || 'sandboxd'"
          },
          {
            "name": "Activity",
            "value": "message && message.match(/(Successfully created sandbox|Sandbox permission check failed|Destroying sandbox|Failed to create sandbox|chroot jail established|escape attempt detected|restart requested|Unable to resolve hostname)/) ? message.match(/(Successfully created sandbox|Sandbox permission check failed|Destroying sandbox|Failed to create sandbox|chroot jail established|escape attempt detected|restart requested|Unable to resolve hostname)/)[0] : 'Sandbox Event'"
          },
          {
            "name": "DeviceAction",
