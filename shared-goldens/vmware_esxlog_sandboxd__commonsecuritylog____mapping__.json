          },
          {
            "name": "LogSeverity",
            "value": "severity == 'Critical' ? 10 : severity == 'Error' ? 7 : severity == 'Warning' ? 4 : severity == 'Info' ? 2 : 0"
          },
          {
            "name": "DeviceName",
            "value": "host || ''"
          },
          {
