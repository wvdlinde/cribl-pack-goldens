{
  "key": "ldap_access_log::ocsf",
  "sourcetype": "ldap_access_log",
  "dest_format": "ocsf",
  "score": 90,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T15:03:09.479Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<src_ip>\\S+) - (?<user>\\S+) \\[(?<timestamp>[^\\]]+)\\] \"(?<http_method>\\S+) (?<uri_path>\\S+) HTTP\\/[\\d.]+\" (?<status_code>\\d+) (?<bytes>\\d+) \"(?<referer>[^\"]*)\" \"(?<user_agent>[^\"]*)\"$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse combined-log-style LDAP access log into base fields"
    },
    {
      "id": "regex_extract",
      "filter": "uri_path && uri_path.indexOf('bind')>-1",
      "disabled": false,
      "conf": {
        "source": "uri_path",
        "regex": "/dn=(?<ldap_dn>[^&\\s]+)/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract LDAP DN from bind requests"
    },
    {
      "id": "regex_extract",
      "filter": "uri_path && uri_path.indexOf('search')>-1",
      "disabled": false,
      "conf": {
        "source": "uri_path",
        "regex": "/base=(?<ldap_base>[^&\\s]+)(&filter=(?<ldap_filter>[^\\s]+))?/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract LDAP search base and filter from search requests"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "status_code && Number(status_code) < 400 ? 'success' : 'failure'"
          },
          {
            "name": "protocol",
            "value": "'http'"
          },
          {
            "name": "ldap_operation",
            "value": "uri_path && uri_path.indexOf('bind')>-1 ? 'bind' : uri_path && uri_path.indexOf('search')>-1 ? 'search' : uri_path && uri_path.indexOf('entry')>-1 ? 'entry' : uri_path && uri_path.indexOf('modify')>-1 ? 'modify' : uri_path && uri_path.indexOf('whoami')>-1 ? 'whoami' : uri_path && uri_path.indexOf('sync')>-1 ? 'sync' : 'other'"
          },
          {
            "name": "severity",
            "value": "status_code && Number(status_code) >= 500 ? 'error' : status_code && Number(status_code) >= 400 ? 'warn' : 'info'"
          }
        ],
        "remove": []
      },
      "description": "Classify action, protocol, and LDAP operation type based on status code and URI path"
    },
    {
      "id": "eval",
      "filter": "timestamp",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "strptime(timestamp, '%d/%b/%Y:%H:%M:%S %z')"
          }
        ],
        "remove": []
      },
      "description": "Convert Apache-style timestamp string into epoch _time"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4002'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'HTTP Activity'"
          },
          {
            "name": "class_uid",
            "value": "4002"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "category_name",
            "value": "'Network Activity'"
          },
          {
            "name": "activity_id",
            "value": "(http_method || '').toUpperCase() == 'GET' ? 3 : (http_method || '').toUpperCase() == 'POST' ? 6 : (http_method || '').toUpperCase() == 'PUT' ? 7 : (http_method || '').toUpperCase() == 'DELETE' ? 2 : (http_method || '').toUpperCase() == 'HEAD' ? 4 : (http_method || '').toUpperCase() == 'OPTIONS' ? 5 : (http_method || '').toUpperCase() == 'TRACE' ? 8 : (http_method || '').toUpperCase() == 'PATCH' ? 9 : 0"
          },
          {
            "name": "type_uid",
            "value": "400200 + ((http_method || '').toUpperCase() == 'GET' ? 3 : (http_method || '').toUpperCase() == 'POST' ? 6 : (http_method || '').toUpperCase() == 'PUT' ? 7 : (http_method || '').toUpperCase() == 'DELETE' ? 2 : (http_method || '').toUpperCase() == 'HEAD' ? 4 : (http_method || '').toUpperCase() == 'OPTIONS' ? 5 : (http_method || '').toUpperCase() == 'TRACE' ? 8 : (http_method || '').toUpperCase() == 'PATCH' ? 9 : 0)"
          },
          {
            "name": "severity_id",
            "value": "(severity || '').toLowerCase() == 'critical' ? 5 : (severity || '').toLowerCase() == 'high' ? 4 : (severity || '').toLowerCase() == 'medium' ? 3 : (severity || '').toLowerCase() == 'low' ? 2 : Number(status_code || 0) >= 500 ? 4 : Number(status_code || 0) >= 400 ? 3 : 1"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "actor.user.name",
            "value": "user && user != '-' ? user : ''"
          },
          {
            "name": "http_request.url",
            "value": "uri_path || ''"
          },
          {
            "name": "http_request.http_method",
            "value": "(http_method || '').toUpperCase()"
          },
          {
            "name": "http_request.user_agent",
            "value": "user_agent && user_agent != '-' ? user_agent : ''"
          },
          {
            "name": "http_response.code",
            "value": "Number(status_code || 0)"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "traffic.bytes_out",
            "value": "Number(bytes || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol ? String(protocol).split('/')[0].toLowerCase() : 'http'"
          },
          {
            "name": "time",
            "value": "Number(new Date(String(timestamp || '').replace(/^(\\d{2})\\/(\\w{3})\\/(\\d{4}):/, '$1 $2 $3 ')).getTime()) || 0"
          },
          {
            "name": "metadata.product.name",
            "value": "'LDAP Access Log'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Generic'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          }
        ]
      },
      "description": "Map fields (continued 16-21)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ldap_access_log'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
