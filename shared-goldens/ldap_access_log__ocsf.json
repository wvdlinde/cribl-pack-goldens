          },
          {
            "name": "protocol",
            "value": "'http'"
          },
          {
            "name": "ldap_operation",
            "value": "uri_path && uri_path.indexOf('bind')>-1 ? 'bind' : uri_path && uri_path.indexOf('search')>-1 ? 'search' : uri_path && uri_path.indexOf('entry')>-1 ? 'entry' : uri_path && uri_path.indexOf('modify')>-1 ? 'modify' : uri_path && uri_path.indexOf('whoami')>-1 ? 'whoami' : uri_path && uri_path.indexOf('sync')>-1 ? 'sync' : 'other'"
          },
          {
            "name": "severity",
            "value": "status_code && Number(status_code) >= 500 ? 'error' : status_code && Number(status_code) >= 400 ? 'warn' : 'info'"
