          {
            "name": "signature",
            "value": "(_raw || '').match(/\\)\\s+error\\s+\\(/) ? 'Cron Error' : ((_raw || '').match(/\\)\\s+CMD\\s+\\(/) ? 'Cron Command' : '')"
          },
          {
            "name": "severity",
            "value": "(_raw || '').match(/\\)\\s+error\\s+\\(/) ? 'error' : 'informational'"
          },
          {
            "name": "severity_id",
            "value": "(_raw || '').match(/\\)\\s+error\\s+\\(/) ? 3 : 6"
          },
          {
            "name": "category",
            "value": "(_raw || '').match(/\\)\\s+error\\s+\\(/) ? 'scheduled_task_error' : 'scheduled_task_execution'"
          },
          {
            "name": "vendor_product",
            "value": "'cron'"
          }
        ]
      }
    },
