          "device_group_hierarchy_level_3",
          "device_group_hierarchy_level_4",
          "virtual_system_name",
          "device_name",
          "future_use_4",
          "source_vm_uuid",
          "destination_vm_uuid",
          "http_method",
          "tunnel_id_imsi",
          "monitor_tag_imei",
