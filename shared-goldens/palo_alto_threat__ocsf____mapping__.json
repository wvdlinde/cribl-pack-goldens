          "parent_start_time",
          "tunnel_type",
          "threat_category",
          "content_version",
          "future_use_5",
          "sctp_association_id",
          "payload_protocol_id",
          "http_headers"
        ],
        "keep": [],
        "remove": [],
        "overwrite": true,
        "cleanFields": true
      }
    },
    {
      "id": "auto_timestamp",
      "description": "Parse generated_time into OCSF time field.",
      "conf": {
        "srcField": "parsedData.generated_time",
        "dstField": "time",
        "defaultTimezone": "UTC",
        "timestamps": [
          {
            "regex": "/(\\d{4}\\/\\d{2}\\/\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})/",
            "strptime": "%Y/%m/%d %H:%M:%S"
          }
        ],
        "timeExpression": "time.getTime() / 1000",
        "offset": 0,
        "maxLen": 64,
        "defaultTime": "now",
        "earliestDateAllowed": "-420weeks",
        "latestDateAllowed": "+1week"
      }
    },
    {
      "id": "eval",
      "description": "Create OCSF HTTP Activity target schema fields from parsed Palo Alto threat data.",
      "filter": "parsedData != null",
      "conf": {
        "add": [
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "message",
            "value": "parsedData.url_filename ? parsedData.url_filename : _raw"
          },
          {
            "name": "status_code",
            "value": "parsedData.action ? parsedData.action : null"
          },
          {
            "name": "status_detail",
            "value": "parsedData.severity ? parsedData.severity : null"
          },
          {
            "name": "unmapped",
            "value": "parsedData"
          }
        ]
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract CSV payload from syslog-prefixed Palo Alto threat log.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\S+\\s+(?<csv_payload>\\d+,[\\s\\S]*)$/gm"
      }
    },
    {
      "id": "serde",
      "description": "Parse Palo Alto Threat CSV fields into parsedData.",
      "filter": "csv_payload",
      "conf": {
        "mode": "extract",
        "type": "csv",
        "srcField": "csv_payload",
        "dstField": "parsedData",
        "fields": [
          "future_use_0",
          "receive_time",
          "serial_number",
          "type",
