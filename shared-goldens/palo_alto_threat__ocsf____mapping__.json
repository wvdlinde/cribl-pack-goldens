        "cleanFields": true
      }
    },
    {
      "id": "numerify",
      "description": "Convert parsed port fields to numbers for endpoint and observable mappings.",
      "filter": "true",
      "conf": {
        "depth": 5,
        "ignoreFields": [],
        "filterExpr": "name.indexOf('port')>=0",
        "format": "none",
        "digits": 2
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract URL host, path, and query components from the Palo Alto URL field.",
      "filter": "parsedData && parsedData.url_filename",
      "conf": {
        "source": "parsedData.url_filename",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<url_hostname>[^\\/?#:]+).*$/gm",
        "regexList": [
          {
            "regex": "/^[^\\/?#:]+(?<url_path>\\/[^?#]*)/gm"
          },
          {
            "regex": "/\\?(?<url_query>[^#]*)/gm"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map parsed Palo Alto threat URL fields to OCSF HTTP Activity target fields.",
      "filter": "true",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "4002"
          },
          {
            "name": "activity_id",
            "value": "parsedData.http_method==='CONNECT'?1:parsedData.http_method==='DELETE'?2:parsedData.http_method==='GET'?3:parsedData.http_method==='HEAD'?4:parsedData.http_method==='OPTIONS'?5:parsedData.http_method==='POST'?6:parsedData.http_method==='PUT'?7:parsedData.http_method==='TRACE'?8:parsedData.http_method==='PATCH'?9:0"
          },
          {
            "name": "status_id",
            "value": "parsedData.action && (parsedData.action.indexOf('block')>=0 || parsedData.action.indexOf('deny')>=0 || parsedData.action.indexOf('drop')>=0 || parsedData.action.indexOf('reset')>=0) ? 2 : parsedData.action ? 1 : 0"
          },
          {
            "name": "status",
            "value": "status_id===2?'Failure':status_id===1?'Success':'Unknown'"
          },
          {
            "name": "timezone_offset",
            "value": "0"
          },
          {
            "name": "dst_endpoint",
            "value": "{}"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "parsedData.destination_ip"
          },
          {
            "name": "dst_endpoint.port",
            "value": "parsedData.destination_port"
          },
          {
            "name": "dst_endpoint.interface_name",
            "value": "parsedData.outbound_interface"
          },
          {
            "name": "dst_endpoint.type_id",
            "value": "1"
          },
          {
            "name": "http_request",
            "value": "{}"
          },
          {
            "name": "http_request.http_method",
            "value": "parsedData.http_method && parsedData.http_method!=='N/A' ? parsedData.http_method : null"
          },
          {
            "name": "http_request.user_agent",
            "value": "parsedData.user_agent ? parsedData.user_agent : null"
          },
          {
            "name": "http_request.url",
            "value": "{}"
          },
          {
            "name": "http_request.url.hostname",
            "value": "url_hostname"
          },
          {
            "name": "http_request.url.path",
            "value": "url_path ? url_path : null"
          },
          {
            "name": "http_request.url.query_string",
            "value": "url_query ? url_query : null"
          },
          {
            "name": "http_request.url.scheme",
            "value": "parsedData.destination_port===443 || parsedData.application==='ssl' ? 'https' : parsedData.destination_port===80 || parsedData.application==='web-browsing' ? 'http' : null"
          },
          {
            "name": "http_request.url.url_string",
            "value": "http_request.url.scheme ? http_request.url.scheme + '://' + parsedData.url_filename : parsedData.url_filename"
          },
          {
            "name": "http_request.url.category_ids",
            "value": "parsedData.category==='business-and-economy'?[21]:parsedData.category==='informational'?[107]:parsedData.category==='not-defined'?[0]:[99]"
          },
          {
            "name": "observables",
            "value": "[{name:'dst_endpoint.ip',type_id:2},{name:'dst_endpoint.port',type_id:11},{name:'http_request.url',type_id:23},{name:'http_request.url.url_string',type_id:6}]"
          }
        ]
      }
    },
    {
      "id": "regex_extract",
      "description": "Extract syslog prefix and Palo Alto CSV payload.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^(?<syslog_time>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<reporter_name>\\S+)\\s+(?<pan_payload>\\d+,.*)$/gm"
      }
    },
    {
      "id": "serde",
      "description": "Parse Palo Alto Threat CSV payload into pan object.",
      "filter": "pan_payload != null",
      "conf": {
        "mode": "extract",
        "type": "csv",
        "srcField": "pan_payload",
        "dstField": "pan",
        "fields": [
          "future_use_0",
          "receive_time",
          "serial_number",
          "type",
          "threat_content_type",
          "future_use_1",
          "generated_time",
          "source_ip",
          "destination_ip",
