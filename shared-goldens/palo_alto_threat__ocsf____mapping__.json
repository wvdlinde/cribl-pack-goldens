          "content_version",
          "future_use_5",
          "sctp_association_id",
          "payload_protocol_id",
          "http_headers"
        ],
        "keep": [],
        "remove": [],
        "overwrite": true,
        "cleanFields": true
      }
    },
    {
      "id": "eval",
      "description": "Map parsed Palo Alto fields to target OCSF HTTP Activity schema fields.",
      "filter": "pan != null",
      "conf": {
        "add": [
          {
            "name": "severity_id",
            "value": "pan.severity==='informational'?1:pan.severity==='low'?2:pan.severity==='medium'?3:pan.severity==='high'?4:pan.severity==='critical'?5:pan.severity ? 99 : 0"
          },
          {
            "name": "http_cookies",
            "value": "[]"
          },
          {
            "name": "type_uid",
            "value": "400200"
          },
          {
            "name": "src_endpoint",
            "value": "{}"
          },
          {
            "name": "src_endpoint.ip",
            "value": "pan.source_ip"
          },
          {
            "name": "src_endpoint.port",
            "value": "pan.source_port"
          },
          {
            "name": "src_endpoint.interface_name",
            "value": "pan.inbound_interface"
          },
          {
            "name": "src_endpoint.name",
            "value": "pan.source_zone"
          },
          {
            "name": "metadata",
            "value": "{}"
          },
          {
            "name": "metadata.log_name",
            "value": "pan.type + ':' + pan.threat_content_type"
          },
          {
            "name": "metadata.original_time",
            "value": "pan.generated_time || pan.receive_time || syslog_time"
          },
          {
            "name": "metadata.product",
            "value": "{}"
          },
          {
            "name": "metadata.product.name",
            "value": "'PAN-OS'"
          },
          {
            "name": "metadata.product.uid",
            "value": "pan.serial_number"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Palo Alto Networks'"
          },
          {
            "name": "metadata.product.version",
            "value": "pan.content_version"
          },
          {
            "name": "metadata.reporter",
            "value": "{}"
          },
          {
            "name": "metadata.reporter.name",
            "value": "reporter_name || pan.device_name"
          },
          {
            "name": "metadata.reporter.uid",
            "value": "pan.serial_number"
          },
          {
            "name": "metadata.tenant_uid",
            "value": "pan.virtual_system"
          },
          {
            "name": "metadata.version",
            "value": "'1.8.0'"
          },
          {
            "name": "connection_info",
            "value": "{}"
          },
          {
            "name": "connection_info.boundary_id",
            "value": "pan.source_location && pan.destination_location && pan.source_location.indexOf('192.168.')>=0 ? 3 : null"
          },
          {
            "name": "connection_info.direction_id",
            "value": "pan.direction==='client-to-server'?2:pan.direction==='server-to-client'?1:0"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "pan.protocol ? pan.protocol.toLowerCase() : null"
          },
          {
            "name": "connection_info.protocol_num",
            "value": "pan.protocol==='tcp'?6:pan.protocol==='udp'?17:pan.protocol==='icmp'?1:null"
          },
          {
            "name": "connection_info.protocol_ver_id",
            "value": "4"
          },
          {
            "name": "connection_info.uid",
            "value": "pan.session_id"
          }
        ],
        "keep": [
          "severity_id",
          "http_cookies",
          "type_uid",
          "src_endpoint.*",
          "metadata.*",
          "connection_info.*",
          "__*",
          "cribl_*"
        ]
      }
    }
  ],
  "recipe": null,
