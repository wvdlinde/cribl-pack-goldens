  "functions": [
    {
      "id": "regex_extract",
      "description": "Extract Palo Alto CSV payload from syslog-prefixed raw event.",
      "filter": "true",
      "conf": {
        "source": "_raw",
        "iterations": 100,
        "overwrite": true,
        "regex": "/^[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+(?<host>\\S+)\\s+(?<pan_csv>\\d,[\\s\\S]+)$/gm"
      }
    },
    {
      "id": "serde",
      "description": "Parse Palo Alto Threat CSV fields into parsedData.",
      "filter": "pan_csv != null",
      "conf": {
        "mode": "extract",
        "type": "csv",
        "srcField": "pan_csv",
        "dstField": "parsedData",
        "fields": [
          "future_use_0",
          "receive_time",
          "serial_number",
          "type",
