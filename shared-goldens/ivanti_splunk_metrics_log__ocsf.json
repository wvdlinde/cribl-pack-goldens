{
  "key": "ivanti_splunk_metrics_log::ocsf",
  "sourcetype": "ivanti_splunk_metrics_log",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:56:36.360Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\w{3}\\s+\\d{1,2}\\s\\d{2}:\\d{2}:\\d{2})\\s+(?<host>\\S+)\\s+(?<process>[\\w-]+)\\[(?<pid>\\d+)\\]:\\s+(?<__kvp_message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse syslog header (timestamp, host, process, pid) and isolate the KVP metrics payload"
    },
    {
      "id": "serde",
      "filter": "true",
      "disabled": false,
      "conf": {
        "mode": "extract",
        "type": "kvp",
        "srcField": "__kvp_message",
        "cleanFields": true
      },
      "description": "Extract KVP fields (id, severity, node, cpu, mem, swap, disk, concurrent_users, total_sessions, auth_failures, throughput_mbps, license_usage, temp, uptime, status) from the metrics payload"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "strptime(timestamp, '%b %d %H:%M:%S')"
          },
          {
            "name": "src_ip",
            "value": "node"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity.toLowerCase()"
          },
          {
            "name": "cpu_pct",
            "value": "parseFloat(cpu)"
          },
          {
            "name": "mem_pct",
            "value": "parseFloat(mem)"
          },
          {
            "name": "swap_pct",
            "value": "parseFloat(swap)"
          },
          {
            "name": "disk_pct",
            "value": "parseFloat(disk)"
          },
          {
            "name": "license_usage_pct",
            "value": "parseFloat(license_usage)"
          },
          {
            "name": "temp_c",
            "value": "parseFloat(temp)"
          },
          {
            "name": "uptime_seconds",
            "value": "parseFloat(uptime)"
          }
        ],
        "remove": [
          "__kvp_message"
        ]
      },
      "description": "Derive standardized _time, src_ip, normalized severity, and numeric metric fields (strip % / units)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "health_status",
            "value": "severity === 'critical' ? 'critical' : severity === 'error' ? 'error' : severity === 'warn' ? 'warning' : 'ok'"
          }
        ]
      },
      "description": "Classify overall health status based on severity for downstream alerting"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity: Traffic'"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "6"
          },
          {
            "name": "type_uid",
            "value": "400106"
          },
          {
            "name": "severity_id",
            "value": "(severity || '').toUpperCase() == 'CRITICAL' ? 5 : ((severity || '').toUpperCase() == 'ERROR' ? 4 : ((severity || '').toUpperCase() == 'WARN' ? 3 : 1))"
          },
          {
            "name": "time",
            "value": "Number(timestamp) ? Number(timestamp) : Math.round(new Date(timestamp).getTime()/1000)"
          },
          {
            "name": "src_endpoint.ip",
            "value": "node || src_ip || ''"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "device.hostname",
            "value": "host || ''"
          },
          {
            "name": "traffic.bytes_in",
            "value": "Math.round(Number(throughput_mbps || 0) * 125000)"
          },
          {
            "name": "traffic.bytes_out",
            "value": "Number(total_sessions || 0)"
          },
          {
            "name": "actor.user.name",
            "value": "process || ''"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "connection_info.protocol_name",
            "value": "'tcp'"
          },
          {
            "name": "metadata.version",
            "value": "'1.1.0'"
          },
          {
            "name": "metadata.product.name",
            "value": "'Ivanti Connect Secure'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "'Ivanti'"
          }
        ]
      },
      "description": "Map fields (continued 16-19)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'ivanti_splunk_metrics_log'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}