    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'CommonSecurityLog'"
          },
          {
            "name": "category_uid",
            "value": "'Authentication/SystemHealth'"
          },
          {
            "name": "event_type",
            "value": "'ivanti_mdstat'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : new Date((_time || Date.now()/1000) * 1000).toISOString()"
          },
          {
            "name": "DeviceVendor",
            "value": "'Ivanti'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Connect Secure'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "String(event_type || 'mdstat')"
          },
          {
            "name": "Activity",
            "value": "event_type == 'AUTH' ? (result == 'success' ? 'Login Succeeded' : 'Login Failed') : (event_type == 'STAT' ? 'System Health Report' : (event_type == 'WARN' ? 'Resource Threshold Exceeded' : (event_type == 'ERROR' ? 'Component Error' : 'Appliance Status')))"
          },
          {
            "name": "DeviceName",
            "value": "host || ''"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || ''"
          },
          {
            "name": "SourceUserName",
            "value": "user || ''"
          },
          {
            "name": "DeviceAction",
            "value": "result ? (result == 'success' ? 'allowed' : 'blocked') : (action || (status == 'ok' ? 'allowed' : ''))"
          },
          {
            "name": "LogSeverity",
            "value": "String(event_type == 'ERROR' ? 8 : (event_type == 'WARN' ? 6 : (result == 'failure' ? 5 : (severity ? Number(severity) : (level ? Number(level) : 3)))))"
          },
          {
            "name": "ApplicationProtocol",
            "value": "event_type == 'AUTH' ? 'HTTPS' : ''"
          },
          {
            "name": "DestinationUserName",
            "value": "event_type == 'AUTH' && realm ? user || '' : ''"
          }
        ]
      }
    },
