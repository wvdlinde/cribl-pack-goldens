{
  "key": "vmware_esxlog_snmpd::__extraction__",
  "sourcetype": "vmware_esxlog_snmpd",
  "dest_format": "__extraction__",
  "score": 95,
  "part": "extraction",
  "author": "push",
  "build": 0,
  "updated_at": "2026-09-01T07:37:04.225Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse base syslog-style structure: timestamp, host, pid, severity, message",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<host>\\S+)\\s+snmpd\\[(?<pid>\\d+)\\]:\\s+\\[(?<severity>\\w+)\\]\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/from\\s+/)",
      "disabled": false,
      "description": "Extract source IP (IPv4 or IPv6) when message references a 'from' clause",
      "conf": {
        "source": "message",
        "regex": "/from\\s+(?<src_ip>[0-9a-fA-F:.]+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/sent to/)",
      "disabled": false,
      "description": "Extract destination host/port from trap 'sent to' messages, supporting bracketed IPv6",
      "conf": {
        "source": "message",
        "regex": "/sent to \\[?(?<dst_host>[0-9a-fA-F:.]+)\\]?:(?<dst_port>\\d+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.match(/user\\s+'/)",
      "disabled": false,
      "description": "Extract user field when message references a quoted username",
      "conf": {
        "source": "message",
        "regex": "/user\\s+'(?<user>[^']+)'/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize protocol/transport, derive action outcome and standardize severity",
      "conf": {
        "add": [
          {
            "name": "protocol",
            "value": "'SNMP'"
          },
          {
            "name": "transport",
            "value": "'UDP'"
          },
          {
            "name": "action",
            "value": "message.match(/denied|failed|unauthorized|Malformed|Failed|mismatch|invalid/i) ? 'failure' : message.match(/succeeded|completed|reloaded|sent|served|started|served/i) ? 'success' : 'info'"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : severity"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "unstructured",
      "keys": []
    }
  },
  "report": null
}