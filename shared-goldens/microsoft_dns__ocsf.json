{
  "key": "microsoft_dns::ocsf",
  "sourcetype": "microsoft_dns",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wvdlinde",
  "build": 273,
  "updated_at": "2026-07-16T18:18:12.842Z",
  "functions": [
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "microsoft_dns to OCSF pipeline.\nParses events, drops noise, maps to OCSF schema, and outputs compact JSON."
      }
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 1: Parse raw events ---"
      }
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<timestamp>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<thread_id>\\w+)\\s+(?<log_type>\\w+)\\s+(?<context_id>\\w+)\\s+(?<protocol>UDP|TCP)\\s+(?<direction>Rcv|Snd)\\s+(?<src_ip>[\\d\\.a-fA-F:]+)\\s+(?<xid>[0-9A-Fa-f]+)\\s+(?<qr>[QR])\\s+\\[(?<flags>[^\\]]+)\\]\\s+(?<record_type>\\S+)\\s*(?<remainder>.*)$/"
      },
      "description": "Extract base Microsoft DNS debug log fields"
    },
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "flags",
        "iterations": 1,
        "overwrite": false,
        "regex": "/(?<rcode>NOERROR|NXDOMAIN|SERVFAIL|REFUSED|FORMERR|NOTIMP)/"
      },
      "description": "Extract rcode from flags field"
    },
    {
      "id": "regex_extract",
      "filter": "qr == 'Q'",
      "disabled": false,
      "conf": {
        "source": "remainder",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<__raw_query>\\([^)]+\\)(?:\\([^)]+\\))*(?:\\(\\d+\\))?)/"
      },
      "description": "Extract DNS query name from label-encoded remainder (query packets)"
    },
    {
      "id": "regex_extract",
      "filter": "qr == 'R'",
      "disabled": false,
      "conf": {
        "source": "remainder",
        "iterations": 1,
        "overwrite": false,
        "regex": "/^(?<answer>[\\d\\.a-fA-F:]+)/"
      },
      "description": "Extract answer (IP or IPv6) from response packets"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "query_name",
            "value": "__raw_query ? __raw_query.replace(/\\(\\d+\\)/g, '.').replace(/^\\.|\\.$|\\.(\\.)|\\.$/g, '').replace(/^\\./, '') : ''"
          },
          {
            "name": "direction_label",
            "value": "direction == 'Rcv' ? 'inbound' : 'outbound'"
          },
          {
            "name": "action",
            "value": "rcode == 'NXDOMAIN' ? 'blocked' : rcode == 'SERVFAIL' ? 'error' : 'allowed'"
          },
          {
            "name": "severity",
            "value": "rcode == 'NXDOMAIN' ? 'medium' : rcode == 'SERVFAIL' ? 'high' : 'informational'"
          },
          {
            "name": "vendor_product",
            "value": "'Microsoft DNS'"
          },
          {
            "name": "sourcetype",
            "value": "'microsoft_dns'"
          },
          {
            "name": "_time",
            "value": "new Date(timestamp).getTime() / 1000"
          },
          {
            "name": "dns_client_port",
            "value": "xid ? Number('0x' + xid) % 65535 : 0"
          },
          {
            "name": "dns_server_port",
            "value": "53"
          },
          {
            "name": "dns_server_ip",
            "value": "direction == 'Snd' ? src_ip : ''"
          },
          {
            "name": "dns_client_ip",
            "value": "direction == 'Rcv' ? src_ip : ''"
          },
          {
            "name": "parsed_hostname",
            "value": "_raw ? _raw.split(' ')[0] : ''"
          }
        ],
        "remove": [
          "__raw_query",
          "remainder",
          "flags"
        ]
      },
      "description": "Decode label-encoded query name, normalize fields, derive action and severity"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "log_time",
            "value": "timestamp || _time || undefined"
          }
        ]
      },
      "description": "Alias captured timestamp field(s) to log_time"
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 2: Reduction — drop noise events (disabled by default) ---"
      }
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise)",
      "final": true
    },
    {
      "id": "comment",
      "filter": "true",
      "disabled": false,
      "conf": {
        "comment": "--- STEP 3: Map fields to OCSF schema ---"
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "vendor",
            "value": "'microsoft dns'"
          },
          {
            "name": "product",
            "value": "'Security'"
          },
          {
            "name": "version",
            "value": "'1.0'"
          }
        ]
      },
      "description": "Set device vendor/product/version"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_endpoint",
            "value": "{}"
          },
          {
            "name": "dst_endpoint",
            "value": "{}"
          },
          {
            "name": "connection_info",
            "value": "{}"
          },
          {
            "name": "traffic",
            "value": "{}"
          },
          {
            "name": "actor",
            "value": "{}"
          },
          {
            "name": "actor.user",
            "value": "{}"
          },
          {
            "name": "device",
            "value": "{}"
          },
          {
            "name": "metadata",
            "value": "{}"
          },
          {
            "name": "metadata.product",
            "value": "{}"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "1"
          },
          {
            "name": "type_uid",
            "value": "400101"
          },
          {
            "name": "severity_id",
            "value": "null"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "dns_client_port ? Number(dns_client_port) : 0"
          },
          {
            "name": "dst_endpoint.ip",
            "value": "direction == 'Snd' ? src_ip : '127.0.0.1'"
          },
          {
            "name": "dst_endpoint.port",
            "value": "Number(dns_server_port)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || ''"
          },
          {
            "name": "traffic.bytes_in",
            "value": "_raw ? _raw.length : 0"
          },
          {
            "name": "traffic.bytes_out",
            "value": "answer ? answer.length : 0"
          },
          {
            "name": "actor.user.name",
            "value": "src_ip || ''"
          },
          {
            "name": "device.hostname",
            "value": "host || 'dns-server'"
          }
        ]
      },
      "description": "Map canonical fields to OCSF 1.4"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.version",
            "value": "'1.4.0'"
          },
          {
            "name": "metadata.product.name",
            "value": "product || 'Security'"
          },
          {
            "name": "metadata.product.vendor_name",
            "value": "vendor || 'microsoft dns'"
          },
          {
            "name": "time",
            "value": "log_time ? (String(log_time).length == 10 ? Number(log_time) * 1000 : Number(log_time)) : _time * 1000"
          },
          {
            "name": "sourcetype",
            "value": "'microsoft_dns:ocsf'"
          },
          {
            "name": "_time",
            "value": "log_time ? (String(log_time).length == 10 ? Number(log_time) : Number(log_time) / 1000) : _time"
          }
        ]
      },
      "description": "Map metadata and time fields"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "remove": [
          "*"
        ],
        "keep": [
          "_time",
          "index",
          "source",
          "sourcetype",
          "host",
          "cribl_breaker",
          "cribl_pipe",
          "class_uid",
          "class_uid.*",
          "category_uid",
          "category_uid.*",
          "activity_id",
          "activity_id.*",
          "type_uid",
          "type_uid.*",
          "severity_id",
          "severity_id.*",
          "src_endpoint",
          "src_endpoint.*",
          "dst_endpoint",
          "dst_endpoint.*",
          "connection_info",
          "connection_info.*",
          "traffic",
          "traffic.*",
          "actor",
          "actor.*",
          "device",
          "device.*",
          "metadata",
          "metadata.*",
          "time",
          "time.*"
        ]
      },
      "description": "Keep only OCSF 1.4 fields + routing"
    }
  ],
