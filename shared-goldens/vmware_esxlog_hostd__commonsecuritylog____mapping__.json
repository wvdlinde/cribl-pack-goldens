{
  "key": "vmware_esxlog_hostd::commonsecuritylog::__mapping__",
  "sourcetype": "vmware_esxlog_hostd",
  "dest_format": "commonsecuritylog::__mapping__",
  "score": 100,
  "part": "mapping",
  "author": "unknown",
  "build": 691,
  "updated_at": "2026-09-15T12:35:46.049Z",
  "functions": [
    {
      "id": "eval",
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names",
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'CommonSecurityLog'"
          },
          {
            "name": "category_uid",
            "value": "'Application/Virtualization'"
          },
          {
            "name": "event_type",
            "value": "'vmware_esxlog_hostd'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : (_time ? new Date(_time * 1000).toISOString() : new Date().toISOString())"
          },
          {
            "name": "DeviceVendor",
            "value": "'VMware'"
          },
          {
            "name": "DeviceProduct",
            "value": "'ESXi Hostd'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "String(sub || 'hostd') + (task ? ':' + String(task) : '')"
          },
          {
            "name": "Activity",
            "value": "task ? String(task) : (sub == 'Vimsvc.ha-eventmgr' ? 'Session Activity' : (sub == 'Vmsvc.vm' ? 'VM Operation' : (sub == 'Hostsvc.storage' ? 'Storage Operation' : 'Hostd Event')))"
          },
          {
            "name": "DeviceName",
            "value": "esx_host || ''"
          },
          {
            "name": "LogSeverity",
            "value": "String((severity || '').toLowerCase() == 'error' ? 7 : ((severity || '').toLowerCase() == 'warning' ? 5 : ((severity || '').toLowerCase() == 'info' ? 3 : ((severity || '').toLowerCase() == 'verbose' ? 1 : 3))))"
          },
          {
            "name": "SourceIP",
            "value": "(/^(\\d{1,3}(\\.\\d{1,3}){3}|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]+)$/.test(String((src_ip || ''))) ? (src_ip || '') : undefined)"
          },
          {
            "name": "SourceUserName",
            "value": "src_user || user || ''"
          },
          {
            "name": "DestinationUserName",
            "value": "src_user && user && src_user != user ? user : ''"
          },
          {
            "name": "DeviceAction",
            "value": "action || ''"
          },
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "ApplicationProtocol",
            "value": "protocol ? String(protocol).toLowerCase() : ''"
          },
          {
            "name": "RequestURL",
            "value": "path || ''"
          },
          {
            "name": "DeviceVersion",
            "value": "'hostd'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set source-native sourcetype",
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware:esxlog:Hostd'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Force Sentinel TimeGenerated (required ingest-time column)",
      "conf": {
        "add": [
          {
            "name": "TimeGenerated",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}(\\.\\d+)?$/.test(String(log_time)) ? new Date(Number(log_time)).toISOString() : /^\\d{10}(\\.\\d+)?$/.test(String(log_time)) ? new Date(Number(log_time)*1000).toISOString() : new Date(log_time).toISOString()) : new Date(_time ? _time*1000 : Date.now()).toISOString()"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "kvp",
      "keys": [
        "duration",
        "opid",
        "path",
        "payload",
        "port",
        "sid",
        "sub",
        "task",
        "user",
        "vm"
      ]
    }
  },
  "report": null
}