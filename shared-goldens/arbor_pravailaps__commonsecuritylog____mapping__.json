          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Set _time from the parsed timestamp (log_time), if one was captured",
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields to destination schema",
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity: DDoS Attack Detection'"
          },
          {
            "name": "TimeGenerated",
            "value": "timestamp ? new Date(timestamp).toISOString() : new Date(Number(_time || 0) * 1000).toISOString()"
          },
          {
            "name": "DeviceVendor",
            "value": "'Arbor Networks'"
          },
          {
            "name": "DeviceProduct",
            "value": "'Pravail APS'"
          },
          {
            "name": "DeviceEventClassID",
            "value": "String(event_type || 'unknown')"
          },
          {
            "name": "Activity",
            "value": "event_type == 'AttackStarted' ? 'Attack Started' : (event_type == 'AttackEscalated' ? 'Attack Escalated' : (event_type == 'AttackStopped' ? 'Attack Stopped' : (event_type == 'ThresholdExceeded' ? 'Threshold Exceeded' : (event_type == 'CountermeasureActivated' ? 'Countermeasure Activated' : (event_type == 'SystemHealthCheck' ? 'System Health Check' : String(event_type || 'Event'))))))"
          },
          {
            "name": "SourceIP",
            "value": "src_ip || ''"
          },
          {
            "name": "DestinationIP",
            "value": "dst_ip || ''"
          },
          {
            "name": "DestinationPort",
            "value": "Number(dst_port || 0)"
          },
          {
            "name": "Protocol",
            "value": "(protocol || '').toUpperCase()"
          },
          {
            "name": "ApplicationProtocol",
            "value": "String(dst_port || '') == '443' ? 'HTTPS' : (String(dst_port || '') == '80' ? 'HTTP' : (String(dst_port || '') == '53' ? 'DNS' : ''))"
          },
          {
            "name": "DeviceAction",
            "value": "(action || result || '').toLowerCase()"
          },
          {
            "name": "LogSeverity",
            "value": "String((severity || '').toUpperCase() == 'CRITICAL' ? 10 : ((severity || '').toUpperCase() == 'HIGH' ? 8 : ((severity || '').toUpperCase() == 'WARNING' ? 6 : ((severity || '').toUpperCase() == 'INFO' ? 3 : (Number(vendor_severity) || 3)))))"
          }
        ]
      }
    },
    {
      "id": "eval",
      "description": "Map fields (continued 16-18)",
      "conf": {
        "add": [
          {
            "name": "DeviceName",
