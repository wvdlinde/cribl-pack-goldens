{
  "key": "f5_bigip_ltm_ssl_error::__extraction__",
  "sourcetype": "f5_bigip_ltm_ssl_error",
  "dest_format": "__extraction__",
  "score": 95,
  "part": "extraction",
  "author": "push",
  "build": 0,
  "updated_at": "2026-09-16T16:00:06.198Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse syslog header (priority, timestamp, host, severity, process, event codes) and remaining message text",
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<pri>\\d+)>(?<timestamp>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<dst_host>\\S+)\\s+(?<severity>\\w+)\\s+(?<process>[^\\[]+)\\[(?<pid>\\d+)\\]:\\s+(?<event_id>\\d+):(?<event_subid>\\d+):\\s+(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('->') !== -1",
      "disabled": false,
      "description": "Extract source and destination IP:port pairs from messages containing an arrow (e.g. handshake failures, SSL alerts)",
      "conf": {
        "source": "message",
        "regex": "/(?<src_ip>[0-9a-fA-F:.]+):(?<src_port>\\d+)\\s*->\\s*(?<dst_ip>[0-9a-fA-F:.]+):(?<dst_port>\\d+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "regex_extract",
      "filter": "message && message.indexOf('->') === -1 && /\\d+(\\.\\d+){3}:\\d+|[0-9a-fA-F:]+:\\d+/.test(message)",
      "disabled": false,
      "description": "Extract single peer/source IP:port for messages without an arrow (renegotiation attacks, mutual TLS, SSL_write errors)",
      "conf": {
        "source": "message",
        "regex": "/(?:from|peer)\\s+(?<src_ip>[0-9a-fA-F:.]+):(?<src_port>\\d+)/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize protocol, severity, and classify action based on message content",
      "conf": {
        "add": [
          {
            "name": "protocol",
            "value": "'tcp'"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity == 'crit' ? 'critical' : severity == 'err' ? 'error' : severity == 'warning' ? 'warning' : severity == 'notice' ? 'notice' : 'info'"
          },
          {
            "name": "action",
            "value": "message.match(/succeeded/) ? 'success' : message.match(/attack detected/) ? 'blocked' : message.match(/not provided/) ? 'failure' : message.match(/failed/) ? 'failure' : message.match(/alert received/) ? 'alert' : message.match(/error/) ? 'error' : 'unknown'"
          }
        ],
        "remove": [
          "pri",
          "event_subid"
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "unstructured",
      "keys": []
    }
  },
  "report": null
}