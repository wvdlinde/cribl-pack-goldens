{
  "key": "vmware_esxlog_vsantraceurgent::ocsf",
  "sourcetype": "vmware_esxlog_vsantraceurgent",
  "dest_format": "ocsf",
  "score": 100,
  "part": null,
  "author": "wlinde@cribl.io",
  "build": 652,
  "updated_at": "2026-09-01T14:57:04.250Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "conf": {
        "source": "_raw",
        "regex": "/^<(?<syslog_pri>\\d+)>(?<syslog_ver>\\d)\\s+(?<timestamp>\\S+)\\s+(?<dst_host>\\S+)\\s+(?<app_name>\\S+)\\s+-\\s+-\\s+-\\s+vsantrace:\\s*(?<module>[^:]+):\\s*(?<message>.*)$/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Parse RFC5424 syslog header and vsantrace module/message from _raw"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "__sev_num",
            "value": "syslog_pri % 8"
          },
          {
            "name": "severity",
            "value": "__sev_num==0?'emergency':__sev_num==1?'alert':__sev_num==2?'critical':__sev_num==3?'error':__sev_num==4?'warning':__sev_num==5?'notice':__sev_num==6?'info':'debug'"
          }
        ],
        "remove": [
          "__sev_num"
        ]
      },
      "description": "Derive numeric and text severity from syslog PRI value (facility*8+severity)"
    },
    {
      "id": "regex_extract",
      "filter": "message && message.length > 0",
      "disabled": false,
      "conf": {
        "source": "message",
        "regex": "/(?<src_ip>(?:\\d{1,3}\\.){3}\\d{1,3}|[0-9a-fA-F]{1,4}(?::[0-9a-fA-F]{0,4}){2,7})(?::(?<src_port>\\d+))?/",
        "iterations": 1,
        "overwrite": false
      },
      "description": "Extract source IP (IPv4 or IPv6) and optional port referenced in the vsantrace message"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "message.match(/blocking traffic/) ? 'blocked' : message.match(/rejected/) ? 'rejected' : message.match(/removed from cluster/) ? 'removed' : message.match(/completed successfully/) ? 'completed' : message.match(/failure|inaccessible|lost quorum|data loss/) ? 'failed' : 'observed'"
          },
          {
            "name": "protocol",
            "value": "'vsan'"
          }
        ]
      },
      "description": "Classify vSAN trace event action based on message content keywords"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "src_ip",
            "value": "src_ip || source__ip || client__ip || srcaddr || srcip"
          },
          {
            "name": "dest_ip",
            "value": "dest_ip || dst_ip || destination__ip || server__ip || dstaddr || dstip"
          },
          {
            "name": "src_port",
            "value": "src_port || source__port || spt || srcport || sport"
          },
          {
            "name": "dest_port",
            "value": "dest_port || dst_port || destination__port || dpt || dstport || dport"
          },
          {
            "name": "protocol",
            "value": "protocol || transport || network__transport || proto"
          },
          {
            "name": "transport",
            "value": "transport || protocol || network__transport || proto"
          },
          {
            "name": "action",
            "value": "action || event__outcome || act"
          },
          {
            "name": "application",
            "value": "application || app || network__application || service"
          },
          {
            "name": "bytes_in",
            "value": "bytes_in || destination__bytes || rcvd_bytes || rcvdbyte"
          },
          {
            "name": "bytes_out",
            "value": "bytes_out || source__bytes || sent_bytes || sentbyte"
          },
          {
            "name": "duration",
            "value": "duration || event__duration"
          },
          {
            "name": "rule_name",
            "value": "rule_name || rule__name || policy_name || policyname"
          },
          {
            "name": "src_zone",
            "value": "src_zone || observer__ingress__zone"
          },
          {
            "name": "dest_zone",
            "value": "dest_zone || dst_zone || observer__egress__zone || observer__egress_zone"
          },
          {
            "name": "host",
            "value": "host || observer__hostname || hostname"
          },
          {
            "name": "log_time",
            "value": "log_time || generated_time || receive_time || start_time || event__created || timestamp || event__start"
          }
        ]
      },
      "description": "Alias Copilot/schematizer OCSF-style fields to canonical names"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "_time",
            "value": "(typeof log_time != 'undefined' && log_time) ? (/^\\d{13}$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}$/.test(String(log_time)) ? Number(log_time) * 1000 : /^\\d{13}\\.\\d+$/.test(String(log_time)) ? Number(log_time) : /^\\d{10}\\.\\d+$/.test(String(log_time)) ? Number(log_time) * 1000 : new Date(String(log_time)).getTime()) / 1000 : _time"
          }
        ]
      },
      "description": "Set _time from the parsed timestamp (log_time), if one was captured"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "class_uid",
            "value": "'4001'"
          },
          {
            "name": "category_uid",
            "value": "'4'"
          },
          {
            "name": "event_type",
            "value": "'Network Activity'"
          },
          {
            "name": "time",
            "value": "Number(new Date(timestamp || _time).getTime())"
          },
          {
            "name": "src_endpoint.ip",
            "value": "src_ip || ''"
          },
          {
            "name": "src_endpoint.port",
            "value": "Number(src_port || 0)"
          },
          {
            "name": "connection_info.protocol_name",
            "value": "protocol || ''"
          },
          {
            "name": "device.hostname",
            "value": "dst_host || ''"
          },
          {
            "name": "metadata.product.name",
            "value": "app_name || 'vSAN'"
          },
          {
            "name": "actor.user.name",
            "value": "module || ''"
          },
          {
            "name": "severity_id",
            "value": "Number(severity || 0)"
          },
          {
            "name": "class_uid",
            "value": "4001"
          },
          {
            "name": "category_uid",
            "value": "4"
          },
          {
            "name": "activity_id",
            "value": "0"
          },
          {
            "name": "type_uid",
            "value": "400100"
          }
        ]
      },
      "description": "Map fields to destination schema"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "metadata.product.vendor_name",
            "value": "'VMware'"
          }
        ]
      },
      "description": "Map fields (continued 16-16)"
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "conf": {
        "add": [
          {
            "name": "sourcetype",
            "value": "'vmware:esxlog:vsantraceUrgent'"
          }
        ]
      },
      "description": "Set source-native sourcetype"
    },
    {
      "id": "drop",
      "filter": "_raw && _raw.trim().length < 10",
      "disabled": true,
      "conf": {},
      "description": "Drop events shorter than 10 characters (empty/noise) (enable in Cribl UI to activate)",
      "final": true
    }
  ],
  "recipe": null,
  "report": {
    "band": "fail",
    "scoreSource": "value-coverage",
    "findings": [],
    "missingFields": [],
    "emptyFields": [],
    "summary": "Deterministic live preview completed."
  }
}