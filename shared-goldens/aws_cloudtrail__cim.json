          },
          {
            "name": "access_key",
            "value": "userIdentity.accessKeyId || ''"
          },
          {
            "name": "object",
            "value": "eventSource == 's3.amazonaws.com' ? (requestParameters.key || requestParameters.bucketName || '') : eventSource == 'iam.amazonaws.com' ? (requestParameters.userName || responseElements.user.userName || '') : eventSource == 'ec2.amazonaws.com' ? (responseElements.instancesSet.items[0].instanceId || requestParameters.imageId || '') : eventSource == 'cloudwatch.amazonaws.com' ? (requestParameters.logGroupName || '') : ''"
          },
          {
            "name": "object_id",
            "value": "eventSource == 's3.amazonaws.com' ? (requestParameters.key ? 'arn:aws:s3:::' + requestParameters.bucketName + '/' + requestParameters.key : requestParameters.bucketName ? 'arn:aws:s3:::' + requestParameters.bucketName : '') : eventSource == 'iam.amazonaws.com' ? (responseElements.user.arn || responseElements.user.userId || requestParameters.userName || '') : eventSource == 'ec2.amazonaws.com' ? (responseElements.instancesSet.items[0].instanceId || '') : ''"
          },
          {
            "name": "object_category",
            "value": "eventSource == 's3.amazonaws.com' ? (requestParameters.key ? 'file' : 'container') : eventSource == 'iam.amazonaws.com' ? 'user' : eventSource == 'ec2.amazonaws.com' ? 'compute' : eventSource == 'cloudwatch.amazonaws.com' ? 'log' : 'other'"
          },
          {
            "name": "action",
            "value": "eventName == 'ConsoleLogin' ? 'login' : /^(Create|Run|Put|Add|Attach|Associate|Enable)/.test(String(eventName)) ? 'created' : /^(Delete|Terminate|Remove|Detach|Disable|Revoke)/.test(String(eventName)) ? 'deleted' : /^(Update|Modify|Set)/.test(String(eventName)) ? 'modified' : /^(Describe|List|Get)/.test(String(eventName)) ? 'read' : 'modified'"
          },
          {
            "name": "change_type",
            "value": "readOnly === true ? 'read' : /^(Delete|Terminate|Remove|Detach|Disable|Revoke)/.test(String(eventName)) ? 'delete' : /^(Create|Run|Put|Add|Attach|Associate|Enable)/.test(String(eventName)) ? 'create' : /^(Update|Modify|Set)/.test(String(eventName)) ? 'modify' : 'write'"
          },
          {
            "name": "mfa",
            "value": "additionalEventData.MFAUsed || (userIdentity.sessionContext.attributes.mfaAuthenticated == 'true' ? 'Yes' : userIdentity.sessionContext.attributes.mfaAuthenticated == 'false' ? 'No' : '')"
          },
          {
            "name": "result",
            "value": "responseElements.ConsoleLogin || (errorCode ? 'failure' : 'success')"
          },
          {
            "name": "status",
            "value": "errorCode ? 'failure' : 'success'"
          },
          {
            "name": "error_code",
