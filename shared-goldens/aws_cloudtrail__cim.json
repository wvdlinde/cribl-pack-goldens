          },
          {
            "name": "bytes_out",
            "value": "additionalEventData.bytesTransferredOut ? Number(additionalEventData.bytesTransferredOut) : undefined"
          },
          {
            "name": "instance_id",
            "value": "eventSource == 'ec2.amazonaws.com' ? (responseElements.instancesSet.items[0].instanceId || '') : ''"
          }
        ]
